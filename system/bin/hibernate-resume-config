#!/bin/bash
# Point the kernel's hibernation resume at the swapfile: resume_offset first, then the device
# (writing /sys/power/resume makes the kernel look for an image at the offset; with the root
# device mounted it just logs "Image not found"). Belt-and-braces for resume= on the cmdline;
# systemd-sleep also writes both before every hibernate.
# Installed by scripts/setup-hibernate.sh; run at boot by hibernate-resume-config.service.
set -euo pipefail
SWAPFILE=${1:-/swap/swapfile}
DEV=${2:-/dev/mapper/root}
off=$(btrfs inspect-internal map-swapfile -r "$SWAPFILE")
majmin=$(lsblk -dno MAJ:MIN "$DEV" | tr -d ' ')
[[ $off =~ ^[0-9]+$ && $majmin =~ ^[0-9]+:[0-9]+$ ]] || { echo "bad offset '$off' or device '$majmin'" >&2; exit 1; }
echo "$off" > /sys/power/resume_offset
echo "$majmin" > /sys/power/resume
echo "hibernate resume: $DEV ($majmin) offset $off"
