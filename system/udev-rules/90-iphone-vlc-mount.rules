# iPhone plugged in over USB -> systemd device alias + start the user mount service
# that shows VLC's Documents folder at ~/iPhone-VLC (scripts/setup-iphone-vlc-mount.sh).
ACTION!="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ENV{ID_MODEL}=="iPhone", TAG+="systemd", ENV{SYSTEMD_ALIAS}+="/sys/subsystem/usb/iphone", ENV{SYSTEMD_USER_WANTS}+="iphone-vlc-mount.service"
