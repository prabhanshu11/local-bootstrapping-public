#!/usr/bin/env bash
# screen-flip — Robust screen rotation orchestrator for ThinkPad T14 Gen 1
#
# Single script that handles display transform, touchscreen transform,
# and signals the touch-scroll-daemon to adjust scroll direction.
#
# State is persisted in ~/.local/state/screen-transform so it survives
# hyprctl reload (via exec = hook in autostart.conf) and reboots.
#
# Usage:
#   screen-flip flip      # Toggle between normal (0) and flipped (2)
#   screen-flip normal    # Force normal orientation
#   screen-flip flipped   # Force 180° flip
#   screen-flip apply     # Re-apply current state (for reload hook)
#   screen-flip status    # Print current transform value

set -euo pipefail

STATE_FILE="$HOME/.local/state/screen-transform"
TOUCH_DEVICE="elan-touchscreen"
MONITOR="eDP-1"

read_state() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "0"
    fi
}

write_state() {
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "$1" > "$STATE_FILE"
}

get_monitor_position() {
    # Query current eDP-1 position from Hyprland (don't hardcode)
    local pos
    pos=$(hyprctl monitors -j 2>/dev/null | \
        python3 -c "
import sys, json
monitors = json.load(sys.stdin)
for m in monitors:
    if m['name'] == '$MONITOR':
        print(f\"{m['x']}x{m['y']}\")
        break
" 2>/dev/null) || true
    echo "${pos:-0x0}"
}

apply_transform() {
    local transform="$1"
    local position
    position=$(get_monitor_position)

    # Apply display transform
    hyprctl keyword monitor "$MONITOR,1920x1080@60,${position},1,transform,${transform}" > /dev/null 2>&1

    # Apply touchscreen transform to match
    hyprctl keyword "device[$TOUCH_DEVICE]:transform" "$transform" > /dev/null 2>&1

    # Signal touch-scroll-daemon to re-read state
    systemctl --user kill --signal=SIGUSR1 touch-scroll-daemon.service 2>/dev/null || true
}

cmd="${1:-status}"

case "$cmd" in
    flip)
        current=$(read_state)
        if [[ "$current" == "2" ]]; then
            write_state "0"
            apply_transform 0
        else
            write_state "2"
            apply_transform 2
        fi
        ;;
    normal)
        write_state "0"
        apply_transform 0
        ;;
    flipped)
        write_state "2"
        apply_transform 2
        ;;
    apply)
        # Re-apply from state file (used by exec = hook on reload)
        transform=$(read_state)
        if [[ "$transform" != "0" ]]; then
            # Small delay to let Hyprland finish processing config
            sleep 0.3
            apply_transform "$transform"
        fi
        ;;
    status)
        echo "$(read_state)"
        ;;
    *)
        echo "Usage: screen-flip {flip|normal|flipped|apply|status}" >&2
        exit 1
        ;;
esac
