def cut_words(ln, n):
    """At most n words; prefer to end at a clause boundary (, ; : .) within the
    last third of the budget, else a clean word cut with an ellipsis."""
    words = ln.split()
    if len(words) <= n:
        return ln
    keep = " ".join(words[:n])
    k = max(keep.rfind(", "), keep.rfind("; "), keep.rfind(": "), keep.rfind(". "))
    if k >= len(keep) * 2 // 3:
        return keep[:k].rstrip(",;:.") + "…"
    return keep + "…"


def clean_label(text, max_lines=BULLETS + 1):
    """Multiline label: headline + one bullet per window. Markdown, bullets and
    'Label:' prefixes removed; the budget (his 2026-11-09: 'consistently the
    text is too long') is enforced here when the model overshoots it."""
    out = []
    for ln in (text or "").splitlines():
        ln = ln.replace("**", "")
        ln = re.sub(r"^\s*([-*•·]|\d+[.)])\s+", "", ln)
        ln = re.sub(r"^(label|workspace label|headline)\s*:\s*", "", ln.strip(), flags=re.I)
        ln = ln.strip().strip("`\"' ")
        if ln:
            ln = cut_words(ln, HEAD_WORDS + 4 if not out else BULLET_WORDS + 8)
            out.append(ln)
    return "\n".join(out[:max_lines])


# Failures must be cheap and short (round 4: two calls right after a resume from
# sleep, with Wi-Fi still reconnecting, each hung 124 s until the 120 s kill).
FIRST_EVENT_S = float(os.environ.get("WSL_FIRST_EVENT_S", 30))   # no assistant output by then -> kill
HARD_S = 75                       # whole call (slowest real label so far 44 s)
BACKOFF_S = 300                   # after a failed or offline call: no calls for 5 min
_net = {"t": 0, "ok": True, "backoff_until": 0}


def api_reachable():
    """TCP connect to the API host in <= 3 s, cached 20 s. Offline -> no call."""
    if os.environ.get("WSL_CLAUDE"):
        return True
    if time.time() - _net["t"] < 20:
        return _net["ok"]
    try:
        socket.create_connection(("api.anthropic.com", 443), timeout=3).close()
        ok = True
    except OSError:
        ok = False
    _net.update(t=time.time(), ok=ok)
    return ok


def run_labeller(ws, emit, reason="new", rep=None, prev_hash=None):
    """Capture ws (hidden or not) unless `rep` already holds its capture, build the
    prompt, stream Sonnet. emit(event) gets SPEC §4 events. Returns the label dict,
    or {"skipped": True, ...} when the input equals prev_hash (nothing to call)."""
    if rep is None:
        rep = capture_desks([ws]).get(ws, {})
    clients = hypr_json("clients") or []
    fs = facts(desk_clients(clients).get(ws, []), clients)
    ihash = list(input_hash(fs, rep.get("png") or ""))
    if prev_hash and same_input(ihash, prev_hash):
        return {"skipped": True, "hash": ihash, "sig": signature(fs)}
    sig = signature(fs)
    fallback = fallback_label(fs)
    if awaiting(fs):
        # his 2026-11-09 ask 1: nothing to label yet; the daemon relabels the
        # moment work starts in it (FAST_POLL / a title change), not on the 10 s
        # tick + 20 s settle. Decided BEFORE the ledger check (an ssh of up to 25 s).
        log(f"ws {ws}: awaiting ({'; '.join(window_topic(f) for f in fs)}); no call until work starts in it")
        return {"label": fallback, "sig": sig, "fallback": True, "awaiting": True, "hash": ihash}
    ok_spend, why = may_spend()
    failed = [short_class(w["class"]) for w in rep.get("windows", [])
              if not w.get("ok") and "private" not in str(w.get("why"))]
    prompt = english_prompt(ws, fs, failed)
    no_call = None
    if not ok_spend:
        no_call = f"spend {why}"
    elif time.time() < _net["backoff_until"]:
        no_call = f"backing off after a failed call until {datetime.fromtimestamp(_net['backoff_until']).strftime('%H:%M:%S')}"
    elif not api_reachable():
        _net["backoff_until"] = time.time() + 60
        no_call = "offline: api.anthropic.com:443 unreachable in 3 s"
    if no_call:
        # no card for this: the card is only for a model call that really runs
        log(f"ws {ws}: no call ({no_call}); title fallback")
        return {"label": fallback, "sig": sig, "fallback": True, "hash": ihash}
    emit({"type": "_calling"})          # daemon: from now on the live card may show
    emit({"type": "start", "task": f"Labelling workspace {ws}", "prompt": prompt, "kind": "workspace-label"})
    png = rep.get("png")
    full = prompt
    if png:
        halves = rep.get("halves") or [ws]
        what = (f"desktop {ws} (workspace {halves[0]} on top, its second half workspace {halves[1]} below)"
                if len(halves) > 1 else f"workspace {halves[0]}")
        mos = " Fullscreen workspaces are shown as a mosaic of every window, including those behind." \
            if any(f.get("fullscreen") for f in fs) else ""
        full = (f"The screenshot of {what} is {png}. Read it first.{mos}\n\n" + prompt)
    cmd = [CLAUDE, "-p", full, "--model", "sonnet", "--effort", EFFORT,
           "--output-format", "stream-json", "--verbose", "--include-partial-messages",
           "--tools", "Read", "--allowedTools", "Read", "--strict-mcp-config",
           "--no-session-persistence", "--disable-slash-commands", "--max-turns", "4",
           "--add-dir", CAPS,
           "--system-prompt", "You label desktop workspaces. Look at the screenshot, then answer in plain "
                              f"text: line 1 a headline of at most {HEAD_WORDS} words naming the main activity (no bullet), "
                              f"then one bullet line starting with '- ' per window or Claude session, at most {BULLETS} "
                              f"bullets, each at most {BULLET_WORDS} words. One line per window, never one per topic: a busy "
                              "session is one specific phrase (project, topic, state), not a list of its sub-topics. "
                              "No filler: do not name window positions, or app names like 'Claude Code session' "
                              "or 'terminal' unless they are the point. No other markdown, no quotes."]
    log(f"ws {ws}: labelling ({reason}; {why})")
    text, usd, ok, outtok = "", 0.0, False, 0
    t0 = time.monotonic()
    try:
        errf = tempfile.TemporaryFile(mode="w+")
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=errf, text=True, cwd=STATE)
        seen = {"out": False, "killed": ""}

        def watchdog():
            while p.poll() is None:
                el = time.monotonic() - t0
                if not seen["out"] and el > FIRST_EVENT_S:
                    seen["killed"] = f"no model output in {FIRST_EVENT_S:.0f} s"
                elif el > HARD_S:
                    seen["killed"] = f"over {HARD_S} s"
                if seen["killed"]:
                    p.kill()
                    return
                time.sleep(0.5)
        threading.Thread(target=watchdog, daemon=True).start()
        partial = False
        for line in p.stdout:
            try:
                m = json.loads(line)
            except ValueError:
                continue
            t = m.get("type")
            if t in ("assistant", "stream_event", "result"):
                seen["out"] = True
            if t == "stream_event":
                ev = m.get("event", {})
                if ev.get("type") == "content_block_delta" and ev.get("delta", {}).get("type") == "text_delta":
                    partial = True
                    chunk = ev["delta"]["text"]
                    shown = re.sub(r"\n[-*] ?", "\n• ", chunk)
                    if (not text or text.endswith("\n")) and shown[:1] in "-*" and shown:
                        shown = "•" + shown[1:]
                    emit({"type": "text_delta", "text": shown})
                    text += chunk
                u = (ev.get("usage") or {}).get("output_tokens")
                if u:
                    emit({"type": "usage", "output_tokens": outtok + u})
            elif t == "assistant":
                msg = m.get("message", {})
                for b in msg.get("content", []):
                    if b.get("type") == "thinking":
                        emit({"type": "thinking", "text": first_line(re.split(r"(?<=[.!?])\s", b.get("thinking", ""))[0], 110)})
                    elif b.get("type") == "tool_use":
                        emit({"type": "tool_use", "id": b.get("id"), "name": b.get("name"),
                              "input": tool_input_short(b.get("name"), b.get("input"))})
                    elif b.get("type") == "text" and not partial:
                        emit({"type": "text_delta", "text": b.get("text", "")}); text += b.get("text", "")
                outtok += (msg.get("usage") or {}).get("output_tokens", 0)
                emit({"type": "usage", "output_tokens": outtok})
            elif t == "user":
                for b in m.get("message", {}).get("content", []) if isinstance(m.get("message", {}).get("content"), list) else []:
                    if b.get("type") == "tool_result":
                        c = b.get("content")
                        s = c if isinstance(c, str) else " ".join(x.get("text", "[image]") if x.get("type") == "text" else "Read image" for x in (c or []))
                        emit({"type": "tool_result", "id": b.get("tool_use_id"), "summary": first_line(s, 80),
                              "is_error": bool(b.get("is_error"))})
                partial = False
            elif t == "result":
                usd = m.get("total_cost_usd") or 0.0
                ok = not m.get("is_error") and m.get("subtype") == "success"
                if not text and m.get("result"):
                    text = m["result"]
        p.wait()
        if not ok:
            errf.seek(0)
            err = " ".join(errf.read().split())[-200:]
            log(f"ws {ws}: claude call failed: {seen['killed'] or f'exit {p.returncode}'}"
                + (f"; stderr: {scrub(err)}" if err else ""))
            _net["backoff_until"] = time.time() + BACKOFF_S
            _net["t"] = 0                    # re-probe the network next time
        errf.close()
    except Exception as e:  # noqa: BLE001
        log(f"ws {ws}: claude failed: {e}")
        _net["backoff_until"] = time.time() + BACKOFF_S
    if not os.environ.get("WSL_CLAUDE"):
        ledger_add(usd, ok, f"ws {ws} {reason}")
    label = clean_label(text) if ok else ""
    log(f"ws {ws}: {'label' if label else 'FAILED'} {label!r} usd={usd:.4f} {time.monotonic() - t0:.1f}s")
    if not label:
        emit({"type": "text_delta", "text": fallback})
        label = fallback
    emit({"type": "done"})
    return {"label": label, "sig": sig, "fallback": not ok, "hash": ihash}


