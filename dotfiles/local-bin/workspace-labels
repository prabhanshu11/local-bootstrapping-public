SPINNER = "✳✻✶✽✢·◐◑◒◓⠂⠐⠈⠁⠄⠠⠀"
SHORT = {"com.mitchellh.ghostty": "terminal", "google-chrome": "Chrome", "firefox": "Firefox",
         "firefox-developer-edition": "Firefox Developer Edition", "mpv": "mpv", "kitty": "terminal",
