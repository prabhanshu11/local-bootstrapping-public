# ── theme: the accent as the card's 7 gradient stops (SPEC §3) ─────────────
def _srgb_to_oklch(hexs):
    r, g, b = (int(hexs[i:i + 2], 16) / 255 for i in (0, 2, 4))
    lin = [((c + .055) / 1.055) ** 2.4 if c > .04045 else c / 12.92 for c in (r, g, b)]
    l_ = .4122214708 * lin[0] + .5363325363 * lin[1] + .0514459929 * lin[2]
    m_ = .2119034982 * lin[0] + .6806995451 * lin[1] + .1073969566 * lin[2]
    s_ = .0883024619 * lin[0] + .2817188376 * lin[1] + .6299787005 * lin[2]
    l_, m_, s_ = (x ** (1 / 3) for x in (l_, m_, s_))
    L = .2104542553 * l_ + .7936177850 * m_ - .0040720468 * s_
    a = 1.9779984951 * l_ - 2.4285922050 * m_ + .4505937099 * s_
    bb = .0259040371 * l_ + .7827717662 * m_ - .8086757660 * s_
    import math
    return L, math.hypot(a, bb), math.degrees(math.atan2(bb, a)) % 360


def _oklch_to_hex(L, C, H):
    import math
    a, b = C * math.cos(math.radians(H)), C * math.sin(math.radians(H))
    l_ = (L + .3963377774 * a + .2158037573 * b) ** 3
    m_ = (L - .1055613458 * a - .0638541728 * b) ** 3
    s_ = (L - .0894841775 * a - 1.2914855480 * b) ** 3
    rgb = (4.0767416621 * l_ - 3.3077115913 * m_ + .2309699292 * s_,
           -1.2684380046 * l_ + 2.6097574011 * m_ - .3413193965 * s_,
           -.0041960863 * l_ - .7034186147 * m_ + 1.7076147010 * s_)
    out = ""
    for c in rgb:
        c = min(1, max(0, c))
        c = 1.055 * c ** (1 / 2.4) - .055 if c > .0031308 else 12.92 * c
        out += f"{round(c * 255):02x}"
    return "#" + out


THEME_DIR = os.path.expanduser("~/.config/omarchy/current/theme")


def theme_id():
    """Changes when he switches Omarchy theme (the `current/theme` symlink)."""
    try:
        return os.path.realpath(THEME_DIR) + str(os.path.getmtime(os.path.join(THEME_DIR, "ghostty.conf")))
    except OSError:
        return ""


def _read(name):
    try:
        with open(os.path.join(THEME_DIR, name)) as f:
            return f.read()
    except OSError:
        return ""


def theme_palette():
    """The current Omarchy theme's colours (hex without #): background,
    foreground, accent (hyprland active border), border, text, and ghostty's
    16-colour palette."""
    g = _read("ghostty.conf")
    k = _read("kitty.conf")            # every Omarchy theme has full kitty colours; ghostty may only say `theme = X`
    pal = {int(n): v for n, v in re.findall(r"palette\s*=\s*(\d+)\s*=\s*#?([0-9a-fA-F]{6})", g)}
    pal.update({int(n): v for n, v in re.findall(r"(?m)^color(\d+)\s+#([0-9a-fA-F]{6})", k)})
    get = lambda pat, txt: (re.search(pat, txt) or [None, None])[1]
    g = k + "\n" + g.replace(" = ", " ").replace("=", " ")
    out = {
        "background": get(r"(?m)^background\s+#?([0-9a-fA-F]{6})", g) or "111c18",
        "foreground": get(r"(?m)^foreground\s+#?([0-9a-fA-F]{6})", g) or "c1c497",
        "accent": get(r"activeBorderColor\s*=\s*rgba?\(([0-9a-fA-F]{6})", _read("hyprland.conf")) or pal.get(6) or "5b8def",
        "border": get(r"@define-color\s+border\s+#([0-9a-fA-F]{6})", _read("walker.css")) or pal.get(0) or "333333",
        "text": get(r"@define-color\s+text\s+#([0-9a-fA-F]{6})", _read("walker.css")) or pal.get(15) or "ffffff",
        "palette": pal,
    }
    return out


def theme_accent():
    return theme_palette()["accent"]


def _clampL(hexs, lo=0.0, hi=1.0, cmin=None):
    L, C, H = _srgb_to_oklch(hexs)
    if cmin is not None and C < cmin:
        C = cmin
    return _oklch_to_hex(min(hi, max(lo, L)), C, H)


def theme_vars(pal=None):
    """Card gradient from the theme's own colours, light top to dark bottom
    (2026-11-02 his ask: the card looks like the theme). Lightness is clamped
    only where SPEC §3 needs it for legibility: the top three stops carry dark
    ink, the bottom four carry near-white text."""
    pal = pal or theme_palette()
    p = pal["palette"]
    src = [pal["text"], p.get(14) or p.get(12) or pal["accent"], pal["accent"],
           p.get(4) or p.get(6) or pal["accent"], pal["border"], p.get(0) or pal["border"], pal["background"]]
    limits = [(.94, 1), (.86, 1), (.72, 1), (0, .50), (0, .32), (0, .22), (0, .14)]
    out = {f"--g{i}": _clampL(c, lo, hi) for i, (c, (lo, hi)) in enumerate(zip(src, limits))}
    out["--ink"] = _clampL(pal["background"], 0, .22)
    return out


# ── STAGE 2b: activity signal (evdev: only THAT input happened, never which) ─
# The popup's own keys (his 2026-11-09 lock): a key code is compared against
# these three constants and nothing else; no code is ever stored or logged.
KEY_ESC, KEY_LEFTMETA, KEY_RIGHTMETA = 1, 125, 126
WATCHED_KEYS = {KEY_ESC: "esc", KEY_LEFTMETA: "super", KEY_RIGHTMETA: "super"}


class Activity(threading.Thread):
    """Reads every /dev/input/event* (he is in the `input` group; nothing is
    grabbed) and keeps only a timestamp. Key codes are never looked at, except
    for an equality test against WATCHED_KEYS (Super, Esc), which are reported
    as press/release of "super"/"esc" and do not count as input. Autorepeat
    events (a held key) are ignored: holding Super is not activity. on_input
    also gets one boolean: a keyboard key (code < 0x100, still never which)
    went down, as opposed to a mouse / touch / button event."""
    EV_SIZE = struct.calcsize("llHHi")

    def __init__(self, on_input, on_key=None):
        super().__init__(daemon=True, name="activity")
        self.on_input = on_input
        self.on_key = on_key or (lambda name, pressed, t: None)
        self.last = 0.0
        self.fds = {}

    def rescan(self):
        import glob
        for p in glob.glob("/dev/input/event*"):
            if p in self.fds:
                continue
            try:
                self.fds[p] = os.open(p, os.O_RDONLY | os.O_NONBLOCK)
            except OSError:
                pass

    def run(self):
        import select
        next_scan = 0
        while True:
            if time.monotonic() > next_scan:
                self.rescan(); next_scan = time.monotonic() + 5
            r, _, _ = select.select(list(self.fds.values()), [], [], 2)
            hit, keyhit, keys = False, False, []
            for fd in r:
                try:
                    data = os.read(fd, self.EV_SIZE * 64)
                except OSError:
                    for p, f in list(self.fds.items()):
                        if f == fd:
                            os.close(fd); del self.fds[p]
                    continue
                # type 1 = EV_KEY (keys, buttons, touch), 2 = EV_REL (mouse), 3 = EV_ABS (touch/pad)
                for off in range(0, len(data) - self.EV_SIZE + 1, self.EV_SIZE):
                    _, _, etype, code, value = struct.unpack_from("llHHi", data, off)
                    if etype == 1:
                        if value == 2:                 # autorepeat of a held key: nothing new
                            continue
                        if code in WATCHED_KEYS:       # Super / Esc: the popup's own keys
                            keys.append((WATCHED_KEYS[code], value == 1))
                            continue
                        hit = True
                        if code < 0x100 and value == 1:   # a keyboard key went down (not a button / touch)
                            keyhit = True
                    elif etype in (2, 3):
                        hit = True
            now = time.time()
            if hit:
                self.last = now
                self.on_input(now, keyhit)
            for name, pressed in keys:
                self.on_key(name, pressed, now)


