def week_start(now=None):
    """Last Friday 10:35 IST as epoch (the cap's reset, his words 2026-11-01)."""
    from datetime import timedelta
    ist = timezone(timedelta(hours=5, minutes=30))
    d = datetime.fromtimestamp(now or time.time(), ist)
    back = (d.weekday() - 4) % 7
    s = (d - timedelta(days=back)).replace(hour=10, minute=35, second=0, microsecond=0)
    if s > d:
        s -= timedelta(days=7)
    return s.timestamp()


_last_host = {"h": None}


def _ssh(cmd, stdin=None):
    """Run cmd on the desktop; the host that answered last is tried first."""
    hosts = sorted(DESKTOP_HOSTS, key=lambda h: h != _last_host["h"])
    for h in hosts:
        try:
            r = subprocess.run(["ssh", "-o", "ConnectTimeout=5", "-o", "BatchMode=yes", h, cmd],
                               input=stdin, capture_output=True, text=True, timeout=25)
            if r.returncode == 0:
                _last_host["h"] = h
                return r.stdout
        except subprocess.TimeoutExpired:
            continue
    return None


# Summed ON the desktop: the ledger is ~0.5 MB and `cat` over a phone hotspot
# overran the old 15 s timeout, which made a reachable desktop look offline.
_REMOTE_SUM = ("python3 -c 'import json,sys\nt=0.0\nm=0.0\nfor l in open(sys.argv[1]):\n"
               " try:\n  r=json.loads(l)\n  u=float(r.get(\"usd\",0)) if float(r.get(\"ts\",0))>=float(sys.argv[2]) else 0\n"
               "  t+=u\n  m+=u if r.get(\"loop\")==sys.argv[3] else 0\n"
               " except Exception: pass\nprint(t, m)' " + LEDGER + " {ws0} " + APP + " 2>/dev/null || echo 0 0")


LEDGER_LOCK = threading.RLock()     # parallel labellers must not send a line twice


def _unsynced_lines():
    if os.path.exists(_OLD_PENDING):
        with open(_OLD_PENDING) as f, open(LEDGER_PENDING, "a") as g:
            g.write(f.read())
        os.remove(_OLD_PENDING)
    try:
        with open(LEDGER_PENDING) as f:
            return [ln for ln in f.read().splitlines() if ln.strip()]
    except OSError:
        return []


def _week_usd(lines, ws0):
    tot = 0.0
    for ln in lines:
        try:
            r = json.loads(ln)
            if float(r.get("ts", 0)) >= ws0:
                tot += float(r.get("usd", 0))
        except (ValueError, TypeError):
            pass
    return tot


def flush_pending():
    """Append local unsynced lines to the desktop ledger; on success clear them
    and add them to the cached week total (the cache stays the desktop's sum)."""
    with LEDGER_LOCK:
        lines = _unsynced_lines()
        if not lines:
            return True
        if _ssh(f"mkdir -p ~/.local/share/agent-loops && cat >> {LEDGER}", stdin="\n".join(lines) + "\n") is None:
            return False
        ws0 = week_start()
        cache = load_json(LEDGER_CACHE, {})
        if cache.get("week") == ws0:
            cache["usd"] = float(cache.get("usd", 0)) + _week_usd(lines, ws0)
            cache["loop_usd"] = float(cache.get("loop_usd", 0)) + _week_usd(lines, ws0)
            save_json(LEDGER_CACHE, cache)
        os.remove(LEDGER_PENDING)
        log(f"ledger: appended {len(lines)} unsynced line(s) to the desktop ledger")
        return True


def ledger_week():
    """(desktop week total, local unsynced week total, reachable, cache age s).
    Unreachable: the desktop total is the cached one of THIS week (0 after the
    Friday 10:35 IST reset)."""
    ws0 = week_start()
    with LEDGER_LOCK:
        unsynced = _week_usd(_unsynced_lines(), ws0)
    out = _ssh(_REMOTE_SUM.format(ws0=ws0))
    try:
        total, mine = (float(x) for x in out.strip().splitlines()[-1].split()[:2]) if out is not None else (None, None)
    except (ValueError, IndexError, AttributeError):
        total, mine = None, None
    ledger_week.mine = None
    if total is not None:
        save_json(LEDGER_CACHE, {"week": ws0, "usd": total, "loop_usd": mine, "t": time.time()})
        ledger_week.mine = mine + unsynced
        return total, unsynced, True, 0
    cache = load_json(LEDGER_CACHE, {})
    if cache.get("week") == ws0:
        ledger_week.mine = float(cache.get("loop_usd", 0)) + unsynced
        return float(cache.get("usd", 0)), unsynced, False, time.time() - float(cache.get("t", 0))
    return 0.0, unsynced, False, None


_gate = {"t": 0, "val": None, "told": 0}
