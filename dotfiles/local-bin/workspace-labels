def short_class(cls):
    cls = cls or "?"
    if cls in SHORT:
        return SHORT[cls]
    m = re.match(r"chrome-([^_]+)__", cls)
    if m:
        return f"{m.group(1)} web app"
    return cls.split(".")[-1]


def scrub(text):
    """Privacy filter for text that leaves the laptop (SPEC §5)."""
    t = text or ""
    t = re.sub(r"(https?://[^\s?#]+)[?#]\S*", r"\1", t)                       # URL query strings
    t = re.sub(r"\b(?:sk|ghp|gho|xox[abp]|AKIA|AIza)[-_A-Za-z0-9]{10,}", "[secret]", t)
    t = re.sub(r"\b(?=[A-Za-z0-9+_-]*\d)(?=[A-Za-z0-9+_-]*[A-Za-z])[A-Za-z0-9+_-]{32,}={0,2}", "[secret]", t)  # token-like runs (paths kept)
    t = re.sub(r"(?i)(password|passwd|token|secret|api[-_ ]?key)\s*[:=]\s*\S+", r"\1 [redacted]", t)
    return t.strip()


def proc_children(pid):
    out = []
    try:
        for tid in os.listdir(f"/proc/{pid}/task"):
            with open(f"/proc/{pid}/task/{tid}/children") as f:
                out += [int(x) for x in f.read().split()]
    except OSError:
        pass
    return out


def terminal_fg(pid):
    """(program, cwd) running in the foreground of a terminal whose process owns
    exactly one window. None when unknown."""
    for child in proc_children(pid):
        try:
            with open(f"/proc/{child}/stat") as f:
                st = f.read()
            tpgid = int(st[st.rindex(")") + 2:].split()[5])
            fg = tpgid if tpgid > 0 else child
            # a program started inside the shell's own process group (no job
            # control, e.g. `claude` from a wrapper) leaves tpgid = the shell:
            # walk down to the newest descendant
            for _ in range(4):
                kids = proc_children(fg)
                if not kids:
                    break
                fg = kids[-1]
            with open(f"/proc/{fg}/comm") as f:
                comm = f.read().strip()
            try:
                cwd = os.readlink(f"/proc/{fg}/cwd")
            except OSError:
                cwd = ""
            return comm, cwd.replace(os.path.expanduser("~"), "~")
        except (OSError, ValueError, IndexError):
            continue
    return None


CLAUDE_PROJECTS = os.path.expanduser("~/.claude/projects")
_tail_cache = {}


def _descendants(pid, depth=5):
    out, frontier = [], [pid]
    for _ in range(depth):
        nxt = []
        for p in frontier:
            kids = proc_children(p)
            out += kids; nxt += kids
        frontier = nxt
    return out


def find_session_file(title, pid=None):
    """The Claude Code transcript behind a terminal: by the session's ai-title
    (the terminal title Claude sets), else by the `claude` process under a
    single-window terminal (--resume id, then newest file in its cwd's folder)."""
    import glob
    cutoff = time.time() - 3 * 86400
    files = [f for f in glob.glob(os.path.join(CLAUDE_PROJECTS, "*", "*.jsonl")) if os.path.getmtime(f) > cutoff]
    if title:
        needle = '"aiTitle":' + json.dumps(title, ensure_ascii=False)
        try:
            r = subprocess.run(["grep", "-l", "-F", needle, *files], capture_output=True, text=True, timeout=5)
            hits = [h for h in r.stdout.splitlines() if h]
            if hits:
                return max(hits, key=os.path.getmtime)
        except (OSError, subprocess.TimeoutExpired):
            pass
    if pid:
        for d in _descendants(pid):
            try:
                with open(f"/proc/{d}/comm") as fh:
                    if fh.read().strip() != "claude":
                        continue
                argv = open(f"/proc/{d}/cmdline").read().split("\0")
                cwd = os.readlink(f"/proc/{d}/cwd")
            except OSError:
                continue
            folder = os.path.join(CLAUDE_PROJECTS, re.sub(r"[^A-Za-z0-9]", "-", cwd))
            if "--resume" in argv and argv.index("--resume") + 1 < len(argv):
                f = os.path.join(folder, argv[argv.index("--resume") + 1] + ".jsonl")
                if os.path.exists(f):
                    return f
            cands = [f for f in glob.glob(os.path.join(folder, "*.jsonl"))
                     if os.path.getmtime(f) >= os.stat(f"/proc/{d}").st_mtime - 60]
            if cands:
                return max(cands, key=os.path.getmtime)
    return None


def session_recent_text(path, n=200):
    """Last thing he wrote and the last thing Claude said in a transcript,
    privacy-scrubbed, each at most n characters. Cached per (path, mtime)."""
    try:
        key = (path, os.path.getmtime(path))
    except OSError:
        return ""
    if key in _tail_cache:
        return _tail_cache[key]
    with open(path, "rb") as fh:
        fh.seek(0, 2); size = fh.tell(); fh.seek(max(0, size - 400_000))
        lines = fh.read().decode(errors="replace").splitlines()
    said = wrote = ""
    for line in reversed(lines):
        if said and wrote:
            break
        try:
            m = json.loads(line)
        except ValueError:
            continue
        if m.get("isSidechain") or m.get("isMeta"):
            continue
        c = (m.get("message") or {}).get("content")
        texts = [c] if isinstance(c, str) else [b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text"]
        t = " ".join(x for x in texts if x and not x.lstrip().startswith("<")).strip()
        if not t:
            continue
        if m.get("type") == "assistant" and not said:
            said = t
        elif m.get("type") == "user" and not wrote:
            wrote = t
    # cc-stretch {{short|long}} markup -> the short form
    clip = lambda x: scrub(" ".join(re.sub(r"\{\{([^|{}]*)\|[^{}]*\}\}", r"\1", x).split()))[:n]
    out = ""
    if wrote:
        out += f"He last wrote: \"{clip(wrote)}\". "
    if said:
        out += f"Claude last said: \"{clip(said)}\"."
    _tail_cache[key] = out.strip()
    return _tail_cache[key]


def facts(ws_clients, all_clients, sessions=True):
    """One dict per window: what it is and what it is doing, privacy-filtered."""
    pid_count = {}
    for c in all_clients:
        pid_count[c.get("pid")] = pid_count.get(c.get("pid"), 0) + 1
    out = []
    for c in sorted(ws_clients, key=lambda c: c.get("focusHistoryID", 99)):
        f = {"class": c.get("class") or "?", "kind": short_class(c.get("class")), "address": c.get("address"),
             "focus": c.get("focusHistoryID", 99), "private": is_private(c),
             "ws": c.get("workspace", {}).get("id"), "fullscreen": bool(c.get("fullscreen")),
             "title": "" if is_private(c) else scrub(c.get("title")), "fg": None, "cwd": ""}
        if f["class"] in TERMINALS and pid_count.get(c.get("pid")) == 1:
            r = terminal_fg(c.get("pid"))
            if r:
                f["fg"], f["cwd"] = r
        f["claude"] = ""
        if f["class"] in TERMINALS and not f["private"]:
            topic = (c.get("title") or "").lstrip(SPINNER + " ").strip()
            is_claude = (c.get("title") or "")[:1] in SPINNER or f["fg"] == "claude"
            if is_claude and sessions:      # transcript lookup: labeller only, never on the GTK tick
                sf = find_session_file(topic if topic and topic != "Ghostty" else None,
                                       c.get("pid") if pid_count.get(c.get("pid")) == 1 else None)
                if sf:
                    f["claude"] = session_recent_text(sf)
                    if GENERIC_SESSION.match(topic or "") or not topic or topic == "Ghostty":
                        tp = session_topic(sf)
                        if tp:
                            _topic_cache[c.get("address")] = tp
        out.append(f)
    return out


def activity_phrase(f):
    p = _activity_phrase(f)
    if f.get("half2"):
        p += f" (second half, workspace {f['ws']})"
    if f.get("fullscreen"):
        p += " (fullscreen)"
    return p


def _activity_phrase(f):
    if f["private"]:
        return f"a private {f['kind']} window"
    title = f["title"].lstrip(SPINNER + " ").strip()
    if f["kind"] == "terminal":
        if f["title"][:1] in SPINNER and title:
            return f"a Claude Code session about \"{title}\" in a terminal"
        if f["fg"] and f["fg"] not in ("bash", "zsh", "fish", "sh"):
            where = f" in {f['cwd']}" if f["cwd"] else ""
            return f"{f['fg']} running in a terminal{where}" + (f" (\"{title}\")" if title else "")
        return f"a terminal at \"{title}\"" if title else "an idle terminal"
    if title:
        return f"{f['kind']} showing \"{title[:90]}\""
    return f"a {f['kind']} window"


# His 2026-11-06: "Lets make it comprehensive, so that word limit doesn't limit
# the relevant info being provided." -> no word cap, one line per activity.
# His 2026-11-09: "now consistently the text is too long. that should not
# happen." -> a BUDGET instead of a cap on words: one bullet per WINDOW (or
# Claude session), not per topic, so every window is still covered but a busy
# session is one line, not a table of its sub-topics. clean_label() enforces
# the budget (HEAD_WORDS / BULLETS / BULLET_WORDS) when the model overshoots.
HEAD_WORDS = 8        # headline
BULLETS = 5           # at most this many bullets (one per window / session)
BULLET_WORDS = 14     # asked of the model; clean_label cuts at BULLET_WORDS + 8
REPLY_INSTRUCTION = (f"Reply with a headline of at most {HEAD_WORDS} words naming the main activity, then one bullet ('- ') "
                     f"per window or Claude session (one line each, never one per topic), at most {BULLETS} bullets, "
                     f"each at most {BULLET_WORDS} words: the one most specific fact (project, topic, page, state). No filler.")


def english_prompt(ws, fs, failed=()):
    if len({f.get("ws") for f in fs}) > 1:          # both halves of the desktop have windows
        for f in fs:
            f["half2"] = f.get("ws") != ws
    return _english_prompt(ws, fs, failed)


def _english_prompt(ws, fs, failed=()):
    if not fs:
        return f"Workspace {ws} is empty.\n" + REPLY_INSTRUCTION
    first = activity_phrase(fs[0]).rstrip(".")
    line1 = first[0].upper() + first[1:]
    if len(fs) > 1:
        line1 += f", while {activity_phrase(fs[1])}"
    lines = [line1 + "."]
    rest = fs[2:5]
    for f in rest:
        p = activity_phrase(f)
        lines.append(p[0].upper() + p[1:] + ".")
    if len(fs) > 5:
        lines.append(f"{len(fs) - 5} more windows are open.")
    for f in [f for f in fs if f.get("claude")][:3]:
        topic = f["title"].lstrip(SPINNER + " ").strip() or "a Claude session"
        lines.append(f"Recent text in the Claude session \"{topic}\": {f['claude']}")
    if failed:
        lines.append("Not in the screenshot (named from their titles only): " + ", ".join(failed) + ".")
    lines.append(REPLY_INSTRUCTION)
    return "\n".join(lines)


# A fresh terminal's title is its cwd ("~/Programs", "~"), the shell's name
# ("bash": ghostty -e bash) or "Ghostty": all generic (2026-11-09 test: "bash"
# was labelled by Sonnet as 'Idle empty terminal', a call for nothing).
GENERIC_TITLE = re.compile(r"^(ghostty|mozilla firefox|firefox developer edition|google chrome|new tab|about:blank.*|"
                           r"[\w.-]+@[\w.-]+:.*|web\.whatsapp\.com.*|bash|zsh|fish|sh|~(/\S*)?|/home/\S*)$", re.I)


GENERIC_SESSION = re.compile(r"^(continue previous work|claude code|claude|new (session|conversation|chat)|untitled|"
                             r"general (chat|question)s?|resum(e|ing).*|help)$", re.I)
_topic_cache = {}                     # window address -> topic from its Claude transcript


def session_topic(path, n=70):
    """The session's own ask: its first real user message, scrubbed (free, no model)."""
    try:
        with open(path, "rb") as fh:
            head = fh.read(600_000).decode(errors="replace").splitlines()
    except OSError:
        return ""
    for line in head:
        try:
            m = json.loads(line)
        except ValueError:
            continue
        if m.get("type") == "ai-title" and m.get("aiTitle") and not GENERIC_SESSION.match(m["aiTitle"]):
            return scrub(m["aiTitle"])[:n]
        if m.get("type") != "user" or m.get("isMeta") or m.get("isSidechain"):
            continue
        c = (m.get("message") or {}).get("content")
        texts = [c] if isinstance(c, str) else [b.get("text", "") for b in c or [] if isinstance(b, dict) and b.get("type") == "text"]
        t = " ".join(x for x in texts if x and not x.lstrip().startswith("<")).strip()
        # skip 'lets continue the work' style openers: too short to say anything
        if t and len(t) >= 25 and not re.match(r"(?i)^(let'?s |please )?(continue|resume|go on|carry on)\b", t):
            t = scrub(" ".join(t.split()))
            return t if len(t) <= n else t[:n].rsplit(" ", 1)[0] + "…"
    # nothing usable at the start: what Claude last said about it
    last = session_recent_text(path, 70)
    mm = re.search(r'Claude last said: "(.*?)"', last)
    return mm.group(1) if mm else ""


def window_topic(f):
    """One line for one window, free: Claude session topic, page title, program."""
    if f["private"]:
        return "private window"
    t = f["title"]
    for _ in range(2):                # "… - YouTube - Google Chrome"
        t = re.sub(r"\s+[-—–|]\s+(Google Chrome|Mozilla Firefox|Firefox Developer Edition|YouTube|mpv|Thunar)$", "", t)
    t = t.lstrip(SPINNER + " ").strip()
    if GENERIC_SESSION.match(t) and _topic_cache.get(f.get("address")):
        return _topic_cache[f["address"]]
    if t and not GENERIC_TITLE.match(t):
        return t[:90]
    if f["fg"] and f["fg"] not in ("bash", "zsh", "fish", "sh"):
        return f"{f['fg']} in {f['cwd'] or '~'}"
    if f["kind"] == "terminal":
        return f"terminal in {f['cwd'] or '~'}" if f.get("cwd") else "idle terminal"
    return f["kind"]


def fallback_label(fs):
    """Label without a model (gate closed, offline, or Sonnet failed): one line
    per window, most recently focused first (his 2026-11-06: comprehensive,
    every window, not only the focused one). Line 1 is the headline."""
    lines = list(dict.fromkeys(window_topic(f) for f in fs))
    return "\n".join(lines[:BULLETS + 1]) or "empty"


# ── his 2026-11-09 ask 1: a fresh terminal / a browser with no tab is not a
# workspace to label yet; it "awaits" and relabels the moment work starts ──
IDLE_BROWSER = re.compile(r"^(new tab|about:blank.*|untitled|google chrome|chromium|mozilla firefox|firefox developer edition|brave)?$", re.I)
APP_SUFFIX = re.compile(r"\s+[-—–|]\s+(Google Chrome|Chromium|Mozilla Firefox|Firefox Developer Edition|Brave)$")


def idle_window(f):
    """True for a window with nothing to label yet: a terminal at its shell (or
    Claude started but no prompt given, title still generic), or a browser
    window showing no page. His words 2026-11-09: 'a new terminal gets opened
    and I take some time to start claude on it ... or I open a new browser
    window and don't open any tab'."""
    if f["private"]:
        return False
    title = f["title"].lstrip(SPINNER + " ").strip()
    if f["kind"] == "terminal":
        if f["fg"] == "claude":
            return not title or title == "Ghostty" or bool(GENERIC_SESSION.match(title))
        at_shell = not f["fg"] or f["fg"] in ("bash", "zsh", "fish", "sh")
        return at_shell and (not title or bool(GENERIC_TITLE.match(title)))
    if f["class"] in BROWSERS:
        return bool(IDLE_BROWSER.match(APP_SUFFIX.sub("", title).strip()))
    return False


def awaiting(fs):
    """Every window on the desk is idle: no model call, label = the free
    titles, and the daemon watches it closely (FAST_POLL + title events)."""
    return bool(fs) and all(idle_window(f) for f in fs)


def signature(fs, young=()):
    """What counts as a change (his words): windows opening/closing/moving and the
    terminal program changing; NOT the text on them, NOT their size. Windows in
    `young` (alive < YOUNG s) do not count yet."""
    return sorted(f["class"] + (":" + f["fg"] if f["fg"] else "") for f in fs if f.get("address") not in young)


def image_fingerprint(png):
    """Coarse picture of a workspace: 16x9 grey cells, 4 levels. Text scrolling
    in a terminal rarely changes it; a new page or app does."""
    try:
        import gi
        gi.require_version("GdkPixbuf", "2.0")
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file(png).scale_simple(16, 9, GdkPixbuf.InterpType.TILES)
        px, n, rs = pb.get_pixels(), pb.get_n_channels(), pb.get_rowstride()
        return "".join(str(sum(px[y * rs + x * n + k] for k in range(3)) // 3 // 64)
                       for y in range(9) for x in range(16))
    except Exception:  # noqa: BLE001
        return ""


FP_TOLERANCE = 8    # of 144 cells: video / a blinking cursor moved 3 cells in 10 s (measured)


def input_hash(fs, png):
    """What Sonnet would be shown: (facts hash, image fingerprint). Facts are
    order-free: window set, terminal programs, titles without Claude's spinner,
    Claude session last text."""
    import hashlib
    rows = sorted(f"{f['class']}|{f['fg']}|{f['title'].lstrip(SPINNER + ' ')}|{f.get('claude', '')}" for f in fs)
    return hashlib.sha1("\n".join(rows).encode()).hexdigest()[:16], image_fingerprint(png)


def same_input(a, b):
    """Round 3: skip the call when the facts are identical and at most
    FP_TOLERANCE coarse image cells differ."""
    if not a or not b or a[0] != b[0] or len(a[1]) != len(b[1]):
        return False
    return sum(x != y for x, y in zip(a[1], b[1])) <= FP_TOLERANCE


