def may_spend():
    """Gate before each call: desktop week total (live, or cached when the
    desktop is unreachable) + local unsynced spend must stay under CAP_USD, and
    unsynced spend under LOCAL_UNSYNCED_LIMIT. Result cached 60 s open / 10 min
    closed; ONE status line per week when it closes, never a question."""
    if os.environ.get("WSL_CLAUDE") and not os.environ.get("WSL_TEST_GATE"):
        return True, "test stub (WSL_CLAUDE set, no model call, nothing spent)"
    if _gate["val"] and time.time() - _gate["t"] < (60 if _gate["val"][0] else 600):
        return _gate["val"]
    flush_pending()
    desk, unsynced, reachable, age = ledger_week()
    total = desk + unsynced
    ov = _override()
    if ov:
        own = _own_spend_since(float(ov.get("since", 0)))
        safety = float(ov.get("safety_usd", 5))
        until = datetime.fromtimestamp(float(ov["until"])).strftime("%H:%M")
        ok = own < safety and (reachable or unsynced < LOCAL_UNSYNCED_LIMIT)
        val = (ok, f"gate {'open' if ok else 'closed'}: cap override until {until} ({ov.get('reason', '')}); "
                   f"this loop USD {own:.2f} / safety {safety:.0f} since the override; shared week total USD {total:.2f}"
                   + ("" if reachable else f"; desktop unreachable, unsynced USD {unsynced:.2f} / {LOCAL_UNSYNCED_LIMIT:.0f}"))
        if _gate.get("ov_logged") != ov.get("until"):
            _gate["ov_logged"] = ov.get("until")
            log(f"gate open: cap override until {until} ({ov.get('reason', '')})")
        _gate.update(t=time.time(), val=val)
        return val
    mine = ledger_week.mine if ledger_week.mine is not None else unsynced
    if mine >= LOOP_CAP_USD:
        val = (False, f"gate closed: this loop USD {mine:.2f} / {LOOP_CAP_USD:.0f} this week (overall USD {total:.2f} / {CAP_USD:.0f})")
    elif reachable:
        val = (total < CAP_USD, f"gate {'open' if total < CAP_USD else 'closed'}: week spend USD {total:.2f} / {CAP_USD:.0f}, "
                                f"this loop USD {mine:.2f} / {LOOP_CAP_USD:.0f}")
    else:
        # No desktop total known for this week (no read since the Friday reset):
        # closed until the desktop answers once. Never assume the week is empty.
        src = f"cached desktop total USD {desk:.2f} ({age / 60:.0f} min old)" if age is not None else "week total UNKNOWN (no desktop read since the reset)"
        ok = age is not None and total < CAP_USD and unsynced < LOCAL_UNSYNCED_LIMIT
        val = (ok, f"gate {'open' if ok else 'closed'}: desktop ledger unreachable; {src} + local unsynced USD "
                   f"{unsynced:.2f} (offline limit {LOCAL_UNSYNCED_LIMIT:.0f}) = {total:.2f} / {CAP_USD:.0f}")
    _gate.update(t=time.time(), val=val)
    if not val[0] and _gate["told"] < week_start():
        _gate["told"] = time.time()
        subprocess.run(["notify-send", "-a", APP, "Workspace labels paused",
                        f"Agent-loop cap reached ({val[1]}); window names until the Friday 10:35 reset."],
                       capture_output=True, timeout=5)
    return val


