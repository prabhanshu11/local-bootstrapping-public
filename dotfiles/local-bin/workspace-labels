HERE = os.path.dirname(os.path.realpath(__file__))
WEB = os.path.join(os.path.dirname(HERE), APP)          # dotfiles/workspace-labels
CAPTURE_TIMEOUT = 2.5
# Measured 2026-11-02 (REPORT.md): a hidden window hands grim the frame it drew
# LAST, and the capture request itself makes it draw a new one. A printing
# terminal on hidden ws 9 captured at 06:41:00 showed 06:40:58 (the previous
# capture); the first capture after mapping was blank. So every window is
# captured twice, PRIME_GAP apart, and the second frame is kept.
PRIME_GAP = 0.15
THUMB_W = 1280                                          # composite width sent to Sonnet
TERMINALS = {"com.mitchellh.ghostty", "kitty", "Alacritty", "alacritty", "foot", "org.wezfurlong.wezterm"}
BROWSERS = ("google-chrome", "chromium", "firefox", "firefox-developer-edition", "brave-browser")
# Privacy filter (SPEC §5): windows never captured and never named.
PRIVATE_CLASS = re.compile(r"(keepass|bitwarden|1password|pass-wizard|pass-copy|pinentry|gcr-prompter|polkit)", re.I)
# His 2026-11-06 answer on a terminal titled "... password recovery ...":
# "describe them. claude agent is anyways security-aware". So a title that
# merely MENTIONS passwords/2FA is described like any other (secret VALUES are
# still scrubbed by scrub()); only password managers, prompts and private /
# incognito browser windows stay private.
PRIVATE_TITLE = re.compile(r"(incognito|private browsing|pass[- ]wizard|pass[- ]copy|\bpass (show|insert)\b|pinentry)", re.I)
os.makedirs(CAPS, exist_ok=True)


def log(msg):
    line = f"{datetime.now().strftime('%Y-%m-%d %H:%M:%S')} {msg}"
    print(line, flush=True)
    try:
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def hypr_json(what):
    try:
        out = subprocess.run(["hyprctl", what, "-j"], capture_output=True, text=True, timeout=3).stdout
        return json.loads(out)
    except Exception as e:  # noqa: BLE001
        log(f"hyprctl {what} failed: {e}")
        return None


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, indent=1, ensure_ascii=False)
    os.replace(tmp, path)


def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def is_private(c):
    return bool(PRIVATE_CLASS.search(c.get("class") or "") or PRIVATE_TITLE.search(c.get("title") or ""))


# ── STAGE 1: capture every workspace, hidden ones included ─────────────────
# On-screen displays and short-lived pop-ups: never a workspace "change", never
# captured, never named to Sonnet (round 3: mic-osd alone caused 8 of 14 change
# triggers on ws 3 in 34 min). Matched against the window class.
TRANSIENT_CLASSES = re.compile(
    r"^(mic-osd|swayosd.*|.*-osd|osd-.*|hyprwhspr.*|walker|wofi|rofi|fuzzel|mako|dunst|"
    r"xdg-desktop-portal.*|org\.gnome\.polkit.*|polkit-.*|pinentry.*|gcr-prompter|"
    r"hyprpolkitagent|nm-applet|blueberry.*|bar-touch.*|workspace-labels)$", re.I)
YOUNG = 20          # s: a window must live this long before it counts as a change


def workspace_clients(clients=None):
    """{ws_id: [client, ...]} for normal workspaces (special ones and OSD /
    pop-up classes in TRANSIENT_CLASSES skipped)."""
    out = {}
    for c in clients if clients is not None else (hypr_json("clients") or []):
        ws = c.get("workspace", {}).get("id", -1)
        if ws is None or ws < 1 or not c.get("mapped"):
            continue
        if TRANSIENT_CLASSES.match(c.get("class") or c.get("initialClass") or ""):
            continue
        out.setdefault(ws, []).append(c)
    return out


def desk_of(ws):
    """His 2026-11-06: one label per DIGIT. Desktop N = workspace N + its
    workspace-pair half N+10 (Super+N twice). Other ids stand alone."""
    return ws - 10 if 11 <= ws <= 20 else ws


def desk_halves(d):
    return (d, d + 10) if 1 <= d <= 10 else (d,)


def desk_clients(clients=None):
    """{desk: [client, ...]} over both halves; each client keeps its real workspace."""
    out = {}
    for ws, cs in workspace_clients(clients).items():
        out.setdefault(desk_of(ws), []).extend(cs)
    return out


def monitor_for(ws_id, monitors, workspaces):
    mid = next((w.get("monitorID") for w in workspaces if w.get("id") == ws_id), None)
    mon = next((m for m in monitors if m.get("id") == mid), None) or (monitors[0] if monitors else None)
    return mon


def grim_window(stable_id, out_path):
    t0 = time.monotonic()
    try:
        r = subprocess.run(["grim", "-T", stable_id, out_path], capture_output=True, timeout=CAPTURE_TIMEOUT)
        ok = r.returncode == 0 and os.path.getsize(out_path) > 0
        err = "" if ok else (r.stderr.decode(errors="replace").strip()[:120] or f"rc={r.returncode}")
    except subprocess.TimeoutExpired:
        ok, err = False, f"timeout {CAPTURE_TIMEOUT}s (no frame: paused or not redrawing)"
    except OSError as e:
        ok, err = False, str(e)
    return ok, err, int((time.monotonic() - t0) * 1000)


def png_text_save(pixbuf, path, meta):
    keys = [f"tEXt::{k}" for k in meta]
    pixbuf.savev(path, "png", keys, [str(v) for v in meta.values()])


def capture_workspace(ws_id, clients, mon, tmpdir):
    """Composite one workspace. Returns (png_path, report dict)."""
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
    mw, mh = int(mon["width"] / mon.get("scale", 1)), int(mon["height"] / mon.get("scale", 1))
    if mon.get("transform", 0) in (1, 3, 5, 7):
        mw, mh = mh, mw
    mx, my = mon.get("x", 0), mon.get("y", 0)
    scale = THUMB_W / mw
    W, H = THUMB_W, int(mh * scale)
    canvas = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, W, H)
    canvas.fill(0x11221Cff)
    report = {"ws": ws_id, "created": now_iso(), "windows": []}
    # Draw the least recently focused first so the focused window ends on top;
    # tiled before floating.
    order = sorted(clients, key=lambda c: (c.get("floating", False), -c.get("focusHistoryID", 0)))
    # His 2026-11-06: on a fullscreen workspace "look at the windows in the
    # background" too. Every window is captured on its own anyway (grim -T), so
    # the composite becomes a mosaic: the fullscreen window first, then each
    # window behind it in its own cell, none hidden.
    mosaic = any(c.get("fullscreen") for c in clients) and len(clients) > 1
    if mosaic:
        import math
        order = sorted(clients, key=lambda c: (not c.get("fullscreen"), c.get("focusHistoryID", 99)))
        cols = math.ceil(math.sqrt(len(order)))
        rows = math.ceil(len(order) / cols)
        cell_w, cell_h = W // cols, H // rows
        report["mosaic"] = True
    # Prime pass (see PRIME_GAP): ask every capturable window for a fresh frame.
    primed = {}
    for c in order:
        if c.get("stableId") and not is_private(c):
            pp = os.path.join(tmpdir, f"prime-{c['stableId']}.png")
            primed[c["stableId"]] = grim_window(c["stableId"], pp)
    if any(r[0] for r in primed.values()):
        time.sleep(PRIME_GAP)
    for idx, c in enumerate(order):
        sid = c.get("stableId") or ""
        x, y = c["at"][0] - mx, c["at"][1] - my
        w, h = c["size"]
        item = {"stableId": sid, "class": c.get("class"), "x": x, "y": y, "w": w, "h": h}
        if is_private(c):
            item.update(ok=False, why="private (privacy filter, not captured)")
            report["windows"].append(item)
            continue
        onscreen = x < mw and y < mh and x + w > 0 and y + h > 0
        if not onscreen and not mosaic:
            item.update(ok=False, why="off-screen position")
            report["windows"].append(item)
            continue
        p = os.path.join(tmpdir, f"{sid}.png")
        if sid in primed and not primed[sid][0]:
            ok, err, ms = primed[sid]          # no frame on the prime: do not wait twice
        else:
            ok, err, ms = grim_window(sid, p)
        item.update(ok=ok, ms=ms)
        if not ok:
            item["why"] = err
            report["windows"].append(item)
            continue
        try:
            src = GdkPixbuf.Pixbuf.new_from_file(p)
            item["buffer"] = [src.get_width(), src.get_height()]
            dw, dh = max(1, int(w * scale)), max(1, int(h * scale))
            dx, dy = int(x * scale), int(y * scale)
            if mosaic:                        # fit the window into its grid cell
                cx, cy = (idx % cols) * cell_w, (idx // cols) * cell_h
                f = min((cell_w - 8) / max(1, w), (cell_h - 8) / max(1, h))
                dw, dh = max(1, int(w * f)), max(1, int(h * f))
                dx, dy = cx + (cell_w - dw) // 2, cy + (cell_h - dh) // 2
            # clip to canvas
            cx0, cy0 = max(dx, 0), max(dy, 0)
            cx1, cy1 = min(dx + dw, W), min(dy + dh, H)
            if cx1 > cx0 and cy1 > cy0:
                src.composite(canvas, cx0, cy0, cx1 - cx0, cy1 - cy0, dx, dy,
                              dw / src.get_width(), dh / src.get_height(),
                              GdkPixbuf.InterpType.BILINEAR, 255)
            item["crc"] = zlib.crc32(src.get_pixels()) & 0xFFFFFFFF
        except Exception as e:  # noqa: BLE001
            item.update(ok=False, why=f"decode: {e}")
        report["windows"].append(item)
    out = os.path.join(CAPS, f"ws-{ws_id}.png")
    meta = {
        "source": f"hyprland workspace {ws_id}; windows " + ",".join(
            f"{i['stableId']}={i['class']}" for i in report["windows"]),
        "pipeline": "local-bootstrapping/dotfiles/local-bin/workspace-labels capture",
        "created": report["created"],
        "workspace": str(ws_id),
    }
    png_text_save(canvas, out + ".tmp", meta)
    os.replace(out + ".tmp", out)
    report["png"] = out
    report["ok"] = sum(1 for i in report["windows"] if i.get("ok"))
    report["failed"] = [f"{i['class']}: {i.get('why')}" for i in report["windows"] if not i.get("ok")]
    return out, report


HEALTH_LOCK = threading.Lock()


def capture(ws_ids=None):
    clients = hypr_json("clients") or []
    monitors = hypr_json("monitors") or []
    workspaces = hypr_json("workspaces") or []
    by_ws = workspace_clients(clients)
    visible = {m.get("activeWorkspace", {}).get("id") for m in monitors}
    reports = {}
    # All workspaces at once: grim -T in parallel is safe (17 windows in 0.5 s,
    # all 17 frames OK, measured 2026-11-02).
    from concurrent.futures import ThreadPoolExecutor

    def one(ws):
        t0 = time.monotonic()
        _, r = capture_workspace(ws, by_ws[ws], monitor_for(ws, monitors, workspaces), tmp)
        r["visible"] = ws in visible
        r["ms"] = int((time.monotonic() - t0) * 1000)
        return ws, r
    with tempfile.TemporaryDirectory(prefix="wsl-") as tmp:
        todo = [ws for ws in sorted(ws_ids or by_ws) if ws in by_ws]
        with ThreadPoolExecutor(max_workers=max(1, min(8, len(todo)))) as pool:
            for ws, r in pool.map(one, todo):
                reports[ws] = r
    with HEALTH_LOCK:
        health = load_json(HEALTH, {})
        for ws, r in reports.items():
            health[str(ws)] = r
        save_json(HEALTH, health)
    return reports


def capture_desks(desks):
    """Capture each desktop: every half with windows (hidden halves too), the
    halves stacked into one image (top = N, bottom = N+10) with provenance."""
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
    by_ws = workspace_clients()
    halves = [h for d in desks for h in desk_halves(d) if by_ws.get(h)]
    reps = capture(halves) if halves else {}
    out = {}
    for d in desks:
        hs = [h for h in desk_halves(d) if h in reps]
        if not hs:
            continue
        r = {"ws": d, "halves": hs, "created": now_iso(), "windows": [], "ok": 0, "failed": [],
             "ms": max(reps[h]["ms"] for h in hs), "visible": any(reps[h]["visible"] for h in hs)}
        for h in hs:
            r["windows"] += reps[h]["windows"]; r["ok"] += reps[h]["ok"]; r["failed"] += reps[h]["failed"]
        if len(hs) == 1:
            r["png"] = reps[hs[0]]["png"]
        else:
            pbs = [GdkPixbuf.Pixbuf.new_from_file(reps[h]["png"]) for h in hs]
            W = max(pb.get_width() for pb in pbs); H = sum(pb.get_height() for pb in pbs) + 8 * (len(pbs) - 1)
            canvas = GdkPixbuf.Pixbuf.new(GdkPixbuf.Colorspace.RGB, False, 8, W, H)
            canvas.fill(0x000000ff)
            y = 0
            for pb in pbs:
                pb.copy_area(0, 0, pb.get_width(), pb.get_height(), canvas, 0, y)
                y += pb.get_height() + 8
            png = os.path.join(CAPS, f"desk-{d}.png")
            png_text_save(canvas, png + ".tmp", {
                "source": f"hyprland desktop {d} = workspaces {' + '.join(map(str, hs))} (stacked top to bottom); "
                          + "; ".join(f"ws {h}: windows " + ",".join(f"{w['stableId']}={w['class']}" for w in reps[h]["windows"]) for h in hs),
                "pipeline": "local-bootstrapping/dotfiles/local-bin/workspace-labels capture_desks",
                "created": r["created"], "workspace": ",".join(map(str, hs))})
            os.replace(png + ".tmp", png)
            r["png"] = png
        out[d] = r
    return out


