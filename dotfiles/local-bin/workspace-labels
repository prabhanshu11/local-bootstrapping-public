    def bar_height(self):
        if time.time() - getattr(self, "_bar_t", 0) < 30:
            return self._bar_h
        self._bar_h, self._bar_t = self._bar_height(), time.time()
        return self._bar_h

    def screen_height(self):
        mon = next((m for m in (hypr_json("monitors") or []) if m.get("focused")), None)
        return int(mon["height"] / mon.get("scale", 1)) if mon else 1080

    def _bar_height(self):
        for mon in (hypr_json("layers") or {}).values():
            for lvl in mon.get("levels", {}).values():
                for s in lvl:
                    if s.get("namespace", "").startswith("waybar") and s.get("y", 1) == 0:
                        return s.get("h", 30)
        return 30

    def show(self, ws, upgrade=False, clients_by_ws=None):
        """On a switch: plain label / live card / old label over the running agent.
        The card is shown ONLY while a real model call runs (round 5: with the
        spend gate closed the card played ~15 s and fell back to the title, and
        that card was the popup he kept seeing)."""
        ws = desk_of(ws)
        by_desk = clients_by_ws if clients_by_ws is not None else desk_clients()
        if not by_desk.get(ws):
            self.hide()                      # empty: no popup, no agent, no card
            log(f"popup ws {ws}: empty, nothing shown")
            return False
        if upgrade and self.shown_ws != ws:
            return False                     # he has moved on; no popup for an old switch
        lab = self.labels.get(str(ws))
        run = self.runs.get(ws)
        if not lab and not (run is not None and not run["done"]):
            self.enqueue(ws, "switched to an unlabelled workspace", front=True)
            run = self.runs.get(ws)
        card = run is not None and not run["done"] and run.get("calling", False)
        if not lab:                          # no stored label yet: the window-title label now
            clients = hypr_json("clients") or []
            lab = {"label": fallback_label(facts(desk_clients(clients).get(ws, []), clients, sessions=False))}
        # placement (his 2026-11-05 ask, eDP-1 ~62 px/cm): label 2 cm lower, card 5 cm lower
        bar = self.bar_height()
        self.LS.set_margin(self.win, self.LS.Edge.TOP, bar + 8 + LABEL_DROP)
        hs = sorted({c.get("workspace", {}).get("id") for c in by_desk.get(ws, [])})
        self.ws_lbl.set_text(f"workspace {' + '.join(map(str, hs))}" if len(hs) > 1 else f"workspace {hs[0] if hs else ws}")
        head, _, rest = lab["label"].partition("\n")
        self.lbl.set_text(head)
        # a long headline wraps (70 chars) instead of running off the screen
        self.lbl.set_line_wrap(len(head) > 70); self.lbl.set_max_width_chars(70)
        self.lbl.set_width_chars(min(70, len(head)))
        rest = "\n".join("• " + x for x in rest.splitlines() if x.strip())   # his 11-06: bullet points
        self.det.set_text(rest)
        # natural width for wrapping (GTK3 wraps to the minimum without it)
        self.det.set_width_chars(min(84, max((len(x) for x in rest.splitlines()), default=0)))
        self.det.set_visible(bool(rest.strip()))
        want = self.det_box if card else self.old_box
        if self.det_in is not want:               # move the bullet list above/below the card
            self.det_in.remove(self.det)
            want.pack_start(self.det, False, False, 0)
            self.det_in = want
        self.det_box.set_visible(card and bool(rest.strip()))
        # his 2026-11-06: the list under the card was cut off at the screen's
        # bottom. With the card up, the list gets the height that is left and
        # ends in '…' only if it is truly longer.
        # (Pango's line limit applies per paragraph, i.e. per bullet, so the
        # budget is applied here, bullet by bullet.)
        sc = self.det.get_style_context()
        if card:
            sc.add_class("wsl-det-under"); self.det_box.get_style_context().add_class("wsl-under")
            head_h = 68 + 34 * (-(-len(head) // 70))       # ws line + padding + headline lines
            room = self.screen_height() - (bar + 8 + LABEL_DROP) - head_h - 24 - (CARD_DROP - LABEL_DROP) - 440 - 20
            budget, kept = max(2, room // 17), []
            for b in rest.splitlines():
                need = -(-len(b) // DET_UNDER_CHARS)
                if need > budget:
                    if budget >= 1:
                        kept.append(b[:budget * DET_UNDER_CHARS - 1].rsplit(" ", 1)[0] + " …")
                    break
                kept.append(b); budget -= need
            hidden = len(rest.splitlines()) - len(kept)
            if hidden > 0:                     # say what does not fit; overview/switch-back shows all
                if budget < 1 and kept:
                    kept.pop(); hidden += 1
                kept.append(f"   … {hidden} more (shown when the agent is done)")
            self.det.set_text("\n".join(kept))
            self.det.set_max_width_chars(DET_UNDER_CHARS)
            self.det.set_width_chars(min(DET_UNDER_CHARS, max((len(x) for x in kept), default=0)))
        else:
            sc.remove_class("wsl-det-under"); self.det_box.get_style_context().remove_class("wsl-under")
            self.det.set_max_width_chars(84)
        self.old_box.set_visible(True)
        self.line.set_visible(card)
        self.gap.set_visible(card)
        self.web.set_visible(card)
        if card:
            self.card_ws = ws
            if not run["events"]:
                self.push_card({"type": "start", "task": f"Labelling workspace {ws}",
                                "prompt": "Capturing the workspace...", "kind": "workspace-label"})
            for ev in list(run["events"]):
                self.push_card(ev)
        else:
            self.card_ws = None
        self.win.resize(1, 1)
        self.shown_ws, self.shown_at = ws, time.monotonic()
        self.win.show()
        self.GLib.idle_add(self.set_input_region)
        log(f"popup ws {ws}: label {lab['label']!r}{' + live card (model call running)' if card else ''}")
        # The card does not lock (his 2026-11-10: the auto-lock ate his typing;
        # "the live agent should behave mostly like the label. Except it gets
        # shown forever until any key is pressed after a certain timeout"):
        # on_input ignores input for CARD_GRACE_S, then the first input hides it.
        return False

    def resolve_switch(self):
        """One Super+N fires two workspace events (workspace-pair: N and N+10).
        Treat the burst as one switch: show the label of the half he lands on,
        or its non-empty partner; an empty half never dismisses it (round 6:
        'ws 3 dismissed after 0.01s' then 'ws 13: empty', label back 2-3 s later)."""
        with self.sw_lock:
            evs, t0 = self.sw_events, self.sw_t0
            self.sw_events, self.sw_t0 = [], None
        if not evs:
            return False
        last = evs[-1]
        by_desk = desk_clients()
        d = desk_of(last)
        ws = d if by_desk.get(d) else None              # one label per digit, either half
        by_ws = by_desk
        if ws is None:
            self.hide()
            log(f"switch {evs}: desktop empty, nothing shown ({(time.monotonic() - t0) * 1000:.0f} ms)")
            return False
        if ws == self.shown_ws:
            log(f"switch {evs}: ws {ws} already shown, kept ({(time.monotonic() - t0) * 1000:.0f} ms)")
            return False
        self.show(ws, clients_by_ws=by_ws)
        log(f"switch {evs} -> ws {ws}: popup visible {(time.monotonic() - t0) * 1000:.0f} ms after the first event")
        return False

    def set_input_region(self):
        """Clicks pass through everywhere except on the popup's own boxes, where
        a tap locks / unlocks it (touch twin of Super-hold / Esc)."""
        import cairo
        gw = self.win.get_window()
        if not gw:
            return False
        reg = cairo.Region()
        for w in (self.old_box, self.web, self.det_box):
            if w.get_visible():
                a = w.get_allocation()
                reg.union(cairo.RectangleInt(a.x, a.y, a.width, a.height))
        gw.input_shape_combine_region(reg, 0, 0)
        return False

    # the lock (his 2026-11-09) --------------------------------------------------
    def set_locked(self, on, why):
        """Locked: the popup stays, and takes exclusive keyboard focus so that Esc
        (and anything else typed meanwhile) reaches the popup and never a work
        window ("otherwise my agents or browser apps may capture it"). Hyprland
        binds (Super+N) still work: the compositor handles them before focus."""
        if on == self.locked:
            return
        self.locked = on
        LS = self.LS
        LS.set_keyboard_mode(self.win, LS.KeyboardMode.EXCLUSIVE if on else LS.KeyboardMode.NONE)
        if on:
            self._swallowed = 0
            self.hint.set_text("🔒 locked · Esc or a tap closes it")
            self.hint.show()
            log(f"popup ws {self.shown_ws} locked ({why}); Esc / tap / `workspace-labels unlock` ends it")
        else:
            self.hint.hide()
            log(f"popup ws {self.shown_ws} unlocked ({why})")

    def on_key_press(self, win, ev):
        if ev.keyval in (self.Gdk.KEY_Escape,):
            if self.locked:
                self.set_locked(False, "Esc")
                self.hide()
        elif self.locked:
            self._swallowed += 1
            if self._swallowed == 1:
                log("a key reached the locked popup (swallowed, not a work window)")
        return True                        # nothing typed while locked leaves the popup

    def on_tap(self, win, ev):
        if self.shown_ws is None:
            return True
        if self.locked:
            self.set_locked(False, "tap"); self.hide()
        else:
            self.set_locked(True, "tap on the popup")
        return True

    def on_key_thread(self, name, pressed, t):
        """Super / Esc from evdev (Activity thread). Super held LOCK_HOLD_S with no
        other input locks the popup (shows the current desk's label first if none
        is up). Esc here is the fallback behind the GTK handler: if the GTK loop
        does not unlock within 2 s while locked, exit so systemd restarts the
        daemon and the keyboard is released (never a stuck keyboard)."""
        if name == "super":
            if pressed:
                self.super_down, self.super_quiet, self.super_combo = t, t, False
                if self.hold_src is None:
                    self.hold_src = self.GLib.timeout_add(250, self.hold_check)
            else:
                self.super_down = None
        elif name == "esc" and pressed and self.locked:
            self._esc_t = t
            self.GLib.idle_add(self.esc_fallback)

            def still_locked():
                if self.locked and self._esc_t == t:
                    log("GTK loop did not release the lock 2 s after Esc: exiting so systemd restarts the daemon")
                    os._exit(3)
            threading.Timer(2.0, still_locked).start()

    def cmd_lock(self, on):
        if on and self.shown_ws is None and self.active_ws is not None:
            self.show(desk_of(self.active_ws))
        if on and self.shown_ws is not None:
            self.set_locked(True, "asked")
        elif not on:
            self.set_locked(False, "asked")
            self.hide()
        return False

    def esc_fallback(self):
        if self.locked:
            self.set_locked(False, "Esc (evdev)")
            self.hide()
        return False

    def hold_check(self):
        if self.super_down is None:
            self.hold_src = None
            return False
        # his 2026-11-10: he keeps Super held while flipping desks (Super+N) and
        # reading labels; that locked the popup under him. A hold in which any
        # other key went down never locks: only Super pressed alone does.
        if not self.locked and not self.super_combo and time.time() - self.super_quiet >= LOCK_HOLD_S:
            if self.shown_ws is None and self.active_ws is not None:
                self.show(desk_of(self.active_ws))
            if self.shown_ws is not None:
                self.set_locked(True, f"Super held {LOCK_HOLD_S:.0f} s")
        return True

    def hide(self):
        if self.locked:
            self.set_locked(False, "hidden")
        if self.shown_ws is not None:
            self.win.hide()
            log(f"popup ws {self.shown_ws} dismissed after {time.monotonic() - self.shown_at:.2f}s")
            self.shown_ws = None
            self.card_ws = None

    def on_input_thread(self, t, key=False):
        if self.super_down is not None:
            self.super_quiet = t                        # mouse / touch: the hold clock restarts
            if key:
                self.super_combo = True                 # Super+key (a switch): this hold never locks
        aw = desk_of(self.active_ws) if self.active_ws is not None else None
        dismissing = self.shown_ws is not None and not self.locked   # this input closes the popup
        if aw is not None and not dismissing and t - self.switched_at >= SWITCH_GRACE:
            secs = self.activity.setdefault(aw, [])
            if not secs or secs[-1] != int(t):
                secs.append(int(t))
                if len(secs) > 2000:
                    del secs[:1000]
        self.GLib.idle_add(self.on_input)

    def worked_seconds(self, ws, since):
        return sum(1 for x in self.activity.get(ws, ()) if x >= since)

    def note(self, ws, reason):
        """Log a skipped trigger at most once per minute per (workspace, cause);
        repeats are counted and reported with the next line."""
        k = (ws, reason)
        last, n = self.noted.get(k, (0, 0))
        if time.time() - last >= 60:
            self.noted[k] = (time.time(), 0)
            log(f"skip ws {ws}: {reason}" + (f" (+{n} more in the last minute)" if n else ""))
        else:
            self.noted[k] = (last, n + 1)

    def screenshot_busy(self):
        """A screenshot is being taken (screenshot-save running: slurp/wayfreeze/
        satty) or ended < 1 s ago. His 2026-11-06: 'pressing that buttons make it
        go away' - the popup must survive so he can capture it."""
        run = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
        try:
            pid = int(open(os.path.join(run, "screenshot-busy")).read().strip())
            if os.path.exists(f"/proc/{pid}"):
                return True
        except (OSError, ValueError):
            pass
        try:
            return time.time() - os.path.getmtime(os.path.join(run, "screenshot-done")) < 1.0
        except OSError:
            return False

    def on_input(self):
        """Dismiss on the first input after 400 ms (the live card: after
        CARD_GRACE_S, counted from when the card appeared) - 300 ms later, so
        that a screenshot key (whose script raises the busy flag within ~50 ms)
        is never what closes the popup. Input during a screenshot is ignored."""
        grace = CARD_GRACE_S if self.card_ws is not None and self.card_ws == self.shown_ws else 0.4
        if self.shown_ws is None or self.locked or time.monotonic() - self.shown_at <= grace:
            return False
        if self.screenshot_busy() or getattr(self, "_hide_pending", False):
            return False
        self._hide_pending = True
        shown = self.shown_ws

        def later():
            self._hide_pending = False
            if self.shown_ws == shown and not self.locked and not self.screenshot_busy():
                self.hide()
            return False
        self.GLib.timeout_add(300, later)
        return False

    # hyprland events ------------------------------------------------------------
    def socket2(self):
        path = f"{os.environ['XDG_RUNTIME_DIR']}/hypr/{os.environ['HYPRLAND_INSTANCE_SIGNATURE']}/.socket2.sock"
        while True:
            try:
                s = socket.socket(socket.AF_UNIX); s.connect(path)
                buf = b""
                while True:
                    chunk = s.recv(4096)
                    if not chunk:
                        break
                    buf += chunk
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        ev, _, data = line.decode(errors="replace").partition(">>")
                        if ev == "workspacev2":
                            try:
                                ws = int(data.split(",")[0])
                            except ValueError:
                                continue
                            self.active_ws = ws
                            self.switched_at = time.time()
                            if ws > 0:
                                with self.sw_lock:
                                    self.sw_events.append(ws)
                                    if self.sw_t0 is None:
                                        self.sw_t0 = time.monotonic()
                                        self.GLib.timeout_add(COALESCE_MS, self.resolve_switch)
                        elif ev in ("openwindow", "closewindow", "movewindowv2"):
                            self.GLib.idle_add(self.tick)
                        elif ev in ("windowtitle", "windowtitlev2") and self.fast_src is not None:
                            self.GLib.idle_add(self.fast_check)      # an awaiting desk may have woken
            except OSError as e:
                log(f"socket2: {e}")
            time.sleep(1)

    def cmd_server(self):
        try:
            os.unlink(CMD_SOCK)
        except OSError:
            pass
        srv = socket.socket(socket.AF_UNIX); srv.bind(CMD_SOCK); srv.listen(4)
        while True:
            c, _ = srv.accept()
            try:
                msg = c.recv(256).decode().split()
                if msg and msg[0] == "show":
                    ws = desk_of(int(msg[1]) if len(msg) > 1 else self.active_ws)
                    self.GLib.idle_add(self.show, ws)
                    c.sendall(b"ok\n")
                elif msg and msg[0] == "simulate":      # test: a burst of workspace events, no real switch
                    with self.sw_lock:
                        self.sw_events += [int(x) for x in msg[1:]]
                        if self.sw_t0 is None:
                            self.sw_t0 = time.monotonic()
                            self.GLib.timeout_add(COALESCE_MS, self.resolve_switch)
                    c.sendall(b"ok\n")
                elif msg and msg[0] == "relabel":
                    self.GLib.idle_add(self.enqueue, desk_of(int(msg[1])), "asked", True)
                    c.sendall(b"ok\n")
                elif msg and msg[0] in ("lock", "unlock"):
                    self.GLib.idle_add(self.cmd_lock, msg[0] == "lock")
                    c.sendall(b"ok\n")
            except Exception as e:  # noqa: BLE001
                log(f"cmd: {e}")
            finally:
                c.close()

    # scheduler --------------------------------------------------------------
    def tick(self):
        """Stage 2: decide which workspaces need a (re)label. Runs on the GTK loop."""
        if theme_id() != self.theme:
            self.apply_theme()
        try:
            allf = describe_all(sessions=False)
        except Exception as e:  # noqa: BLE001
            log(f"tick: {e}")
            return True
        now = time.time()
        gone = [k for k in self.labels if int(k) not in allf]
        for k in gone:                       # emptied workspace: forget its label
            del self.labels[k]
        if gone:
            save_json(LABELS, self.labels)
        # window ages: a window younger than YOUNG s is not a change yet; one that
        # dies young is logged as an ignored pop-up
        alive = {f["address"]: (ws, f["class"]) for ws, fs in allf.items() for f in fs}
        for a, (ws, cls) in alive.items():
            self.first_seen.setdefault(a, (now, cls, ws))
        for a in [a for a in self.first_seen if a not in alive]:
            t0, cls, ws = self.first_seen.pop(a)
            if now - t0 < YOUNG + POLL:
                self.note(ws, f"short-lived window {cls} (< {YOUNG + POLL} s) ignored")
        young = {a for a, (t0, _, _) in self.first_seen.items() if now - t0 < YOUNG}
        self.watch_awaiting(any(l.get("awaiting") for l in self.labels.values()))
        for ws, fs in allf.items():
            key = str(ws)
            sig = signature(fs, young)
            lab = self.labels.get(key)
            if ws in self.runs and not self.runs[ws]["done"]:
                continue
            if not lab:
                self.enqueue(ws, "no label yet")
                continue
            if lab.get("fallback") and not (ws in self.runs and not self.runs[ws]["done"]):
                fb = fallback_label(fs)        # free: no model, follows the titles
                if fb != lab.get("label"):
                    lab["label"] = fb
                    save_json(LABELS, self.labels)
            if lab.get("awaiting") and not awaiting(fs):
                self.wake(ws, fs)
                continue
            if lab.get("fallback") and not lab.get("awaiting") and now - lab.get("at", 0) >= 1800 and (_gate["val"] or (True,))[0]:  # cached: no ssh on the GTK loop
                self.enqueue(ws, "retry: last label was the window-name fallback")
                continue
            if lab.get("sig") == sig:
                self.changed.pop(key, None)
            if lab.get("sig") != sig:
                seen_sig, first = self.changed.get(key, (None, now))
                if seen_sig != sig:              # a new difference: its 20 s start now
                    self.changed[key] = (sig, now)
                    first = now
                if now - first >= SETTLE:
                    self.enqueue(ws, f"windows changed: {lab.get('sig')} -> {sig}")
                continue
            if now - lab.get("at", 0) >= REFRESH:
                worked = self.worked_seconds(ws, max(lab.get("at", 0), now - REFRESH))
                if worked >= WORK_SECONDS:
                    self.enqueue(ws, f"10-minute refresh (he worked on it: {worked} s of input)")
                elif worked:
                    self.note(ws, f"10-minute refresh due, input below {WORK_SECONDS} s in the window (glances / switch keys only)")
        self.pump()
        return True

    # awaiting desks (his 2026-11-09 ask 1) ----------------------------------------
    def watch_awaiting(self, on):
        if on and self.fast_src is None:
            self.fast_src = self.GLib.timeout_add(FAST_POLL * 1000, self.fast_check)
        elif not on and self.fast_src is not None:
            self.GLib.source_remove(self.fast_src)
            self.fast_src = None

    def fast_check(self):
        """Every FAST_POLL s (and on every title event) while a desk awaits: the
        moment its windows stop being idle, relabel it at once, front of the
        queue, no settle, no young-window wait."""
        waiting = [int(k) for k, l in self.labels.items() if l.get("awaiting")]
        if not waiting:
            self.fast_src = None
            return False
        try:
            clients = hypr_json("clients") or []
            by_desk = desk_clients(clients)
            for ws in waiting:
                fs = facts(by_desk.get(ws, []), clients, sessions=False)
                if fs and not awaiting(fs):
                    self.wake(ws, fs)
        except Exception as e:  # noqa: BLE001
            log(f"fast_check: {e}")
        return True

    def wake(self, ws, fs):
        if ws in self.runs and not self.runs[ws]["done"]:
            return
        lab = self.labels.get(str(ws))
        if lab:
            lab["awaiting"] = False
        busy = [window_topic(f) for f in fs if not idle_window(f)]
        log(f"ws {ws}: woke up ({'; '.join(busy)[:120]}): labelling now")
        self.enqueue(ws, "woke up: work started in an idle desk", front=True)

    def enqueue(self, ws, reason, front=False):
        """Queue a (re)label. Never for an empty workspace (his rule)."""
        if ws in self.runs and not self.runs[ws]["done"]:
            return False
        if not any(q[0] == ws for q in self.queue):
            self.queue.append((ws, reason, time.time(), front))
        if front:
            self.pump()
        return False

    def pump(self):
        """Start EVERY queued workspace now: one parallel capture pass for all of
        them, then their labellers in parallel (MAX_PARALLEL Sonnet calls in flight;
        the workspace he just switched to never waits for a slot)."""
        if not self.queue:
            return
        batch, self.queue = self.queue, []
        for ws, *_ in batch:
            self.runs[ws] = {"events": [], "done": False}
        threading.Thread(target=self.batch, args=(batch,), daemon=True, name="batch").start()

    def batch(self, items):
        """Capture every queued workspace in parallel; each labeller starts the
        moment ITS capture is done (a 2.5 s mpv timeout delays only its own ws)."""
        from concurrent.futures import ThreadPoolExecutor, as_completed
        t0 = time.monotonic()
        with ThreadPoolExecutor(max_workers=max(1, min(8, len(items)))) as pool:
            futs = {pool.submit(capture_desks, [it[0]]): it for it in items}
            for fut in as_completed(futs):
                ws, reason, t_need, front = futs[fut]
                try:
                    rep = fut.result().get(ws)
                except Exception as e:  # noqa: BLE001
                    log(f"ws {ws}: capture crashed: {e}"); rep = None
                if rep is None:          # emptied meanwhile: no agent
                    self.runs[ws]["done"] = True
                    continue
                threading.Thread(target=self.work, args=(ws, reason, rep, t_need, front),
                                 daemon=True, name=f"label-{ws}").start()
        log(f"batch: {len(items)} workspaces captured in parallel, all done in {int((time.monotonic() - t0) * 1000)} ms")

    def work(self, ws, reason, rep, t_need, front):
        run = self.runs[ws]

        def emit(ev):
            if ev.get("type") == "_calling":
                run["calling"] = True
                if self.shown_ws == ws and self.card_ws != ws:
                    self.GLib.idle_add(self.show, ws, True)    # upgrade the shown label to the card
                return
            run["events"].append(ev)
            if self.card_ws == ws:
                self.GLib.idle_add(lambda e=ev: (self.push_card(e), False)[1])
        slot = None if front else self.slots
        if slot:
            slot.acquire()
        t_start = time.time()
        try:
            prev = self.labels.get(str(ws), {}).get("hash") if not front and reason != "asked" else None
            res = run_labeller(ws, emit, reason, rep, prev)
        except Exception as e:  # noqa: BLE001
            log(f"ws {ws}: worker crashed: {e}")
            res = None
        finally:
            if slot:
                slot.release()
        t_done = time.time()
        if res and res.get("skipped"):
            self.labels[str(ws)]["at"] = t_done       # restart the 10-min clock, keep the label
            if res.get("sig") is not None:
                self.labels[str(ws)]["sig"] = res["sig"]   # adopt it: else the same 'change' re-fires (ws 9 loop)
            save_json(LABELS, self.labels)
            self.note(ws, f"input unchanged since the last label ({reason.split(':')[0]}); no call")
            run["done"] = True
            self.GLib.idle_add(self.after_run, ws)
            return
        if res:
            self.labels[str(ws)] = {**res, "at": t_done}
            save_json(LABELS, self.labels)
        log(f"timing ws {ws}: capture {rep.get('ms')} ms, label start +{t_start - t_need:.1f} s, "
            f"label ready +{t_done - t_need:.1f} s after the need was seen ({reason})"
            + (" [fallback]" if res and res.get("fallback") else ""))
        run["done"] = True
        self.GLib.idle_add(self.after_run, ws)

    def after_run(self, ws):
        if self.shown_ws == ws and self.old_box.get_visible():
            # the popup may be locked and read later: show the finished label in
            # full (headline + every bullet), the card keeps its done state
            head, _, rest = self.labels.get(str(ws), {}).get("label", "").partition("\n")
            self.lbl.set_text(head)
            self.lbl.set_line_wrap(len(head) > 70); self.lbl.set_width_chars(min(70, len(head)))
            rest = "\n".join("• " + x for x in rest.splitlines() if x.strip())
            self.det.set_text(rest)
            cap = self.det.get_max_width_chars() or 84
            self.det.set_width_chars(min(cap, max((len(x) for x in rest.splitlines()), default=0)))
            self.det.set_visible(bool(rest.strip()))
            if self.det_in is self.det_box:
                self.det_box.set_visible(bool(rest.strip()))
            self.GLib.idle_add(self.set_input_region)
        self.pump()
        return False

    def run(self):
        self.build()
        self.Gtk.main()


def cmd_daemon(args):
    Daemon().run()


def _send(msg):
    s = socket.socket(socket.AF_UNIX)
    try:
        s.connect(CMD_SOCK); s.sendall(msg.encode()); print(s.recv(64).decode().strip())
    except OSError as e:
        print(f"daemon not running ({e})"); return 1
    return 0


def cmd_show(args):
    return _send("show " + " ".join(args))


def cmd_simulate(args):
    return _send("simulate " + " ".join(args))


def cmd_relabel(args):
    return _send("relabel " + args[0])


def cmd_lock(args):
    return _send("lock")


def cmd_unlock(args):
    return _send("unlock")


def cmd_status(args):
    labels = load_json(LABELS, {})
    health = load_json(HEALTH, {})
    for ws in sorted({*labels, *health}, key=int):
        lab = labels.get(ws, {})
        h = health.get(ws, {})
        age = f"{(time.time() - lab['at']) / 60:.0f} min ago" if lab.get("at") else "-"
        print(f"ws {ws:>2}  {lab.get('label', '(none)')!r:40} {age:>12}  capture {h.get('ok', '?')}/{len(h.get('windows', []))}"
              + (f"  fallback: {'; '.join(h['failed'])}" if h.get("failed") else ""))


def main():
    cmd, args = (sys.argv[1], sys.argv[2:]) if len(sys.argv) > 1 else ("help", [])
    fn = {"capture": cmd_capture, "prompt": cmd_prompt, "label": cmd_label, "daemon": cmd_daemon,
          "show": cmd_show, "relabel": cmd_relabel, "simulate": cmd_simulate, "status": cmd_status,
          "lock": cmd_lock, "unlock": cmd_unlock}.get(cmd)
    if not fn:
        print(__doc__)
        return 0 if cmd in ("help", "-h", "--help") else 2
    return fn(args) or 0


if __name__ == "__main__":
    sys.exit(main())
