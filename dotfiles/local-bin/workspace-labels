class Daemon:
    # GTK3 + gtk-layer-shell + WebKit2GTK 4.1 (same stack as bar-touch). The
    # GTK4/WebKitGTK-6.0 route in SPEC §1 is blocked on this laptop: the repo's
    # webkitgtk-6.0 2.52.6 needs glibc 2.44 (installed 2.43) until the next -Syu.
    def __init__(self):
        import gi
        gi.require_version("Gtk", "3.0")
        gi.require_version("Gdk", "3.0")
        gi.require_version("GtkLayerShell", "0.1")
        gi.require_version("WebKit2", "4.1")
        from gi.repository import GLib, Gtk, Gdk, GtkLayerShell as LS, WebKit2
        self.GLib, self.Gtk, self.Gdk, self.LS, self.WebKit = GLib, Gtk, Gdk, LS, WebKit2
        self.labels = load_json(LABELS, {})
        self.runs = {}            # ws -> {"events": [...], "done": bool}
        self.changed = {}         # ws+sig -> time the signature first differed
        self.activity = {}        # ws -> [int seconds with real input while it was active]
        self.switched_at = 0.0
        self.sw_lock = threading.Lock()
        self.sw_events = []       # workspace events of the current burst
        self.sw_t0 = None         # monotonic time of the burst's first event
        self.first_seen = {}      # window address -> (time first seen, class, ws)
        self.noted = {}           # ws -> last skip reason logged (log each reason once)
        self.active_ws = (hypr_json("activeworkspace") or {}).get("id")
        self.shown_ws = None
        self.shown_at = 0.0
        self.card_ws = None
        self.page_ready = False
        self.queue = []
        self.slots = threading.Semaphore(MAX_PARALLEL)
        self.locked = False        # popup stays until Esc / tap / unlock (his 2026-11-09)
        self.super_down = None     # time Super went down (None = up)
        self.super_quiet = 0.0     # last other input while Super was held
        self.super_combo = False   # another key went down during this Super hold: it never locks
        self.hold_src = None       # GLib source watching the Super hold
        self.fast_src = None       # GLib source polling awaiting desks
        self._esc_t = 0.0

    # popup ------------------------------------------------------------------
    def build(self):
        Gtk, LS, WebKit, Gdk = self.Gtk, self.LS, self.WebKit, self.Gdk
        win = Gtk.Window()
        win.set_decorated(False)
        win.set_app_paintable(True)
        vis = win.get_screen().get_rgba_visual()
        if vis:
            win.set_visual(vis)
        LS.init_for_window(win)
        LS.set_namespace(win, APP)
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_anchor(win, LS.Edge.TOP, True)
        LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
        LS.set_exclusive_zone(win, -1)
        self.css = None
        self.theme = None
        self.apply_theme()
        win.get_style_context().add_class("wsl")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        old = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
