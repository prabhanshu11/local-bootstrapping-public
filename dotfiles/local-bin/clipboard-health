#!/bin/bash
# clipboard-health - Detect and fix broken clipboard watcher
#
# Issue: The elephant clipboard manager spawns wl-paste --watch to monitor
# clipboard changes. If wl-paste dies or becomes a zombie, new clipboard
# items stop being captured (existing history still works).
#
# This script detects the problem and restarts elephant to fix it.
#
# Usage: clipboard-health [--fix]
#   --fix    Automatically restart elephant if broken (default is check-only)

set -euo pipefail

FIX_MODE=false
if [[ "${1:-}" == "--fix" ]]; then
    FIX_MODE=true
fi

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_ok() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_err() { echo -e "${RED}[ERR]${NC} $1"; }

# Check if elephant service is running
check_elephant_running() {
    if systemctl --user is-active --quiet elephant.service 2>/dev/null; then
        return 0
    fi
    return 1
}

# Check for zombie wl-paste under elephant
check_zombie_wl_paste() {
    local elephant_pid
    elephant_pid=$(pgrep -x elephant 2>/dev/null || true)

    if [[ -z "$elephant_pid" ]]; then
        return 1  # No elephant process
    fi

    # Check for zombie wl-paste with elephant as parent
    if ps --ppid "$elephant_pid" -o stat,comm 2>/dev/null | grep -q "^Z.*wl-paste"; then
        return 0  # Zombie found
    fi
    return 1
}

# Check if wl-paste --watch is running under elephant
check_wl_paste_watcher() {
    local elephant_pid
    elephant_pid=$(pgrep -x elephant 2>/dev/null || true)

    if [[ -z "$elephant_pid" ]]; then
        return 1  # No elephant process
    fi

    # Check for live wl-paste --watch process
    if pgrep -P "$elephant_pid" -a 2>/dev/null | grep -q "wl-paste.*--watch"; then
        return 0  # Watcher is running
    fi
    return 1
}

# Fix by restarting elephant
fix_clipboard() {
    log_warn "Restarting elephant.service to fix clipboard..."
    if systemctl --user restart elephant.service; then
        sleep 1
        if check_wl_paste_watcher; then
            log_ok "Clipboard restored successfully"
            return 0
        else
            log_err "Restart succeeded but wl-paste watcher not running"
            return 1
        fi
    else
        log_err "Failed to restart elephant.service"
        return 1
    fi
}

main() {
    local issues_found=false
    local exit_code=0

    # Check 1: Is elephant running?
    if ! check_elephant_running; then
        log_err "elephant.service is not running"
        issues_found=true
        if $FIX_MODE; then
            systemctl --user start elephant.service
            sleep 1
        fi
    else
        log_ok "elephant.service is running"
    fi

    # Check 2: Any zombie wl-paste?
    if check_zombie_wl_paste; then
        log_err "Zombie wl-paste process detected (clipboard capture broken)"
        issues_found=true
        if $FIX_MODE; then
            fix_clipboard
        fi
    else
        log_ok "No zombie wl-paste processes"
    fi

    # Check 3: Is wl-paste watcher alive?
    if check_elephant_running && ! check_wl_paste_watcher; then
        log_err "wl-paste --watch not running (clipboard capture broken)"
        issues_found=true
        if $FIX_MODE; then
            fix_clipboard
        fi
    elif check_elephant_running; then
        log_ok "wl-paste --watch is monitoring clipboard"
    fi

    # Summary
    echo ""
    if $issues_found; then
        if $FIX_MODE; then
            # Re-check after fix attempt
            if check_elephant_running && check_wl_paste_watcher && ! check_zombie_wl_paste; then
                log_ok "All issues fixed"
                exit_code=0
            else
                log_err "Some issues remain"
                exit_code=1
            fi
        else
            log_warn "Issues detected. Run with --fix to repair."
            exit_code=1
        fi
    else
        log_ok "Clipboard health: OK"
        exit_code=0
    fi

    return $exit_code
}

main "$@"
