            play.get_style_context().add_class("bt-btn")
            play.get_style_context().add_class("bt-mh-btn")
            # offline rows stay tappable: the tap says why instead of hanging mpv
            play.set_sensitive(bool(e.get("exists") or e.get("unreachable")))
            play.connect("clicked", lambda *_: self.act("open", e))
            btns.pack_start(play, False, False, 0)
            fold = Gtk.Button(label="\uf07c  Folder")
            fold.get_style_context().add_class("bt-btn")
            fold.get_style_context().add_class("bt-mh-btn")
            fold.set_sensitive(bool(e.get("dir_exists") or e.get("unreachable")))
            fold.connect("clicked", lambda *_: self.act("folder", e))
            if not web:                         # a web page has no folder
                btns.pack_start(fold, False, False, 0)
            box.pack_end(btns, False, False, 0)
