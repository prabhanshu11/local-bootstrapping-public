        # ── data ──
        def reload(self):
            self.gen += 1
            gen, span = self.gen, self.span

            def work():
                try:
                    data = json.loads(sh_out([BATTERY_INFO, "json", str(span)], timeout=6) or "null")
                except ValueError:
                    data = None
                GLib.idle_add(self.render, gen, data)
            threading.Thread(target=work, daemon=True).start()

        def on_tick(self):
            if not self.win:
                self.tick = None
                return False
            self.reload()
            return True

        def color(self):
            d = self.data
            cls = d.get("classes", [])
            if "critical" in cls:
                return RED
            if "warning" in cls or d["state"] == "ac-drain":
                return AMBER
            if d["state"] in ("charging", "full", "held", "plugged"):
                return GREEN
            return None

        def render(self, gen, d):
            if gen != self.gen or not self.win:
                return False
            if not d:
                self.headline.set_text("battery-info gave no answer.")
                return False
            self.data = d
            b, c, g = d["battery"], d["charger"], d["guard"]
            col = self.color()
            esc = GLib.markup_escape_text
            self.pct.set_markup(f"<span foreground='{hexcol(col)}'>{b['percent']:.0f}%</span>"
                                if col else f"{b['percent']:.0f}%")
            glyph = d.get("icon", "")
            head = f"{glyph}  {esc(d['headline'])}"
            self.headline.set_markup(f"<span foreground='{hexcol(col)}'>{head}</span>" if col else head)
            self.why.set_text(d.get("why") or "")
            self.why.set_visible(bool(d.get("why")))

            now_rows = []
            flow = d.get("flow_w")
            def hm(hours):
                m = int(round(hours * 60))
                return f"{m // 60} h {m % 60:02d} min" if m >= 60 else f"{m} min"
            if flow is not None:
                if abs(flow) <= 0.4:
                    txt = "steady, neither rising nor falling"
                else:
                    txt = f"<b>{'charging' if flow > 0 else 'draining'} {abs(flow):.1f} W</b>"
                    if d.get("pct_per_h") is not None:
                        txt += f" ({abs(d['pct_per_h']):.0f}%/h)"
                src = "10-min average" if d.get("net_w") is not None else "reading now"
                now_rows.append(("Flow", f"{txt} <span alpha='60%'>· {src}</span>"))
            for i, e in enumerate(d.get("estimates") or []):
                now_rows.append(("Forecast" if i == 0 else "",
                                 f"{esc(e.get('short') or e['what'])}: <b>in {hm(e['hours'])}</b>, ~{e['at']}"))
            if d.get("since"):
                s = d["since"]
                where = s.get("what", "plugged in").capitalize()
                now_rows.append(("Since", f"{where} since {s['at']} ({hm(s['hours'])}), from {s['pct']:.0f}%"))
            self.fill_grid(self.now_grid, now_rows)

            bat_rows = []
            if b.get("wh_now") is not None and b.get("wh_full"):
                volts = f" · {b['volts']:.2f} V" if b.get("volts") else ""
                bat_rows.append(("Energy", f"{b['wh_now']:.1f} of {b['wh_full']:.1f} Wh{volts}"))
            if b.get("health"):
                bat_rows.append(("Health", f"{b['health']:.0f}% of new ({b['wh_design']:.1f} Wh) · "
                                           f"{b['cycles']} cycles"))
            bat_rows.append(("Charger", esc(d.get("charger_text") or "")))
            lo, hi = b.get("limit_start"), b.get("limit_end")
            if hi and hi < 100:
                bat_rows.append(("Limit", f"charging stops at {hi:.0f}%" + (f", resumes below {lo:.0f}%" if lo else "")))
            else:
                bat_rows.append(("Limit", "none, charges to 100%"))
            if g.get("active"):
                gtxt = f"suspends at {g['upper']}%, again at {g['lower']}%"
                if g.get("last_resort", "none") != "none":
                    gtxt += f" · last resort: {g['last_resort']} at {g.get('last_resort_pct')}%"
                if g.get("ac_drain"):
                    gtxt += " · <b>AC-drain watch on</b>"
                if g.get("retry_pending"):
                    gtxt += " · <b>last forced suspend failed, retrying</b>"
                bat_rows.append(("Guard", gtxt))
            elif g.get("installed"):
                bat_rows.append(("Guard", f"<b>guard timer {esc(str(g.get('timer')))}</b> — nothing suspends at "
                                          f"{g['upper']}%/{g['lower']}%"))
            ls = d.get("last_sleep")
            if ls:   # sleep-verified's last verdict (2026-10-03)
                bat_rows.append(("Last sleep", esc(ls["text"]) if ls.get("ok") else f"<b>{esc(ls['text'])}</b>"))
            self.fill_grid(self.bat_grid, bat_rows)

            for key, btn in self.prof_btns.items():
                name = dict(self.PROFILES)[key]
                btn.set_label(f"● {name}" if key == d.get("profile") else name)
            for secs, btn in self.span_btns.items():
                btn.set_label(("● " if secs == self.span else "") + dict((v, k) for k, v in self.SPANS)[secs])
            leg = (f"<span foreground='{hexcol(GREEN)}'>▨ charging</span>  "
                   f"<span foreground='{hexcol(AMBER)}'>▥ plugged, not charging</span>  ▬ on battery  ┄ forecast")
            self.legend.set_markup(leg)
            self.gauge.queue_draw()
            self.chart.queue_draw()
            self.win.show_all()
            self.why.set_visible(bool(d.get("why")))
            return False

        def fill_grid(self, grid, rows):
            for child in grid.get_children():
                child.destroy()
            for i, (k, v) in enumerate(rows):
                kl = label(k, "bt-dim", wrap=False)
                kl.set_valign(Gtk.Align.START)
                grid.attach(kl, 0, i, 1, 1)
                vl = label(v, "bt-body", markup=True)
                vl.set_hexpand(True)
                grid.attach(vl, 1, i, 1, 1)

        # ── drawing ──
        def text(self, cr, s, x, y, size=9, align=0.0, rgba=None):
            layout = PangoCairo.create_layout(cr)
            layout.set_font_description(Pango.FontDescription(f"JetBrainsMono Nerd Font {size}"))
            layout.set_text(s, -1)
            w, h = layout.get_pixel_size()
            if rgba:
                cr.set_source_rgba(*rgba)
            cr.move_to(x - w * align, y)
            PangoCairo.show_layout(cr, layout)
            return w, h

        def draw_gauge(self, area, cr):
            d = self.data
            if not d:
                return False
            fg = area.get_style_context().get_color(Gtk.StateFlags.NORMAL)
            W = area.get_allocated_width()
            bh, top = 22, 2
            pct = max(0.0, min(100.0, d["battery"]["percent"]))

            def rounded(x, y, w, h, r):
                cr.new_sub_path()
                cr.arc(x + w - r, y + r, r, -1.5708, 0)
                cr.arc(x + w - r, y + h - r, r, 0, 1.5708)
                cr.arc(x + r, y + h - r, r, 1.5708, 3.1416)
                cr.arc(x + r, y + r, r, 3.1416, 4.7124)
                cr.close_path()
            rounded(0, top, W, bh, 6)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.10)
            cr.fill_preserve()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.35)
            cr.set_line_width(1)
            cr.stroke()
            col = self.color()
            fw = W * pct / 100
            if fw > 1:
                cr.save()
                rounded(0, top, W, bh, 6)
                cr.clip()
                cr.rectangle(0, top, fw, bh)
                cr.set_source_rgba(*(col or (fg.red, fg.green, fg.blue)), 0.85 if col else 0.55)
                cr.fill()
                if d["state"] == "charging":          # hatch: a pattern, not only a colour
                    cr.rectangle(0, top, fw, bh)
                    cr.clip()
                    cr.set_source_rgba(0, 0, 0, 0.25)
                    cr.set_line_width(2)
                    for x0 in range(-bh, int(fw) + bh, 8):
                        cr.move_to(x0, top + bh)
                        cr.line_to(x0 + bh, top)
                    cr.stroke()
                cr.restore()
            # marks: battery-guard suspend levels and the charge limit
            g, b = d["guard"], d["battery"]
            marks = []
            if g.get("active"):
                marks += [(g["lower"], f"{g['lower']}%"), (g["upper"], f"{g['upper']}% suspend")]
                if g.get("last_resort", "none") != "none":
                    # short label left of its tick: it sits ~20 px from the bar's left edge and
                    # next to the lower limit's (the Guard row names the hibernate)
                    marks.append((g["last_resort_pct"], f"{g['last_resort_pct']}%", 1.0))
            if b.get("limit_end") and b["limit_end"] < 100:
                marks.append((b["limit_end"], f"limit {b['limit_end']:.0f}%"))
            for lvl, text, *al in marks:
                x = W * lvl / 100
                cr.set_source_rgba(*RED, 0.95)
                cr.set_line_width(2)
                cr.set_dash([3, 2])
                cr.move_to(x, top - 1)
                cr.line_to(x, top + bh + 3)
                cr.stroke()
                cr.set_dash([])
                align = al[0] if al else 0.0
                self.text(cr, text, x - 3 if align else x + 3, top + bh + 1, size=8, align=align,
                          rgba=(fg.red, fg.green, fg.blue, 0.75))
            return False

        def draw_chart(self, area, cr):
            d = self.data
            if not d:
                return False
            fg = area.get_style_context().get_color(Gtk.StateFlags.NORMAL)
            W, H = area.get_allocated_width(), area.get_allocated_height()
            L, R, T, B = 34, 6, 6, 18
            now, span = d["time"], self.span
            est = (d.get("estimates") or [])[:1]
            ahead = span * 0.25 if est else span * 0.04
            t0, t1 = now - span, now + ahead
            X = lambda t: L + (t - t0) / (t1 - t0) * (W - L - R)
            Y = lambda v: T + (1 - v / 100) * (H - T - B)
            dim = (fg.red, fg.green, fg.blue)
            # grid + labels
            cr.set_line_width(1)
            for v in (0, 25, 50, 75, 100):
                cr.set_source_rgba(*dim, 0.12 if v % 50 else 0.22)
                cr.move_to(L, Y(v) + 0.5)
                cr.line_to(W - R, Y(v) + 0.5)
                cr.stroke()
                if v % 50 == 0:
                    self.text(cr, f"{v}%", L - 4, Y(v) - 7, size=8, align=1.0, rgba=(*dim, 0.6))
            g = d["guard"]
            if g.get("active"):
                cr.set_source_rgba(*RED, 0.7)
                cr.set_dash([4, 3])
                cr.move_to(L, Y(g["upper"]))
                cr.line_to(W - R, Y(g["upper"]))
                cr.stroke()
                cr.set_dash([])
                self.text(cr, f"suspend {g['upper']}%", L + 3, Y(g["upper"]) + 1, size=8,
                          rgba=(*RED, 0.9))
            # time axis: round clock times
            step = {3600: 900, 6 * 3600: 3600, 24 * 3600: 4 * 3600}.get(span, span // 6)
            lt = time.localtime(t0)
            t = t0 - (lt.tm_min * 60 + lt.tm_sec + (lt.tm_hour * 3600 if step >= 4 * 3600 else 0)) % step + step
            while t < t1:
                x = X(t)
                cr.set_source_rgba(*dim, 0.10)
                cr.move_to(x + 0.5, T)
                cr.line_to(x + 0.5, H - B)
                cr.stroke()
                if x < W - R - 16:          # a label cut by the right edge is noise
                    self.text(cr, time.strftime("%H:%M", time.localtime(t)), x, H - B + 2, size=8,
                              align=0.5, rgba=(*dim, 0.6))
                t += step
            # the series: history points + "now"
            pts = [(max(tt, t0), v, s) for tt, v, s in d.get("history") or []]
            state_now = {"charging": "charging", "discharging": "discharging"}.get(d["state"], "plugged")
            pts.append((now, d["battery"]["percent"], state_now))
            colors = {"charging": GREEN, "discharging": dim, "plugged": AMBER, "full": GREEN}
            for (ta, va, _), (tb, vb, sb) in zip(pts, pts[1:]):
                if tb <= ta:
                    continue
                col = colors.get(sb, dim)
                cr.move_to(X(ta), Y(va))
                cr.line_to(X(tb), Y(vb))
                cr.line_to(X(tb), Y(0))
                cr.line_to(X(ta), Y(0))
                cr.close_path()
                cr.set_source_rgba(*col, 0.28 if sb == "charging" else 0.12)
                if sb in ("charging", "plugged"):
                    # a pattern per state, not only a colour: diagonal hatch =
                    # charging, vertical stripes = plugged in but not charging
                    cr.save()
                    cr.fill_preserve()
                    cr.clip()
                    cr.set_source_rgba(*col, 0.35 if sb == "charging" else 0.45)
                    cr.set_line_width(1)
                    lean = H if sb == "charging" else 0      # 45° hatch
                    for x0 in range(int(X(ta)) - H - 10, int(X(tb)) + 10, 7 if lean else 5):
                        cr.move_to(x0 + 0.5, Y(0))
                        cr.line_to(x0 + 0.5 + lean, Y(0) - H)
                    cr.stroke()
                    cr.restore()
                    cr.new_path()
                else:
                    cr.fill()
                cr.set_source_rgba(*col, 0.95)
                cr.set_line_width(2)
                cr.move_to(X(ta), Y(va))
                cr.line_to(X(tb), Y(vb))
                cr.stroke()
            # now marker
            cr.set_source_rgba(*dim, 0.35)
            cr.set_line_width(1)
            cr.move_to(X(now) + 0.5, T)
            cr.line_to(X(now) + 0.5, H - B)
            cr.stroke()
            pct = d["battery"]["percent"]
            cr.set_source_rgba(*(self.color() or dim), 1)
            cr.arc(X(now), Y(pct), 4, 0, 6.2832)
            cr.fill()
            # forecast to the first stop (guard suspend / empty / full)
            if est:
                e = est[0]
                te = now + e["hours"] * 3600
                frac = min(1.0, (t1 - now) / max(1.0, te - now))
                xe, ye = now + (te - now) * frac, pct + (e["level"] - pct) * frac
                cr.set_source_rgba(*(self.color() or dim), 0.9)
                cr.set_line_width(2)
                cr.set_dash([5, 4])
                cr.move_to(X(now), Y(pct))
                cr.line_to(X(xe), Y(ye))
                cr.stroke()
                cr.set_dash([])
                tag = f"{e['level']:.0f}% ~{e['at']}" if frac >= 1 else f"→ {e['level']:.0f}% ~{e['at']}"
                self.text(cr, tag, min(X(xe), W - R - 2), Y(ye) + (4 if ye > 50 else -16), size=8, align=1.0,
                          rgba=(*(self.color() or dim), 1))
            return False

        # ── actions ──
        def on_span(self, _btn, secs):
            self.bump()
            self.span = secs
            self.reload()

        def on_profile(self, _btn, key):
            self.bump()

            def work():
                sh_out([POWER_PROFILE, "set", key], timeout=8)
                GLib.idle_add(lambda: (self.reload(), False)[1])
            threading.Thread(target=work, daemon=True).start()

        def on_menu(self, *_):
            env = self.env
            self.hide()
            run_detached("omarchy-menu system", env)

        def bump(self):
            if self.timer:
                GLib.source_remove(self.timer)
            self.timer = GLib.timeout_add_seconds(60, self.hide)

        def hide(self, *_):
            for attr in ("timer", "tick"):
                if getattr(self, attr):
                    GLib.source_remove(getattr(self, attr))
                    setattr(self, attr, None)
            if self.win:
                self.win.destroy()
                self.win = None
            return False

    MPV_HISTORY = os.path.expanduser("~/.local/bin/mpv-history")
    MPV_HISTORY_LIST = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"),
                                    "mpv-history", "list.json")
    MPV_HISTORY_WEB = os.path.join(os.path.dirname(MPV_HISTORY_LIST), "list-web.json")

    def ago(ts):
        if not ts:
            return ""
        d = time.time() - ts
        if d < 90:
            return "just now"
        if d < 3600:
            return f"{int(d // 60)} min ago"
        if d < 86400:
            return f"{int(d // 3600)} h ago"
        if d < 7 * 86400:
            return time.strftime("%a %H:%M", time.localtime(ts))
        return time.strftime("%d %b", time.localtime(ts))

    def hms(sec):
        if not sec or sec <= 0:
            return "--:--"
        sec = int(sec)
        h, rem = divmod(sec, 3600)
        m, s = divmod(rem, 60)
        return f"{h}:{m:02d}:{s:02d}" if h else f"{m:02d}:{s:02d}"

    class MpvHistoryPopup:
        """Recently watched videos (2026-10-03, "show the history of mpv player…
        buttons to open their folder location in thunar, when I touch on their
        thumbnail, they preview play at 20X speed"). Data and thumbnails come from
        ~/.local/bin/mpv-history (history.jsonl written by the mpv script).

        The 20x preview decodes reference frames only (-skip_frame bidir, ~5 % of
        one core for 720p HEVC; full decode cannot reach 20x on this CPU), the fps
        filter turns them into one frame per STEP s of video, and the reader shows
        one frame every STEP/SPEED s of wall time, so the clock really runs 20x."""
        WIDTH = 780
        TW, TH = 192, 108
        SPEED = 20
        STEP = 2.0                 # s of video per shown frame -> 10 fps on screen
        IDLE = 90                  # s without a touch before it closes (not while previewing)

        def __init__(self):
            self.win = None
            self.timer = None
            self.env = dict(os.environ)
            self.gen = 0
            self.data = []
            self.rows = {}         # path -> dict(widgets)
            self.preview = None    # dict(path, proc, stop, tick)
            self.query = ""
            self.tab = "files"     # "files" (any player) | "web" (browser videos), his 2026-11-06 "have 2 tabs"
            self.tabs = {}

        # ── layout ──
        def show(self, env, x_local, mon):
            self.hide()
