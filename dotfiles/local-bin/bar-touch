# keeps its result list untargetable until the POINTER moves twice, so a finger tap on
# an entry does nothing. The daemon nudges the pointer when a walker menu opens.
WALKER_NS = "walker"         # layer namespace of walker's window
WALKER_BOX_HALF = 380        # logical px either side of the monitor centre: walker's box
WALKER_TOUCH_RECENT = 5.0    # s: a menu opening this soon after a touch was opened by finger
WALKER_REPLAY_DELAY = 200    # ms after the lift before a lost tap is replayed as a click


# ─────────────────────────────── shared helpers ───────────────────────────────

def strip_jsonc(text):
    """Remove // and /* */ comments outside strings (waybar config is JSONC)."""
    out, i, n = [], 0, len(text)
    in_str = False
    while i < n:
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(text[i + 1]); i += 2; continue
            if c == '"':
                in_str = False
            i += 1
        elif c == '"':
            in_str = True; out.append(c); i += 1
        elif text.startswith("//", i):
            j = text.find("\n", i)
            i = n if j < 0 else j
        elif text.startswith("/*", i):
            j = text.find("*/", i + 2)
            i = n if j < 0 else j + 2
        else:
            out.append(c); i += 1
    return "".join(out)


_config_cache = {"mtime": None, "data": {}}


def waybar_modules():
    """Top-level waybar config as a dict, re-read when the file changes."""
    try:
        mtime = os.stat(WAYBAR_CONFIG).st_mtime
        if mtime != _config_cache["mtime"]:
            with open(WAYBAR_CONFIG) as f:
                data = json.loads(strip_jsonc(f.read()), strict=False)
            if isinstance(data, list):
                data = data[0] if data else {}
            _config_cache.update(mtime=mtime, data=data)
    except (OSError, ValueError) as exc:
        print(f"config read failed: {exc}", flush=True)
    return _config_cache["data"]


def module_spec(name):
    cfg = waybar_modules()
    mod = cfg.get(name, {}) if isinstance(cfg.get(name), dict) else {}
    touch = mod.get("touch", {}) if isinstance(mod.get("touch"), dict) else {}
    return mod, touch


def send(msg, timeout=0.4, reply_timeout=3.0):
    """Reply dict, or None ONLY when the daemon cannot be reached (connect
    failed). A slow or missing reply returns {"no_reply": True}: the daemon has
    the request and will act on it, so callers must not run it a second time.
    (Before 2026-11-01 a reply slower than 0.4 s returned None and cmd_click ran
    the module's command itself too: a swapped-in daemon toggled the power
    profile twice. docs/issues/power-button-ram-resident-risk-analysis.md risk 4.)"""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK)
    except OSError:
        return None
    try:
        s.settimeout(reply_timeout)
        s.sendall((json.dumps(msg) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        reply = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            reply += chunk
        s.close()
        return json.loads(reply) if reply else {}
    except (OSError, ValueError):
        s.close()
        return {"no_reply": True}


def mouse_mode_on():
    try:
        with open(MOUSE_FLAG) as f:
            return f.read().strip() == "on"
    except OSError:
        return False


def run_detached(cmd, env=None):
    subprocess.Popen(["setsid", "-f", "sh", "-c", cmd], env=env,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL).wait()


def send_line(sock_name, line):
    """Fire one text line at a RAM-resident helper's unix socket (relative names
    live in $XDG_RUNTIME_DIR). False when it cannot connect: the caller then runs
    the module's command instead. The reply is drained in a thread, never waited on.
    Used by "click-socket" (power-profile-daemon, 2026-11-01): skips the shell
    and a Python start-up on every tap."""
    path = sock_name if sock_name.startswith("/") else os.path.join(RUNTIME, sock_name)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(0.3)
    try:
        s.connect(path)
        s.sendall((line + "\n").encode())
    except OSError:
        s.close()
        return False

    def drain():
        try:
            s.settimeout(5)
            s.recv(4096)
        except OSError:
            pass
        s.close()
    threading.Thread(target=drain, daemon=True).start()
    return True


def run_click(touch, env=None):
    """A module's tap action: its "click-socket" line when the helper is up,
    else its "click" command."""
    spec = touch.get("click-socket")
    if spec:
        sock_name, _, line = spec.partition(" ")
        if send_line(sock_name, line):
            return
    run_detached(touch["click"], env)


# ─────────────────────────────── client commands ──────────────────────────────

def cmd_click(module):
    if send({"cmd": "click", "module": module, "env": dict(os.environ)}) is None:
        # Daemon down (could not even connect): behave like the plain bar did.
        _, touch = module_spec(module)
        if touch.get("click"):
            run_detached(touch["click"])


def cmd_mouse(action):
    reply = send({"cmd": "mouse", "set": action})
    if reply is None:
        subprocess.run(["notify-send", "-u", "critical", "Mouse mode",
                        "bar-touch daemon is not running:\nsystemctl --user start bar-touch"])
        sys.exit(1)


def cmd_mouse_status():
    if mouse_mode_on():
        print(json.dumps({"text": HAND, "class": "on",
                          "tooltip": "Mouse mode ON\nTap = left click where you touch, long press = right click,\n"
                                     "drag = drag, two fingers up = all open windows"}))
    else:
        print(json.dumps({"text": HAND, "class": "off",
                          "tooltip": "Mouse mode OFF\nTap to make the touchscreen act as a mouse"}))


# ─────────────────────────────────── daemon ───────────────────────────────────

def cmd_daemon():
    import faulthandler
    import signal as _signal
    # `kill -USR1 <pid>` dumps every thread's Python stack to the journal.
    faulthandler.register(_signal.SIGUSR1, all_threads=True)
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import Gdk, GLib, Gtk, GtkLayerShell, Pango, PangoCairo
    import evdev
    from evdev import UInput, ecodes as E

    def log(msg):
        print(msg, flush=True)

    # ── Hyprland IPC ──
    def hypr(cmd):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        path = os.path.join(RUNTIME, "hypr", sig, ".socket.sock")
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(1.0)
            s.connect(path)
            s.sendall(cmd.encode())
            data = b""
            while True:
                chunk = s.recv(65536)
                if not chunk:
                    break
                data += chunk
            s.close()
            return data.decode(errors="replace")
        except OSError as exc:
            log(f"hyprland ipc failed ({cmd.split()[0]}): {exc}")
            return ""

    def hypr_json(what):
        try:
            return json.loads(hypr("j/" + what) or "null")
        except ValueError:
            return None

    def with_target_window(name, env):
        """"pass-target-window": true (voice typing, 2026-09-27): the window that
        was active when the card opened / the tap landed goes to the action as
        HYPRWHSPR_TARGET_WINDOW=<address>, so a touch on the card (which may
        refocus a window under it) cannot change where the text is typed."""
        _, touch = module_spec(name)
        if not touch.get("pass-target-window"):
            return env
        aw = hypr_json("activewindow") or {}
        env = dict(env or os.environ)
        env.pop("HYPRWHSPR_TARGET_WINDOW", None)
        if aw.get("address"):
            env["HYPRWHSPR_TARGET_WINDOW"] = aw["address"]
            log(f"{name}: target window {aw.get('class')} / {(aw.get('title') or '')[:40]} {aw['address']}")
        else:
            log(f"{name}: no active window to pass as the target")
        return env

    def touch_monitor():
        mons = hypr_json("monitors") or []
        for m in mons:
            if m.get("name", "").startswith("eDP"):
                return m
        for m in mons:
            if m.get("focused"):
                return m
        return mons[0] if mons else {"x": 0, "y": 0, "width": 1920, "height": 1080, "scale": 1, "transform": 0}

    def bar_height(mon=None):
        """Height of the top waybar on the touchscreen's monitor (26 or 33)."""
        mon = mon or touch_monitor()
        layers = hypr_json("layers") or {}
        levels = (layers.get(mon.get("name", "")) or {}).get("levels", {})
        for level in levels.values():
            for surf in level:
                if "waybar" in surf.get("namespace", "") and surf.get("y", 99) <= mon.get("y", 0) + 2:
                    return surf.get("h", 26)
        return 26

    def gdk_monitor_for(mon):
        display = Gdk.Display.get_default()
        for i in range(display.get_n_monitors()):
            gm = display.get_monitor(i)
            g = gm.get_geometry()
            if g.x == mon.get("x") and g.y == mon.get("y"):
                return gm
        return display.get_monitor(0)

