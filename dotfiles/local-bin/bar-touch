    .bt-kbd { border-radius: 14px 14px 0 0; padding: 10px 16px 12px 16px; }
    .bt-key { min-height: 58px; border-radius: 8px; margin: 0; padding: 0 2px;
              background-image: none; background-color: alpha(@foreground, 0.10);
