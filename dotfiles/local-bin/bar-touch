        def mark_tab(self):
            for k, b in self.tabs.items():
                (b.get_style_context().add_class if k == self.tab
                 else b.get_style_context().remove_class)("selected")

        def switch_tab(self, key):
            if key == self.tab or not self.win:
                return
            self.stop_preview()
            self.tab = key
            self.gen += 1                  # drop a refresh still running for the other tab
            self.data = []
            self.rows = {}
            for child in self.list.get_children():
                child.destroy()
            self.mark_tab()
            self.note = "refreshing…"
            self.apply_filter()
            self.load_tab()

        def load_tab(self):
            # 2026-11-05: the last good list at once (a dead Pi share once left this
            # panel on "Reading…" and then empty), then refresh in the background.
            cached, self.cached_at = self.read_cache()
            if cached is not None:
                self.fill(self.gen, cached)
            self.reload()

        def read_cache(self):
            try:
                path = MPV_HISTORY_WEB if self.tab == "web" else MPV_HISTORY_LIST
                with open(path, encoding="utf-8") as f:
                    data = json.load(f)
                return (data if isinstance(data, list) else None), os.path.getmtime(path)
            except (OSError, ValueError):
                return None, 0

        def reload(self):
            gen = self.gen

            def work():
                out = sh_out([MPV_HISTORY, "list", "--limit", "60"] + (["--web"] if self.tab == "web" else []),
                             timeout=10)
                try:
                    data = json.loads(out) if out.strip() else None
                except ValueError:
                    data = None
                if data is None:
                    # never swap rows for an empty list because the refresh failed
                    GLib.idle_add(self.refresh_failed, gen)
                    return
                GLib.idle_add(self.fill, gen, data, True)
                # thumbnails, newest first, one at a time (cached after the first run)
                for e in data:
                    if gen != self.gen:
                        return
                    if (not e.get("thumb") and e.get("exists") and not e.get("unreachable")
                            and e.get("kind") != "web"):
                        path = sh_out([MPV_HISTORY, "thumb", e["path"]], timeout=30).strip()
                        if path:
                            GLib.idle_add(self.set_thumb, gen, e["path"], path)
            threading.Thread(target=work, daemon=True).start()

        def refresh_failed(self, gen):
            if gen != self.gen or not self.win:
                return False
            when = time.strftime("%H:%M", time.localtime(self.cached_at)) if self.cached_at else ""
            self.note = (f"could not refresh: showing the list from {when}" if self.rows and when
                         else "could not read the history: tap ✕ and open again")
            self.apply_filter()
            return False

        def fill(self, gen, data, fresh=False):
            if gen != self.gen or not self.win:
                return False
            if fresh:
                n_rem = sum(1 for e in data if e.get("remote"))
                n_off = sum(1 for e in data if e.get("unreachable") and not e.get("remote"))
                bits = []
                if n_rem:
                    bits.append(f"Not on the home network: {n_rem} Pi videos play through the desktop "
                                "(slower to start)")
                if n_off:
                    bits.append(f"{n_off} on a share that is not answering")
                self.note = "  ·  ".join(bits)
            if data == self.data and self.rows:
                self.apply_filter()        # the refresh matched the cache: keep the rows (and any preview)
                return False
            self.stop_preview()
            self.data = data
            self.rows = {}
            for child in self.list.get_children():
                child.destroy()
            for e in data:
                self.list.pack_start(self.row(e), False, False, 0)
            self.apply_filter()
            self.win.show_all()
            self.apply_filter()
            return False

