    class Toast:
        """One line under the finger, 1.5 s, and taps pass straight through it."""

        def __init__(self):
            self.win = None
            self.timer = None

        def show(self, title, text, x_local, mon):
            self.hide()
            text = (text or "").strip()
            if text and text.lower().startswith(title.split()[0].lower()):
                line = markup_or_escape(text)
            else:
                line = f"<b>{GLib.markup_escape_text(title)}</b>" + (
                    f"  ·  {markup_or_escape(text)}" if text else "")
            win = layer_window("bar-touch-toast", mon)
            lab = label(line, "bt-body", markup=True, wrap=False)
            box = Gtk.Box()
            box.get_style_context().add_class("bt-pop")
            box.get_style_context().add_class("bt-toast")
            box.pack_start(lab, False, False, 0)
            win.add(box)
            plain = Pango.parse_markup(line, -1, "\x00")[2] if "<" in line else line
            width = min(len(plain) * 9 + 34, 560)   # ~9 px per 14 px mono char
            place_below_bar(win, width, x_local, mon)
            win.show_all()
            import cairo
            win.input_shape_combine_region(cairo.Region())   # never blocks a tap
            self.win = win
            self.timer = GLib.timeout_add(1500, self.hide)

        def hide(self, *_):
            if self.timer:
                GLib.source_remove(self.timer)
                self.timer = None
            if self.win:
                self.win.destroy()
                self.win = None
            return False

    def inputs():
        """[(name, description, is_default)] for real microphones: speaker
        monitors and unplugged ports ("not available", e.g. the jack mic
        with nothing in it) are left out."""
        try:
            sources = json.loads(subprocess.run(["pactl", "-f", "json", "list", "sources"],
                                                capture_output=True, text=True, timeout=3).stdout or "[]")
            default = subprocess.run(["pactl", "get-default-source"], capture_output=True,
                                     text=True, timeout=3).stdout.strip()
        except (subprocess.TimeoutExpired, ValueError, OSError):
            return []
        out = []
        for src in sources:
            if src.get("monitor_source") or src.get("name", "").endswith(".monitor"):
                continue
            port = src.get("active_port")
            avail = [pt.get("availability") for pt in src.get("ports", []) if pt.get("name") == port]
            if avail and avail[0] == "not available":
                continue
            out.append((src.get("name", ""), src.get("description") or src.get("name", ""),
                        src.get("name") == default))
        return out

    class Card:
        WIDTH = 440

        def __init__(self, daemon):
            self.d = daemon
            self.win = None
            self.timer = None
            self.state_lab = None

        def show(self, name, env, x_local, mon):
            self.hide()
            env = with_target_window(name, env)
            self.name, self.env, self.x, self.mon = name, env, x_local, mon
            mod, touch = module_spec(name)
            win = layer_window("bar-touch-card", mon)
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            outer.get_style_context().add_class("bt-pop")
            outer.set_size_request(self.WIDTH, -1)
            head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            head.pack_start(label(title_of(name), "bt-title"), True, True, 0)
            close = Gtk.Button(label="✕")
            close.get_style_context().add_class("bt-btn")
            close.get_style_context().add_class("bt-close")
            close.connect("clicked", lambda *a: self.hide())
            head.pack_end(close, False, False, 0)
            outer.pack_start(head, False, False, 0)
            # The right-click action is a small chip beside ✕, named by what it does: "right-chip"
            # (short), else "right-label". No "Right-click:" prefix; a finger has no right button
            # (2026-11-03, his pick for every popup; it was a full-width "Right-click: …" button).
            for event, text, cmd in module_actions(name):
                if event != "right":
                    continue
                chip = Gtk.Button()
                chip.add(label(touch.get("right-chip") or text, "bt-body", wrap=False))
                for c in ("bt-btn", "bt-chip"):
                    chip.get_style_context().add_class(c)
                chip.set_valign(Gtk.Align.CENTER)
                chip.connect("clicked", self.on_action, event, text, cmd)
                head.pack_end(chip, False, False, 0)
            if touch.get("about"):
                outer.pack_start(label(touch["about"], "bt-body"), False, False, 0)
            # "status-labels" / "click-labels" ({class: text, "default": text}): a
            # headline and the tap button's text follow the module's live class,
            # e.g. voice typing: "● Start recording" / "■ Stop recording and type".
            self.labels = (touch.get("status-labels") or {}, touch.get("click-labels") or {})
            self.headline = None
            if self.labels[0]:
                self.headline = label("", "bt-headline", wrap=True)
                outer.pack_start(self.headline, False, False, 2)
            self.state_lab = label("Reading state…", "bt-state", wrap=True)
            self.big_state = bool(touch.get("big-state"))
            outer.pack_start(self.state_lab, False, False, 4)
            self.click_lab = None
            popup = self.d.popups.get(touch.get("popup"))
            if popup:
                btn = Gtk.Button()
                # "popup-label" names what the tap opens (default: "Open the … controls").
                btn.add(label(f"Tap:  {touch.get('popup-label') or f'Open the {title_of(name)} controls'}",
                              "bt-body", wrap=True))
                btn.get_style_context().add_class("bt-btn")
                btn.connect("clicked", lambda *_: (self.hide(),
                                                   self.d.open_popup(popup, self.env, self.x, self.mon)))
                outer.pack_start(btn, False, False, 0)
            for event, text, cmd in module_actions(name):
                if event == "right":
                    continue                          # the title-row chip above
                prefix = {"click": "Tap", "middle": "Middle-click",
                          "scroll-up": "Scroll ↑", "scroll-down": "Scroll ↓"}[event]
                btn = Gtk.Button()
                if event == "click" and self.labels[1]:
                    self.click_lab = label("Checking…", "bt-primary-label", wrap=True, xalign=0.5)
                    btn.add(self.click_lab)
                    btn.get_style_context().add_class("bt-primary")
                    btn.set_sensitive(False)          # until the live state is known
                    self.click_btn = btn
                else:
                    btn.add(label(f"{prefix}:  {text}", "bt-body", wrap=True))
                btn.get_style_context().add_class("bt-btn")
                btn.connect("clicked", self.on_action, event, text, cmd)
                outer.pack_start(btn, False, False, 0)
            # "actions": [{"label": text, "cmd": command}] -> one button each (2026-11-01, the VDI
            # moon: every action of the fullscreen VDI bar must also be a finger away from the icon;
            # five mouse events are not enough). Runs like the other actions.
            # "state-cmd" (2026-11-03, voice typing "Source:" button): prints {"label": text,
            # "active": bool} (or one plain line). The button shows that text, highlighted
            # (.bt-on) while active; a tap runs "cmd" and re-reads it in place, the card stays
            # open, so the button itself is the indicator (no toast, no notification).
            self.state_btns = []
            self.state_seq, self.state_busy, self.pulsing = {}, set(), set()
            for i, a in enumerate(x for x in (touch.get("actions") or []) if isinstance(x, dict) and x.get("cmd")):
                btn = Gtk.Button()
                lab = label(a.get("label") or ("Checking…" if a.get("state-cmd") else a["cmd"]),
                            "bt-body", wrap=True)
                btn.add(lab)
                btn.get_style_context().add_class("bt-btn")
                if a.get("state-cmd"):
                    self.state_btns.append((btn, lab, a["state-cmd"]))
                    btn.connect("clicked", self.on_state_action, a["cmd"], btn, lab, a["state-cmd"])
                else:
                    btn.connect("clicked", self.on_action, f"action-{i}", a.get("label") or a["cmd"], a["cmd"])
                outer.pack_start(btn, False, False, 0)
            # "links": [{"label": text, "url": url}] -> one button each; it hides the
            # card and opens the URL with xdg-open (voice typing: the labels web app).
            links = [l for l in (touch.get("links") or []) if isinstance(l, dict) and l.get("url")]
            for link in links:
                btn = Gtk.Button()
                btn.add(label(f"↗  {link.get('label') or link['url']}", "bt-body", wrap=True))
                btn.get_style_context().add_class("bt-btn")
                btn.connect("clicked", self.on_link, link["url"])
                outer.pack_start(btn, False, False, 0)
            # "mic-picker": true -> a Microphone list; tapping one makes it the
            # default source (voice typing records from the default, 2026-09-30).
            self.mic_box = None
            if touch.get("mic-picker"):
                outer.pack_start(label("Microphone (tap to make it the default)", "bt-dim"), False, False, 4)
                self.mic_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                outer.pack_start(self.mic_box, False, False, 0)
                self.fill_mics()
            if not module_actions(name) and not popup and not links and not self.mic_box and not touch.get("actions"):
                outer.pack_start(label("Display only: this module has no actions.", "bt-dim"), False, False, 0)
            win.add(outer)
            place_below_bar(win, self.WIDTH + 30, x_local, mon)
            win.show_all()
            self.win = win
            self.bump()
            self.refresh()
            for btn, lab, state_cmd in self.state_btns:
                self.fill_state_btn(btn, lab, state_cmd)

        def refresh(self):
            name, env, win = self.name, self.env, self.win

            def work():
                _, full = module_state(name, env)
                full = "\n".join(l for l in full.splitlines() if not l.startswith("_ts:"))
                GLib.idle_add(self.set_state, win, full or "No state reported.")
                if any(self.labels):
                    cls = module_class(name, env)
                    GLib.idle_add(self.set_class, win, cls)
            threading.Thread(target=work, daemon=True).start()

        def set_class(self, win, cls):
            if win is not self.win:
                return False
            status, click = self.labels
            if self.headline is not None:
                self.headline.set_text(status.get(cls, status.get("default", "")))
            if self.click_lab is not None:
                self.click_lab.set_text(click.get(cls, click.get("default", "Tap action")))
                self.click_btn.set_sensitive(True)
            return False

        def set_state(self, win, text):
            if win is self.win and self.state_lab:
                text = markup_or_escape(text)
                if self.big_state:
                    text = f"<span size='x-large'>{text}</span>"
                self.state_lab.set_markup(text)
            return False

        def on_action(self, _btn, event, text, cmd):
            if event.startswith("scroll"):
                run_detached(cmd, self.env)          # stay open: scroll is repeatable
                GLib.timeout_add(350, lambda: (self.refresh(), False)[1])
                self.bump()
                return
            name, env, x, mon = self.name, self.env, self.x, self.mon
            self.hide()
            self.d.act_and_report(name, env, x, mon, cmd=cmd, label_text=text)

        def fill_mics(self):
            for child in self.mic_box.get_children():
                child.destroy()
            mics = inputs()
            if not mics:
                self.mic_box.pack_start(label("No microphones found.", "bt-dim"), False, False, 0)
            for name, desc, is_default in mics:
                b = Gtk.Button()
                esc = GLib.markup_escape_text(desc)
                b.add(label(f"● <b>{esc}</b>" if is_default else f"○ {esc}", "bt-body", markup=True))
                b.get_style_context().add_class("bt-btn")
                b.connect("clicked", self.on_mic, name)
                self.mic_box.pack_start(b, False, False, 0)
            self.mic_box.show_all()

        def fill_state_btn(self, btn, lab, state_cmd, from_pulse=False):
            win, env = self.win, self.env
            if from_pulse and btn in self.state_busy:
                return                                # the last read is still running
            self.state_busy.add(btn)
            seq = self.state_seq[btn] = self.state_seq.get(btn, 0) + 1

            def work():
                try:
                    out = subprocess.run(["sh", "-c", state_cmd], env=env, capture_output=True,
                                         text=True, timeout=5, stdin=subprocess.DEVNULL).stdout.strip()
                except (subprocess.TimeoutExpired, OSError):
                    out = ""
                try:
                    d = json.loads(out)
                    text, active = str(d.get("label") or ""), bool(d.get("active"))
                    loading = bool(d.get("loading"))
                except (ValueError, AttributeError):
                    text, active, loading = (out.splitlines() or [""])[0], False, False
                GLib.idle_add(self.set_state_btn, win, btn, lab, text, active, loading, state_cmd, seq)
            threading.Thread(target=work, daemon=True).start()

        def set_state_btn(self, win, btn, lab, text, active, loading=False, state_cmd=None, seq=None):
            if seq is not None and seq == self.state_seq.get(btn):
                self.state_busy.discard(btn)
            if win is not self.win or (seq is not None and seq != self.state_seq.get(btn)):
                return False                          # card closed, or a newer read is on its way
            if text:
                lab.set_text(text)
            ctx = btn.get_style_context()
            (ctx.add_class if active else ctx.remove_class)("bt-on")
            btn.set_sensitive(True)
            # "loading": true (2026-11-03, voice typing: local models loading, or Deepgram not
            # reached yet) -> the button pulses until a re-read says ready. Cheap on purpose: one
            # class flip per 0.8 s (no CSS animation), a re-read every 1.6 s, only while the card
            # is open.
            if loading:
                ctx.add_class("bt-loading")
                if btn not in self.pulsing and state_cmd:
                    self.pulsing.add(btn)
                    tick = [0]

                    def pulse():
                        c = btn.get_style_context()
                        if win is not self.win or not c.has_class("bt-loading"):
                            self.pulsing.discard(btn)
                            c.remove_class("bt-pulse")
                            return False
                        (c.remove_class if c.has_class("bt-pulse") else c.add_class)("bt-pulse")
                        tick[0] += 1
                        if tick[0] % 2 == 0:
                            self.fill_state_btn(btn, lab, state_cmd, from_pulse=True)
                        return True
                    GLib.timeout_add(800, pulse)
            else:
                ctx.remove_class("bt-loading")
                ctx.remove_class("bt-pulse")
            return False

        def on_state_action(self, _btn, cmd, btn, lab, state_cmd):
            env = self.env
            btn.set_sensitive(False)
            log(f"state action: {cmd}")

            def work():
                try:
                    subprocess.run(["sh", "-c", cmd], env=env, timeout=10, stdin=subprocess.DEVNULL,
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                except (subprocess.TimeoutExpired, OSError) as e:
                    log(f"state action failed: {e}")
                GLib.idle_add(lambda: (self.fill_state_btn(btn, lab, state_cmd), self.refresh(), False)[-1])
            threading.Thread(target=work, daemon=True).start()
            self.bump()

        def on_mic(self, _btn, name):
            subprocess.run(["pactl", "set-default-source", name], timeout=3)
            log(f"default mic -> {name}")
            self.fill_mics()
            self.bump()

        def on_link(self, _btn, url):
            env = self.env
            self.hide()
            subprocess.Popen(["setsid", "-f", "xdg-open", url], env=env, stdin=subprocess.DEVNULL,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

        def bump(self):
            if self.timer:
                GLib.source_remove(self.timer)
            self.timer = GLib.timeout_add_seconds(20, self.hide)

        def hide(self, *_):
            if self.timer:
                GLib.source_remove(self.timer)
                self.timer = None
            if self.win:
                self.win.destroy()
                self.win = None
            self.state_lab = None
            return False

    class VolumePopup:
        """Touch volume control: a big slider, mute / -5 / +5, and the output
        devices (tap one to make it the default). Replaces the wiremix TUI."""
        WIDTH = 420

        def __init__(self):
            self.win = None
            self.timer = None
            self.pending = None
            self.env = dict(os.environ)

        @staticmethod
        def read():
            def q(*args):
                return subprocess.run(["pamixer", *args], capture_output=True, text=True).stdout.strip()
            try:
                vol = int(q("--get-volume") or 0)
            except ValueError:
                vol = 0
            sink = subprocess.run(["sh", "-c", "pactl get-default-sink 2>/dev/null; "
                                   "pactl list sinks 2>/dev/null | awk -v s=\"$(pactl get-default-sink)\" "
                                   "'$1==\"Name:\"{n=$2} $1==\"Description:\" && n==s{sub(/^[ \\t]*Description: /,\"\"); print; exit}'"],
                                  capture_output=True, text=True).stdout.strip().splitlines()
            return vol, q("--get-mute") == "true", (sink[-1] if sink else "")

        # Bluetooth codec order on the button row, best last (2026-10-25: the FiiO
        # BR13 came up on SBC after a re-pair; "most devices show AAC").
        CODEC_ORDER = ["SBC", "SBC-XQ", "AAC", "aptX", "aptX-LL", "aptX HD", "LDAC"]

        @staticmethod
        def bt_cards():
            """{address_with_underscores: {"card", "active", "codec", "codecs": [(profile, label)]}}
            for every connected Bluetooth audio card. The codec is negotiated per
            audio stream (A2DP) on top of the link, so changing it is a PipeWire card
            profile, not a Bluetooth reconnect."""
            try:
                cards = json.loads(subprocess.run(["pactl", "-f", "json", "list", "cards"],
                                                  capture_output=True, text=True, timeout=3).stdout or "[]")
            except (subprocess.TimeoutExpired, ValueError, OSError):
                return {}
            out = {}
            for c in cards:
                name = c.get("name", "")
                if not name.startswith("bluez_card."):
                    continue
                active = c.get("active_profile", "")
                codecs, codec = [], None
                for prof, info in (c.get("profiles") or {}).items():
                    m = re.search(r"A2DP Sink, codec ([^)]+)\)", info.get("description", ""))
                    if not m or not info.get("available", True):
                        continue
                    codecs.append((prof, m.group(1)))
                    if prof == active:
                        codec = m.group(1)
                if codec is None and active.startswith("headset"):
                    codec = "headset (mic)"
                order = {k: i for i, k in enumerate(VolumePopup.CODEC_ORDER)}
                codecs.sort(key=lambda pc: order.get(pc[1], len(order)))
                out[name[len("bluez_card."):]] = {"card": name, "active": active,
                                                  "codec": codec, "codecs": codecs}
            return out

        @staticmethod
        def outputs():
            """[(name, description, is_default, bt)] for plugged-in outputs; unplugged
            HDMI ports ("not available") are left out. bt is the bt_cards() entry for
            a Bluetooth sink (its codec and the codecs it can switch to), else None."""
            try:
                sinks = json.loads(subprocess.run(["pactl", "-f", "json", "list", "sinks"],
                                                  capture_output=True, text=True, timeout=3).stdout or "[]")
                default = subprocess.run(["pactl", "get-default-sink"], capture_output=True,
                                         text=True, timeout=3).stdout.strip()
            except (subprocess.TimeoutExpired, ValueError, OSError):
                return []
            cards = VolumePopup.bt_cards() if any(sk.get("name", "").startswith("bluez_") for sk in sinks) else {}
            out = []
            for sk in sinks:
                port = sk.get("active_port")
                avail = [pt.get("availability") for pt in sk.get("ports", []) if pt.get("name") == port]
                if avail and avail[0] == "not available":
                    continue
                name = sk.get("name", "")
                bt = None
                if name.startswith("bluez_output."):
                    bt = cards.get(name[len("bluez_output."):].rsplit(".", 1)[0])
                out.append((name, sk.get("description") or name, name == default, bt))
            return out

        def show(self, env, x_local, mon):
            self.hide()
            self.env, self.x, self.mon = env or self.env, x_local, mon
            vol, muted, sink = self.read()
            win = layer_window("bar-touch-volume", mon)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            box.get_style_context().add_class("bt-pop")
            box.set_size_request(self.WIDTH, -1)
            head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            head.pack_start(label("Volume", "bt-title"), True, True, 0)
            self.value = label("", "bt-vol-value", wrap=False, xalign=1.0)
            head.pack_start(self.value, False, False, 0)
            close = Gtk.Button(label="\u2715")
            close.get_style_context().add_class("bt-btn")
            close.get_style_context().add_class("bt-close")
            close.connect("clicked", lambda *a: self.hide())
            head.pack_end(close, False, False, 0)
            box.pack_start(head, False, False, 0)
            if sink:
                box.pack_start(label(sink, "bt-dim"), False, False, 0)
            self.scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
            self.scale.set_draw_value(False)
            self.scale.set_value(vol)
            self.scale.get_style_context().add_class("bt-vol")
            self.scale.set_size_request(-1, 56)
            self.scale.connect("value-changed", self.on_slide)
            box.pack_start(self.scale, False, False, 6)
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.set_homogeneous(True)
            self.mute_btn = Gtk.Button()
            for widget, cb in ((self.mute_btn, self.on_mute),
                               (Gtk.Button(label="\u2212 5"), lambda *a: self.nudge(-5)),
                               (Gtk.Button(label="+ 5"), lambda *a: self.nudge(5))):
                widget.get_style_context().add_class("bt-btn")
                widget.connect("clicked", cb)
                row.pack_start(widget, True, True, 0)
            box.pack_start(row, False, False, 0)
            outs = self.outputs()
            if len(outs) > 1:
                box.pack_start(label("Output", "bt-dim"), False, False, 4)
                for name, desc, is_default, bt in outs:
                    b = Gtk.Button()
                    esc = GLib.markup_escape_text(desc)
                    codec = f" · {GLib.markup_escape_text(bt['codec'])}" if bt and bt.get("codec") else ""
                    b.add(label(f"● <b>{esc}</b>{codec}" if is_default else f"○ {esc}{codec}",
                                "bt-body", markup=True))
                    b.get_style_context().add_class("bt-btn")
                    b.connect("clicked", self.on_output, name)
                    box.pack_start(b, False, False, 0)
                    if is_default and bt and len(bt["codecs"]) > 1:
                        self.codec_rows(box, bt)
            win.add(box)
            place_below_bar(win, self.WIDTH + 30, x_local, mon)
            win.show_all()
            self.win = win
            self.render(vol, muted)
            self.bump()

        def render(self, vol, muted):
            if not self.win:
                return
            self.value.set_text("muted" if muted else f"{vol}%")
            self.mute_btn.set_label("Unmute" if muted else "Mute")

        def on_slide(self, scale):
            self.bump()
            if self.pending:
                GLib.source_remove(self.pending)
            self.pending = GLib.timeout_add(60, self.apply, int(scale.get_value()))
            self.value.set_text(f"{int(scale.get_value())}%")

        def apply(self, vol):
            self.pending = None
            subprocess.run(["pamixer", "--unmute", "--set-volume", str(vol)])
            self.render(vol, False)
            return False

        def nudge(self, delta):
            self.bump()
            vol = max(0, min(100, int(self.scale.get_value()) + delta))
            self.scale.set_value(vol)          # triggers on_slide -> apply

        def on_mute(self, *_):
            self.bump()
            subprocess.run(["pamixer", "-t"])
            vol, muted, _ = self.read()
            self.render(vol, muted)

        def on_output(self, _btn, name):
            subprocess.run(["pactl", "set-default-sink", name])
            self.show(self.env, self.x, self.mon)     # redraw: new default, its volume

        def codec_rows(self, box, bt):
            """Codec buttons under the selected Bluetooth output, four to a row, the
            active one marked. A tap sets the card profile; the stream reopens with
            the new codec in about a second and the panel redraws."""
            box.pack_start(label("Codec", "bt-dim"), False, False, 2)
            codecs = bt["codecs"]
            for i in range(0, len(codecs), 4):
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
                row.set_homogeneous(True)
                for prof, name in codecs[i:i + 4]:
                    active = prof == bt["active"]
                    b = Gtk.Button()
                    esc = GLib.markup_escape_text(name)
                    b.add(label(f"● <b>{esc}</b>" if active else esc, "bt-body", markup=True, xalign=0.5))
                    b.get_style_context().add_class("bt-btn")
                    b.connect("clicked", self.on_codec, bt["card"], prof, name)
                    row.pack_start(b, True, True, 0)
                box.pack_start(row, False, False, 0)

        def on_codec(self, _btn, card, profile, name):
            self.bump()
            self.value.set_text(f"→ {name}…")
            subprocess.run(["pactl", "set-card-profile", card, profile], timeout=5)
            log(f"volume: {card} codec -> {profile} ({name})")
            # WirePlumber remembers the profile per card (default-profile), so the
            # choice survives reconnects. The sink vanishes while the stream reopens
            # (LDAC took ~3 s on the BR13), so redraw when it is back, or at 6 s.
            addr = card[len("bluez_card."):]
            deadline = time.time() + 6

            def back():
                try:
                    names = subprocess.run(["pactl", "-f", "json", "list", "short", "sinks"],
                                           capture_output=True, text=True, timeout=2).stdout
                except (subprocess.TimeoutExpired, OSError):
                    names = ""
                if f"bluez_output.{addr}." not in names and time.time() < deadline:
                    return True                          # keep polling
                self.show(self.env, self.x, self.mon)
                return False
            GLib.timeout_add(500, back)

        def bump(self):
            if self.timer:
                GLib.source_remove(self.timer)
            self.timer = GLib.timeout_add_seconds(8, self.hide)

        def hide(self, *_):
            for attr in ("timer", "pending"):
                if getattr(self, attr):
                    GLib.source_remove(getattr(self, attr))
                    setattr(self, attr, None)
            if self.win:
                self.win.destroy()
                self.win = None
            return False

    ANSI = __import__("re").compile(r"\x1b\[[0-9;]*m")

    def sh_out(cmd, timeout=12):
        try:
            return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
        except (subprocess.TimeoutExpired, OSError):
            return ""

    class ListPopup:
        """A popup under the bar: header row, a scrollable list of big buttons
        filled from a worker thread, and a footer row. Subclasses implement
        load() (worker thread, returns data) and rows(data) (main thread)."""
        WIDTH = 440
        TITLE = ""

        def __init__(self):
            self.win = None
            self.timer = None
            self.env = dict(os.environ)
            self.gen = 0

        def show(self, env, x_local, mon):
            self.hide()
            self.env, self.x, self.mon = env or self.env, x_local, mon
            win = layer_window("bar-touch-" + self.TITLE.lower().replace(" ", "-"), mon)
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            outer.get_style_context().add_class("bt-pop")
            outer.set_size_request(self.WIDTH, -1)
            head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            head.pack_start(label(self.TITLE, "bt-title", wrap=False), True, True, 0)
            self.head_extra = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            head.pack_start(self.head_extra, False, False, 0)
            close = Gtk.Button(label="✕")
            close.get_style_context().add_class("bt-btn")
            close.get_style_context().add_class("bt-close")
            close.connect("clicked", lambda *a: self.hide())
            head.pack_end(close, False, False, 0)
            outer.pack_start(head, False, False, 0)
            self.status = label("Reading…", "bt-dim")
            outer.pack_start(self.status, False, False, 0)
            self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
            scroller = Gtk.ScrolledWindow()
            scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            scroller.set_propagate_natural_height(True)
            scroller.set_max_content_height(430)
            scroller.add(self.list)
            self.scroller = scroller
            outer.pack_start(scroller, True, True, 0)
            foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            foot.set_homogeneous(True)
            for text, cb in self.footer():
                b = Gtk.Button(label=text)
                b.get_style_context().add_class("bt-btn")
                b.connect("clicked", cb)
                foot.pack_start(b, True, True, 0)
            outer.pack_start(foot, False, False, 0)
            win.add(outer)
            place_below_bar(win, self.WIDTH + 30, x_local, mon)
            win.show_all()
            self.win = win
            self.bump()
            self.reload()

        def reload(self, note=None):
            self.gen += 1
            gen = self.gen
            if note and self.win:
                self.status.set_text(note)

            def work():
                data = self.load()
                GLib.idle_add(self.fill, gen, data)
            threading.Thread(target=work, daemon=True).start()

        def fill(self, gen, data):
            if gen != self.gen or not self.win:
                return False
            for child in self.list.get_children():
                child.destroy()
            for child in self.head_extra.get_children():
                child.destroy()
            status = self.rows(data)
            self.status.set_text(status or "")
            # Natural-height propagation is not re-run after the rows arrive, so
            # size the list explicitly: up to ~8 rows, then it scrolls.
            n = len(self.list.get_children())
            self.scroller.set_min_content_height(min(n * 58, 430))
            self.win.show_all()
            return False

        def row_button(self, text, cb, *args, dim=False):
            b = Gtk.Button()
            lab = label(text, "bt-body", markup=True)
            b.add(lab)
            b.get_style_context().add_class("bt-btn")
            if dim:
                b.set_opacity(0.6)
            b.connect("clicked", lambda *_: (self.bump(), cb(*args)))
            self.list.pack_start(b, False, False, 0)
            return b

        def head_button(self, text, cb):
            b = Gtk.Button(label=text)
            b.get_style_context().add_class("bt-btn")
            b.connect("clicked", lambda *_: (self.bump(), cb()))
            self.head_extra.pack_start(b, False, False, 0)

        def run_then_reload(self, cmd, note):
            """Run a (possibly slow) command off the main thread, then refresh."""
            self.reload_note = note
            if self.win:
                self.status.set_text(note)

            def work():
                sh_out(cmd, timeout=25)
                GLib.idle_add(lambda: (self.reload(), False)[1])
            threading.Thread(target=work, daemon=True).start()

        def set_status(self, text):
            """Main thread only (GLib.idle_add from workers)."""
            if self.win:
                self.status.set_text(text)
                self.bump()
            return False

        def bump(self):
            if self.timer:
                GLib.source_remove(self.timer)
            self.timer = GLib.timeout_add_seconds(20, self.hide)

        def hide(self, *_):
            if self.timer:
                GLib.source_remove(self.timer)
                self.timer = None
            if self.win:
                self.win.destroy()
                self.win = None
            return False

    def bars(n):
        n = max(0, min(4, n))
        return "▂▄▆█"[:n] + "<span alpha='30%'>" + "▂▄▆█"[n:] + "</span>"

    class WifiPopup(ListPopup):
        TITLE = "Wi-Fi"

        def __init__(self):
            super().__init__()
            self.dev = None

        def footer(self):
            return [("Rescan", lambda *_: self.run_then_reload(
                        ["sh", "-c", f"iwctl station {self.dev or 'wlan0'} scan; sleep 3"], "Scanning…"))]

        def load(self):
            devs = []
            for line in ANSI.sub("", sh_out(["iwctl", "station", "list"])).splitlines():
                parts = line.split()
                if len(parts) >= 2 and parts[0].startswith("wl"):
                    devs.append((parts[0], parts[1]))
            route = sh_out(["ip", "route", "show", "default"])
            internet = next((d for d, _ in devs if f"dev {d} " in route), None)
            dev = self.dev if self.dev in [d for d, _ in devs] else (internet or (devs[0][0] if devs else None))
            nets = []
            if dev:
                raw = sh_out(["iwctl", "station", dev, "get-networks"])
                for line in raw.splitlines():
                    connected = "> " in ANSI.sub("", line)[:8]
                    clean = ANSI.sub("", line).replace(">", " ", 1) if connected else ANSI.sub("", line)
                    m = __import__("re").match(r"^\s+(.+?)\s{2,}(psk|open|8021x|wep)\s+(\*+)\s*$", clean)
                    if not m:
                        continue
                    sig = line.split(m.group(2))[-1]
                    filled = sig.split("\x1b")[0].count("*")
                    nets.append({"ssid": m.group(1).strip(), "sec": m.group(2), "bars": filled, "on": connected})
            known = set()
            kraw = ANSI.sub("", sh_out(["iwctl", "known-networks", "list"]))
            for line in kraw.splitlines():
                m = __import__("re").match(r"^\s{2}(.+?)\s{2,}(psk|open|8021x|wep)\s", line)
                if m:
                    known.add(m.group(1).strip())
            return {"devs": devs, "dev": dev, "internet": internet, "nets": nets, "known": known}

        def rows(self, d):
            self.dev = d["dev"]
            for dev, state in d["devs"]:
                tag = " (internet)" if dev == d["internet"] else ""
                mark = "● " if dev == d["dev"] else ""
                self.head_button(f"{mark}{dev}{tag}", lambda dv=dev: (setattr(self, "dev", dv), self.reload("Reading…")))
            if not d["dev"]:
                return "No Wi-Fi device found."
            for n in d["nets"]:
                esc = GLib.markup_escape_text(n["ssid"])
                lock = "" if n["sec"] == "open" else " \U000f033e"
                saved = " · saved" if n["ssid"] in d["known"] else ""
                state = "  <b>connected</b>" if n["on"] else ""
                text = f"{bars(n['bars'])}  <b>{esc}</b>{lock}{saved}{state}"
                self.row_button(text, self.pick, n, d["known"])
            on = next((n["ssid"] for n in d["nets"] if n["on"]), None)
            return (f"{d['dev']}: connected to {on}" if on else f"{d['dev']}: not connected")

        def pick(self, n, known):
            if n["on"]:
                self.status.set_text(f"Already connected to {n['ssid']}")
                return
            if n["sec"] == "8021x" and n["ssid"] not in known:
                self.status.set_text(f"{n['ssid']} is an enterprise (802.1X) network: it needs an iwd config file.")
                return
            if n["sec"] != "open" and n["ssid"] not in known:
                self.ask_password(n)
                return
            self.connect(n["ssid"])

        def ask_password(self, n):
            """Replace the list with a password field (the popup takes the keyboard
            only while it is open)."""
            for child in self.list.get_children():
                child.destroy()
            GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.ON_DEMAND)
            self.list.pack_start(label(f"Password for <b>{GLib.markup_escape_text(n['ssid'])}</b>",
                                       "bt-body", markup=True), False, False, 6)
            entry = Gtk.Entry()
            entry.set_visibility(False)
            entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
            entry.get_style_context().add_class("bt-entry")
            entry.connect("changed", lambda *_: self.bump())
            entry.connect("activate", lambda *_: self.submit(n["ssid"], entry))
            self.list.pack_start(entry, False, False, 0)
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.set_homogeneous(True)
            show = Gtk.Button(label="Show")
            show.connect("clicked", lambda b: (entry.set_visibility(not entry.get_visibility()),
                                               b.set_label("Hide" if entry.get_visibility() else "Show"),
                                               self.bump()))
            for b, cb in ((show, None),
                          (Gtk.Button(label="Cancel"), lambda *_: self.reload("Reading…")),
                          (Gtk.Button(label="Connect"), lambda *_: self.submit(n["ssid"], entry))):
                b.get_style_context().add_class("bt-btn")
                if cb:
                    b.connect("clicked", cb)
                row.pack_start(b, True, True, 0)
            self.list.pack_start(row, False, False, 0)
            self.scroller.set_min_content_height(170)
            self.status.set_text("Type the password, then Connect (or Enter).")
            self.win.show_all()
            entry.grab_focus()
            self.bump()

        def submit(self, ssid, entry):
            pw = entry.get_text()
            if len(pw) < 8:
                self.status.set_text("Wi-Fi passwords are at least 8 characters.")
                return
            GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.NONE)
            self.connect(ssid, pw)

        def connect(self, ssid, password=None):
            """iwctl connect off the main thread; report failure instead of a silent reload.
            The passphrase goes in argv (visible to this user's processes for a moment)."""
            dev = self.dev
            self.status.set_text(f"Connecting {dev} to {ssid}…")
            cmd = ["iwctl"] + (["--passphrase", password] if password else []) + ["station", dev, "connect", ssid]

            def work():
                try:
                    r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
                    ok, msg = r.returncode == 0, ANSI.sub("", (r.stdout + r.stderr)).strip()
                except (subprocess.TimeoutExpired, OSError) as exc:
                    ok, msg = False, str(exc)
                log(f"wifi connect {dev} {ssid}: {'ok' if ok else 'failed: ' + msg}")
                note = None if ok else f"Could not connect to {ssid}: {msg or 'failed'}"
                GLib.idle_add(lambda: (self.reload(note) if note is None else self.fail(note), False)[1])
            threading.Thread(target=work, daemon=True).start()

        def fail(self, note):
            def after():
                self.set_status(note)
                return False
            self.reload()
            GLib.timeout_add(2500, after)      # after the list refills

    BT_ICONS = {"audio-headset": "\U000f02ce", "audio-headphones": "\U000f02cb", "audio-card": "\U000f04c3",
                "input-keyboard": "\U000f030c", "input-mouse": "\U000f037d", "input-gaming": "\U000f0297",
                "phone": "\U000f03f2", "computer": "\U000f0322"}

    class BluetoothPopup(ListPopup):
        TITLE = "Bluetooth"

        def __init__(self):
            super().__init__()
            self.scanned = False
            self.pairing = False

        def footer(self):
            return [("Scan for new devices", lambda *_: self.scan())]

        def scan(self):
            if self.pairing:
                return
            self.scanned = True
            self.run_then_reload(["bluetoothctl", "--timeout", "10", "scan", "on"],
                                 "Scanning for 10 s… put the device in pairing mode.")

        def load(self):
            powered = "Powered: yes" in sh_out(["bluetoothctl", "show"])
            devs, seen = [], set()
            for line in sh_out(["bluetoothctl", "devices", "Paired"]).splitlines():
                parts = line.split(" ", 2)
                if len(parts) < 3 or parts[1] in seen:
                    continue
                seen.add(parts[1])
                info = sh_out(["bluetoothctl", "info", parts[1]], timeout=4)
                icon = next((l.split(":", 1)[1].strip() for l in info.splitlines() if l.strip().startswith("Icon:")), "")
                devs.append({"mac": parts[1], "name": parts[2], "icon": icon,
                             "on": "Connected: yes" in info})
            devs.sort(key=lambda d: (not d["on"], d["name"].lower()))
            new = []
            if self.scanned and powered:
                for line in sh_out(["bluetoothctl", "devices"]).splitlines():
                    parts = line.split(" ", 2)
                    if len(parts) < 3 or parts[1] in seen:
                        continue
                    # Unnamed devices show their address with dashes as the name.
                    if parts[2].replace("-", ":") == parts[1]:
                        continue
                    info = sh_out(["bluetoothctl", "info", parts[1]], timeout=4)
                    if "RSSI:" not in info:        # not heard in this scan: out of range
                        continue
                    icon = next((l.split(":", 1)[1].strip() for l in info.splitlines()
                                 if l.strip().startswith("Icon:")), "")
                    new.append({"mac": parts[1], "name": parts[2], "icon": icon})
                new.sort(key=lambda d: d["name"].lower())
            return {"powered": powered, "devs": devs, "new": new}

        def rows(self, d):
            self.head_button("Turn off" if d["powered"] else "Turn on",
                             lambda: self.run_then_reload(["bluetoothctl", "power", "off" if d["powered"] else "on"],
                                                          "Switching Bluetooth…"))
            if not d["powered"]:
                return "Bluetooth is off."
            for dev in d["devs"]:
                glyph = BT_ICONS.get(dev["icon"], "\U000f00af")
                esc = GLib.markup_escape_text(dev["name"])
                state = "  <b>connected</b>" if dev["on"] else ""
                self.row_button(f"{glyph}  <b>{esc}</b>{state}", self.toggle, dev, dim=not dev["on"])
            if d["new"]:
                self.list.pack_start(label("New devices (tap to pair)", "bt-dim"), False, False, 6)
                for dev in d["new"]:
                    glyph = BT_ICONS.get(dev["icon"], "\U000f00af")
                    esc = GLib.markup_escape_text(dev["name"])
                    self.row_button(f"{glyph}  {esc}", self.pair, dev)
            elif self.scanned:
                self.list.pack_start(label("No new devices found. Is it in pairing mode?", "bt-dim"),
                                     False, False, 6)
            n = sum(1 for dev in d["devs"] if dev["on"])
            return f"{n} connected"

        def pair(self, dev):
            """Pair the way bt-connect-pair does (proven on BLE keyboards that reject a
            host "pair"): own agent, CONNECT so the device starts security itself,
            answer yes, show any passkey, trust once paired. Falls back to "pair"."""
            if self.pairing:
                return
            self.pairing = True
            mac, name = dev["mac"], dev["name"]
            self.status.set_text(f"Pairing {name}…")

            def work():
                import re
                p = subprocess.Popen(["bluetoothctl"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, text=True, bufsize=0)
                buf = []

                def reader():
                    while True:
                        c = p.stdout.read(1)
                        if not c:
                            break
                        buf.append(c)
                threading.Thread(target=reader, daemon=True).start()

                def send(c):
                    try:
                        p.stdin.write(c + "\n"); p.stdin.flush()
                    except OSError:
                        pass
                for c in ("agent KeyboardDisplay", "default-agent", "pairable on", "scan on", f"connect {mac}"):
                    send(c); time.sleep(0.3)
                t0, pos, tried_pair, trusted, result = time.time(), 0, False, False, None
                while time.time() - t0 < 45 and result is None:
                    time.sleep(0.2)
                    text = ANSI.sub("", "".join(buf)).replace("\r", "\n")
                    new, pos = text[pos:], len(text)
                    if "(yes/no)" in new:
                        send("yes")
                    m = re.search(r"Passkey: (\d{6})", new)
                    if m:
                        GLib.idle_add(self.set_status, f"On {name}: type {m.group(1)}, then Enter")
                    if not trusted and ("Paired: yes" in new or "Pairing successful" in new):
                        send(f"trust {mac}"); trusted = True
                    if "Connection successful" in new or "Connected: yes" in new:
                        result = "ok"
                    elif ("Failed to connect" in new or "Failed to pair" in new) and not tried_pair:
                        tried_pair = True
                        GLib.idle_add(self.set_status, f"Pairing {name} (second try)…")
                        send(f"pair {mac}"); time.sleep(4); send(f"connect {mac}")
                info = sh_out(["bluetoothctl", "info", mac], timeout=4)
                if "Paired: yes" in info and not trusted:
                    send(f"trust {mac}"); time.sleep(0.5)
                for c in ("scan off", "quit"):
                    send(c)
                try:
                    p.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    p.kill()
                ok = "Connected: yes" in info or result == "ok"
                log(f"bluetooth pair {mac} {name}: {'ok' if ok else 'failed'}")

                def done():
                    self.pairing = False
                    self.reload(f"Paired and connected: {name}" if ok else None)
                    if not ok:
                        GLib.timeout_add(2500, lambda: (self.set_status(
                            f"Could not pair {name}. Put it in pairing mode and tap it again."), False)[1])
                    return False
                GLib.idle_add(done)
            threading.Thread(target=work, daemon=True).start()

        def toggle(self, dev):
            verb = "disconnect" if dev["on"] else "connect"
            self.run_then_reload(["bluetoothctl", verb, dev["mac"]],
                                 f"{'Disconnecting' if dev['on'] else 'Connecting'} {dev['name']}…")

