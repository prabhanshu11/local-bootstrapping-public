    """
    provider = Gtk.CssProvider()
    try:
        provider.load_from_data(css.encode())
    except GLib.Error as exc:
        log(f"css failed, using plain style: {exc}")
        provider.load_from_data(css.replace(theme, "@define-color background #1a1b26;\n@define-color foreground #cdd6f4;\n").encode())
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def markup_or_escape(text):
        try:
            Pango.parse_markup(text, -1, "\0")
            return text
        except GLib.Error:
            return GLib.markup_escape_text(text)

    def label(text, cls, markup=False, wrap=True, xalign=0.0):
        lab = Gtk.Label()
        if markup:
            lab.set_markup(markup_or_escape(text))
        else:
            lab.set_text(text)
        lab.set_xalign(xalign)
        lab.set_line_wrap(wrap)
        lab.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        lab.get_style_context().add_class(cls)
        return lab

    def layer_window(namespace, mon, anchor_all=False, keyboard=False, bottom=False):
        win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
        GtkLayerShell.init_for_window(win)
        GtkLayerShell.set_namespace(win, namespace)
        GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_monitor(win, gdk_monitor_for(mon))
        if bottom:
            # the on-screen keyboard: centred on the bottom edge, and it takes an
            # exclusive zone so the windows above shrink instead of hiding under it
            GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)
            GtkLayerShell.auto_exclusive_zone_enable(win)
        elif anchor_all:
            for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM,
                         GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
                GtkLayerShell.set_anchor(win, edge, True)
            GtkLayerShell.set_exclusive_zone(win, -1)
        else:
            GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.TOP, True)
            GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.LEFT, True)
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE if keyboard
                                        else GtkLayerShell.KeyboardMode.NONE)
        visual = win.get_screen().get_rgba_visual()
        if visual:
            win.set_visual(visual)
        win.get_style_context().add_class("bt-overview" if anchor_all else "bt-win")
        return win

    def place_below_bar(win, width, x_local, mon):
        mon_w = mon["width"] / (mon.get("scale") or 1)
        left = int(min(max(x_local - width / 2, 8), mon_w - width - 8))
        # Margins count from the edge of the bar's exclusive zone, not the screen.
        GtkLayerShell.set_margin(win, GtkLayerShell.Edge.TOP, 6)
        GtkLayerShell.set_margin(win, GtkLayerShell.Edge.LEFT, left)

    # ── module state (runs commands; call from worker threads only) ──
    def module_state(name, env):
        """(short, full) state strings for a module, or ("", "") when unknown."""
        mod, touch = module_spec(name)
        cmd = touch.get("state")
        json_out = bool(cmd and touch.get("state-json"))
        if not cmd and mod.get("exec"):
            cmd, json_out = mod["exec"], mod.get("return-type") == "json"
        if not cmd:
            return "", ""
        try:
            out = subprocess.run(["sh", "-c", cmd], env=env, capture_output=True, text=True, timeout=3).stdout.strip()
        except subprocess.TimeoutExpired:
            return "(no answer)", "(the state command timed out)"
        if json_out:
            try:
                data = json.loads(out.splitlines()[-1] if out else "{}")
            except ValueError:
                data = {"text": out}
            tip = str(data.get("tooltip") or "").strip()
            text = str(data.get("text") or "").strip().replace("​", "")
            lines = [l for l in tip.splitlines() if l.strip()]
            cls = data.get("class", "")
            cls = " ".join(map(str, cls)) if isinstance(cls, list) else str(cls)
            short = lines[0] if lines else (text or cls)
            full = tip or text
            return short, full
        lines = [l for l in out.splitlines() if l.strip()]
        return (lines[0] if lines else ""), out

    def module_class(name, env):
        """The "class" of a JSON custom module's exec output ("" when unknown)."""
        mod, touch = module_spec(name)
        # A module whose exec streams forever (power-profile-daemon watch) names a
        # one-shot JSON command as "state" + "state-json": true instead.
        cmd = touch.get("state") if touch.get("state-json") else mod.get("exec")
        if not cmd or mod.get("return-type") != "json":
            return ""
        try:
            out = subprocess.run(["sh", "-c", cmd], env=env, capture_output=True,
                                 text=True, timeout=3).stdout.strip()
            cls = json.loads(out.splitlines()[-1]).get("class", "") if out else ""
        except (subprocess.TimeoutExpired, ValueError, IndexError, AttributeError):
            return ""
        return (cls[0] if cls else "") if isinstance(cls, list) else str(cls)

    ACTIONS = [  # (event, config key holding the command, default label)
        ("click", None, "Tap action"),
        ("right", "on-click-right", "Right-click action"),
        ("middle", "on-click-middle", "Middle-click action"),
        ("scroll-up", "on-scroll-up", "Scroll up"),
        ("scroll-down", "on-scroll-down", "Scroll down"),
    ]

    def module_actions(name):
        mod, touch = module_spec(name)
        acts = []
        for event, key, default in ACTIONS:
            cmd = touch.get("click") if key is None else mod.get(key)
            if isinstance(cmd, str) and cmd.strip():
                acts.append((event, touch.get(f"{event}-label", default), cmd))
        return acts

    def title_of(name):
        _, touch = module_spec(name)
        return touch.get("title") or name.split("/")[-1].replace("-", " ").title()

