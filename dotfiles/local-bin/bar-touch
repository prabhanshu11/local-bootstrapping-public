        def focus(self, _btn, address):
            self.hide()
            if address:
                hypr(f"dispatch focuswindow address:{address}")

        def close(self, _btn, address, is_active):
            if not address:
                return
            if is_active:
                subprocess.run([os.path.expanduser("~/.local/bin/hypr-close-ordered")], timeout=3)
            else:
                hypr(f"dispatch closewindow address:{address}")
            log(f"overview close {address}")
            # Redraw once the window is gone (a "save changes?" prompt keeps it).
            GLib.timeout_add(250, lambda: (self.win and (self.hide(), self.show()), False)[1])

        def hide(self):
            if self.win:
                self.win.destroy()
                self.win = None

    # ── walker menus (omarchy-menu, the power menu, the launcher) by finger ──
    class WalkerTouch:
        """Make walker's list answer a finger (2026-10-11).

        walker 2.x (src/ui/window.rs) calls list.set_can_target(false) whenever its
        window opens, and only turns the list back on after its EventControllerMotion
        sees the pointer move twice to different spots (so a resting cursor cannot
        hover-select an entry and Enter run it). A touch tap is no pointer motion, so
        it falls through the list to the window: taps on entries do nothing, a tap
        outside the box still closes the menu. Walker has no setting for this.

        Fix: on Hyprland's `openlayer>>walker` event the daemon wiggles its uinput
        mouse 1 px right/left/right/left, which counts as two motions. Where the
        cursor already rests on walker's monitor away from the centred box it stays
        put (no visible change, no entry hover-selected). Otherwise it is first moved
        to the monitor's left edge, but only if the touchscreen was used in the last
        WALKER_TOUCH_RECENT s (the menu was opened by finger); a mouse/keyboard user's
        cursor is never moved. If a finger then lands on a menu that is still not
        primed (opened by keyboard), it is primed at touch-down and that tap, which
        GTK already sent nowhere, is replayed as a mouse click at the same spot,
        only if walker is still open WALKER_REPLAY_DELAY ms after the lift.
        """

        def __init__(self, daemon):
            self.d = daemon
            self.open = False
            self.primed = False
            self.gen = 0
            threading.Thread(target=self.listen, daemon=True, name="walker-events").start()

        def listen(self):
            sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
            path = os.path.join(RUNTIME, "hypr", sig, ".socket2.sock")
            failed = False
            while True:
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.connect(path)
                    if failed:
                        log("walker: hyprland event socket back")
                    failed = False
                    buf = b""
                    while True:
                        chunk = s.recv(65536)
                        if not chunk:
                            break
                        buf += chunk
                        *lines, buf = buf.split(b"\n")
                        for line in lines:
                            if line == b"openlayer>>" + WALKER_NS.encode():
                                GLib.idle_add(self.on_open)
                            elif line == b"closelayer>>" + WALKER_NS.encode():
                                GLib.idle_add(self.on_close)
                    s.close()
                except OSError as exc:
                    if not failed:
                        log(f"walker: hyprland event socket failed: {exc}")
                    failed = True
                time.sleep(2)

        def on_open(self):
            self.open, self.primed = True, False
            self.gen += 1
            # Give walker a moment to map and lay out before the pointer moves.
            GLib.timeout_add(120, self.prime_on_open, self.gen)
            return False

        def on_close(self):
            self.open = self.primed = False
            self.gen += 1
            return False

        def prime_on_open(self, gen):
            if gen == self.gen and self.open and not self.primed:
                recent = time.monotonic() - self.d.last_touch < WALKER_TOUCH_RECENT
                self.prime(allow_move=recent, why="menu opened" + (" by finger" if recent else ""))
            return False

        @staticmethod
        def monitor():
            """The monitor dict walker's layer is on, or None if it is not open."""
            layers = hypr_json("layers") or {}
            for name, info in layers.items():
                for level in (info.get("levels") or {}).values():
                    for surf in level:
                        if surf.get("namespace") == WALKER_NS:
                            for m in hypr_json("monitors") or []:
                                if m.get("name") == name:
                                    return m
            return None

        def prime(self, allow_move, why):
            mon = self.monitor()
            if mon is None:
                return None
            scale = mon.get("scale") or 1
            w, h = mon["width"] / scale, mon["height"] / scale
            if mon.get("transform", 0) % 2:
                w, h = h, w
            pos = hypr_json("cursorpos") or {}
            cx, cy = pos.get("x", -1), pos.get("y", -1)
            on_mon = mon["x"] <= cx < mon["x"] + w and mon["y"] <= cy < mon["y"] + h
            if not (on_mon and abs(cx - (mon["x"] + w / 2)) > WALKER_BOX_HALF):
                if not allow_move:
                    log(f"walker: {why}; cursor over the menu or another monitor, left alone")
                    return None
                hypr(f"dispatch movecursor {int(mon['x'] + 40)} {int(mon['y'] + h / 2)}")
                time.sleep(0.08)
            for dx in (1, -1, 1, -1):
                self.d.ui.write(E.EV_REL, E.REL_X, dx)
                self.d.ui.syn()
                time.sleep(0.03)
            self.primed = True
            log(f"walker: {why}; list primed for touch on {mon.get('name')}")
            return mon

        def touch_down(self, s):
            """A finger landed. If it is on a walker menu nobody primed yet, prime it now
            and mark the touch for replay (touch mode only: mouse mode clicks anyway)."""
            if not self.open or self.primed:
                return
            mon = self.prime(allow_move=True, why="finger on an unprimed menu")
            s.walker_replay = (mon is not None and not self.d.mouse and not s.in_bar
                               and mon.get("name") == s.mon.get("name"))

        def touch_up(self, s):
            if (getattr(s, "walker_replay", False) and s.max_fingers == 1 and not s.consumed
                    and s.moved <= MOVE_TOL and (s.t_up or time.monotonic()) - s.t0 < LONG_PRESS):
                GLib.timeout_add(WALKER_REPLAY_DELAY, self.replay, s.x0, s.y0)

        def replay(self, x, y):
            if self.monitor() is None:
                log("walker: tap already answered (menu closed), no replay")
                return False
            hypr(f"dispatch movecursor {int(x)} {int(y)}")
            time.sleep(0.05)
            self.d.click(E.BTN_LEFT)
            log(f"walker: lost tap replayed as a click at {int(x)},{int(y)}")
            return False

    # ── touch input ──
    class TouchDev:
        def __init__(self, dev):
            self.dev = dev
            self.slot = 0
            self.ids = {}
            self.pos = {}
            ax = dev.absinfo(E.ABS_MT_POSITION_X)
            ay = dev.absinfo(E.ABS_MT_POSITION_Y)
            self.maxx, self.maxy = max(ax.max, 1), max(ay.max, 1)
            self.watch = None
            self.grabbed = False

        def contacts(self):
            return [self.pos[s] for s in sorted(self.ids) if self.ids[s] >= 0 and s in self.pos
                    and None not in self.pos[s]]

    class Session:
        def __init__(self, dev, mon, raw):
            self.dev, self.mon = dev, mon
            self.t0 = time.monotonic()
            self.t_up = None
            self.fingers = self.max_fingers = len(raw)
            self.x0, self.y0, self.lx0, self.ly0 = daemon.map_point(dev, mon, raw[0])
            self.x, self.y, self.lx, self.ly = self.x0, self.y0, self.lx0, self.ly0
            self.moved = 0.0
            self.in_bar = self.ly0 <= daemon.bar_h + 1
            self.consumed = False
            self.dragging = False
            self.bar_held = False
            self.two = None
            self.last_move = 0.0
            self.clicked = False     # waybar reported a module click for this touch
            self.workspace = None    # active workspace id at touch-down (bar taps only)
            self.walker_replay = False  # tap lost on an unprimed walker menu: replay it

    class Daemon:
        def __init__(self):
            self.devs = {}
            self.session = None
            self.last = None
            self.pending = None
            self.mouse = False
            self.bar_h = 26
            self.env = dict(os.environ)
            self.toast, self.overview, self.volume = Toast(), Overview(), VolumePopup()
            self.popups = {"volume": self.volume, "wifi": WifiPopup(), "bluetooth": BluetoothPopup(),
                           "battery": BatteryPopup(), "mpv-history": MpvHistoryPopup(),
                           "keyboard": KeyboardPopup(self)}
            self.card = Card(self)
            self.unanswered = []     # (time, x) of recent bar taps waybar never clicked
            self.waybar_restarted = 0.0
            self.ui = UInput({E.EV_KEY: [E.BTN_LEFT, E.BTN_RIGHT, E.BTN_MIDDLE],
                              E.EV_REL: [E.REL_X, E.REL_Y, E.REL_WHEEL]}, name="bar-touch-mouse")
            self.last_touch = 0.0    # monotonic time of the last finger-down on any touchscreen
            self.walker = WalkerTouch(self)

        # coordinates: raw panel -> global logical and monitor-local logical
        def map_point(self, dev, mon, raw):
            u, v = raw[0] / dev.maxx, raw[1] / dev.maxy
            if mon.get("transform", 0) == 2:
                u, v = 1 - u, 1 - v
            scale = mon.get("scale") or 1
            lx, ly = u * mon["width"] / scale, v * mon["height"] / scale
            return mon["x"] + lx, mon["y"] + ly, lx, ly

        # ── devices ──
        def scan(self):
            for path in evdev.list_devices():
                if path in self.devs:
                    continue
                try:
                    dev = evdev.InputDevice(path)
                except OSError:
                    continue
                caps = dev.capabilities(absinfo=False).get(E.EV_ABS, [])
                only = [n for n in os.environ.get("BAR_TOUCH_DEVICES", "").split(",") if n]
                if (E.ABS_MT_POSITION_X not in caps or E.INPUT_PROP_DIRECT not in dev.input_props()
                        or (only and dev.name not in only)):
                    dev.close()
                    continue
                td = TouchDev(dev)
                # DEFAULT priority, never HIGH: a HIGH source is dispatched while GDK's
                # Wayland source still holds a prepared read, and any window created
                # from it deadlocks in wl_display_roundtrip (reproduced 2026-09-24).
                td.watch = GLib.io_add_watch(dev.fd, GLib.PRIORITY_DEFAULT, GLib.IO_IN | GLib.IO_ERR | GLib.IO_HUP,
                                             self.on_input, td)
                self.devs[path] = td
                log(f"touchscreen: {dev.name} ({path})")
                if self.mouse:
                    self.grab(td, True)
            return True

        def drop(self, td):
            if td.watch:
                GLib.source_remove(td.watch)
            try:
                td.dev.close()
            except OSError:
                pass
            self.devs.pop(td.dev.path, None)
            log(f"touchscreen gone: {td.dev.path}")
            # A device that vanishes mid-touch never sends its lift. Left alone, its
            # session stays open and frame() ignores every other screen for good:
            # all taps become "mouse", no card, no popup (2026-09-25, after the
            # virtual test screen was removed while the daemon lagged under load).
            if self.session is not None and self.session.dev is td:
                log("touch session dropped with its device")
                self.session = None
                self.release_buttons()

        def grab(self, td, on):
            try:
                if on and not td.grabbed:
                    td.dev.grab(); td.grabbed = True
                elif not on and td.grabbed:
                    td.dev.ungrab(); td.grabbed = False
            except OSError as exc:
                log(f"grab({on}) failed on {td.dev.path}: {exc}")

        def set_mouse(self, on):
            if on == self.mouse:
                return
            self.release_buttons()
            self.mouse = on
            for td in list(self.devs.values()):
                self.grab(td, on)
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(MOUSE_FLAG, "w") as f:
                f.write("on\n" if on else "off\n")
            subprocess.run(["pkill", f"-RTMIN+{MOUSE_SIGNAL}", "-x", "waybar"])
            log(f"mouse mode {'ON' if on else 'OFF'}")

        # ── evdev ──
        def on_input(self, _fd, cond, td):
            if cond & (GLib.IO_ERR | GLib.IO_HUP):
                self.drop(td)
                return False
            try:
                events = list(td.dev.read())
            except BlockingIOError:
                return True
            except OSError:
                self.drop(td)
                return False
            for ev in events:
                if ev.type == E.EV_ABS:
                    if ev.code == E.ABS_MT_SLOT:
                        td.slot = ev.value
                    elif ev.code == E.ABS_MT_TRACKING_ID:
                        td.ids[td.slot] = ev.value
                        if ev.value < 0:
                            td.ids.pop(td.slot, None)
                    elif ev.code == E.ABS_MT_POSITION_X:
                        td.pos[td.slot] = (ev.value, td.pos.get(td.slot, (None, None))[1])
                    elif ev.code == E.ABS_MT_POSITION_Y:
                        td.pos[td.slot] = (td.pos.get(td.slot, (None, None))[0], ev.value)
                elif ev.type == E.EV_SYN:
                    if ev.code == E.SYN_REPORT:
                        self.frame(td)
                    elif ev.code == E.SYN_DROPPED:
                        td.ids.clear()
                        self.frame(td)
            return True

        def frame(self, td):
            raw = td.contacts()
            s = self.session
            if s is None:
                if raw:
                    mon = touch_monitor()
                    self.bar_h = bar_height(mon)
                    self.session = Session(td, mon, raw)
                    self.last_touch = time.monotonic()
                    self.walker.touch_down(self.session)
                    self.outside_touch(self.session)
                    self.begin(self.session)
                return
            if s.dev is not td:
                # Safety net for any other way a session loses its lift: a touch on
                # another screen 3 s after the open session last moved replaces it.
                if raw and time.monotonic() - getattr(s, "t_last", s.t0) > 3.0:
                    log("stale touch session replaced")
                    self.session = None
                    self.release_buttons()
                    self.frame(td)
                return
            s.t_last = time.monotonic()
            if not raw:
                s.t_up = time.monotonic()
                s.fingers = 0
                self.session, self.last = None, s
                self.end(s)
                return
            s.fingers = len(raw)
            s.max_fingers = max(s.max_fingers, s.fingers)
            s.x, s.y, s.lx, s.ly = self.map_point(td, s.mon, raw[0])
            s.moved = max(s.moved, ((s.x - s.x0) ** 2 + (s.y - s.y0) ** 2) ** 0.5)
            if self.mouse:
                self.mouse_motion(s, raw)

        # ── gesture phases ──
        def begin(self, s):
            if s.in_bar and not self.mouse:
                s.workspace = (hypr_json("activeworkspace") or {}).get("id")
            if self.mouse:
                if s.in_bar:
                    hypr(f"dispatch movecursor {int(s.x0)} {int(s.y0)}")
                    self.button(E.BTN_LEFT, 1)
                    s.bar_held = True
                else:
                    GLib.timeout_add(int(LONG_PRESS * 1000), self.mouse_long, s)

        def mouse_motion(self, s, raw):
            if s.in_bar or s.consumed:
                return
            if s.fingers >= 2 and not s.dragging:
                pts = [self.map_point(s.dev, s.mon, r) for r in raw[:2]]
                cx, cy = sum(p[0] for p in pts) / 2, sum(p[1] for p in pts) / 2
                if s.two is None:
                    s.two = (cx, cy)
                    return
                dx, dy = cx - s.two[0], cy - s.two[1]
                if dy < -SWIPE_MIN and abs(dy) > 1.5 * abs(dx):
                    s.consumed = True
                    log("two-finger swipe up: overview")
                    GLib.idle_add(lambda: (self.overview.toggle(), False)[1])
                return
            if s.two is not None or s.max_fingers > 1:
                return
            if not s.dragging and s.moved > MOVE_TOL:
                hypr(f"dispatch movecursor {int(s.x0)} {int(s.y0)}")
                self.button(E.BTN_LEFT, 1)
                s.dragging = True
            if s.dragging:
                now = time.monotonic()
                if now - s.last_move >= 0.008:
                    s.last_move = now
                    hypr(f"dispatch movecursor {int(s.x)} {int(s.y)}")

        def mouse_long(self, s):
            if (self.session is s and s.max_fingers == 1 and not s.dragging and not s.consumed
                    and s.moved <= MOVE_TOL):
                s.consumed = True
                hypr(f"dispatch movecursor {int(s.x0)} {int(s.y0)}")
                self.click(E.BTN_RIGHT)
            return False

        def end(self, s):
            self.walker.touch_up(s)
            if self.mouse:
                if s.bar_held:
                    self.button(E.BTN_LEFT, 0)
                elif s.dragging:
                    hypr(f"dispatch movecursor {int(s.x)} {int(s.y)}")
                    self.button(E.BTN_LEFT, 0)
                elif not s.consumed and s.max_fingers == 1 and s.moved <= MOVE_TOL:
                    hypr(f"dispatch movecursor {int(s.x0)} {int(s.y0)}")
                    self.click(E.BTN_LEFT)
            p = self.pending
            if p and p["session"] is s and not p["done"]:
                p["done"] = True
                if s.moved <= BAR_MOVE_TOL:
                    self.tap(p)
            if s.in_bar and self.open_windows():
                # A bar touch that no module claims (empty bar, workspace numbers,
                # tray) also closes the popup. Waybar's click can land after the
                # lift, so wait before deciding.
                GLib.timeout_add(1000, self.bar_touch_unclaimed, s)
            if s.in_bar and not self.mouse and s.max_fingers == 1 and s.moved <= BAR_MOVE_TOL:
                GLib.timeout_add(1000, self.check_bar_answered, s)

        # ── dismissing popups: a touch anywhere else closes them ──
        def open_windows(self):
            wins = [w for w in (self.toast, self.card, *self.popups.values())
                    if w.win and not getattr(w, "persistent", False)]
            return wins

        def dismiss_all(self, why):
            """Close every transient popup. The on-screen keyboard ("persistent") is
            not one: a touch in the text field he is typing into must not hide it.
            It closes from its own hide key or its bar icon (open_popup)."""
            if self.open_windows():
                log(f"popups closed: {why}")
            self.toast.hide()
            self.card.hide()
            for popup in self.popups.values():
                if not getattr(popup, "persistent", False):
                    popup.hide()

        def outside_touch(self, s):
            """Touch-down outside every open popup closes them. Bar touches are left
            to the click (same icon = close, another icon = switch) and to
            bar_touch_unclaimed; the overview handles its own taps."""
            if s.in_bar or not self.open_windows():
                return
            layers = hypr_json("layers") or {}
            for mon in layers.values():
                for level in (mon.get("levels") or {}).values():
                    for ly in level:
                        ns = ly.get("namespace", "")
                        if not ns.startswith("bar-touch-") or ns == "bar-touch-overview":
                            continue
                        if (ly["x"] <= s.x0 < ly["x"] + ly["w"]
                                and ly["y"] <= s.y0 < ly["y"] + ly["h"]):
                            return
            self.dismiss_all(f"touch outside at {int(s.x0)},{int(s.y0)}")

        def bar_touch_unclaimed(self, s):
            if not s.clicked:
                self.dismiss_all("bar touch with no module click")
            return False

        # ── touch-dead waybar ──
        def check_bar_answered(self, s):
            """A bar tap waybar never answered. Workspace numbers do not call bar-touch,
            so a tap that switched workspace was answered too."""
            if s.clicked:
                self.unanswered.clear()
                return False
            if s.workspace is not None and (hypr_json("activeworkspace") or {}).get("id") != s.workspace:
                self.unanswered.clear()
                return False
            now = time.monotonic()
            self.unanswered = [(t, x) for t, x in self.unanswered if now - t < DEAD_WINDOW]
            self.unanswered.append((now, s.x0))
            same = sum(1 for _, x in self.unanswered if abs(x - s.x0) <= DEAD_SPOT)
            log(f"bar tap at x={int(s.x0)} unanswered ({same} here, {len(self.unanswered)} in {DEAD_WINDOW}s)")
            if same >= DEAD_SAME_SPOT or len(self.unanswered) >= DEAD_ANY:
                self.restart_waybar(f"{len(self.unanswered)} bar taps unanswered")
            return False

        def restart_waybar(self, why):
            now = time.monotonic()
            self.unanswered.clear()
            if now - self.waybar_restarted < DEAD_COOLDOWN:
                log(f"waybar touch-dead ({why}), restarted {int(now - self.waybar_restarted)}s ago: waiting")
                return
            self.waybar_restarted = now
            log(f"waybar touch-dead ({why}): restarting waybar")
            run_detached(os.path.expanduser("~/.local/bin/restart-waybar"))
            run_detached("notify-send -a bar-touch 'Top bar stopped answering touch' "
                         "'Restarted it. Tap again in a moment.'")

        # ── virtual mouse ──
        def button(self, btn, value):
            self.ui.write(E.EV_KEY, btn, value)
            self.ui.syn()

        def click(self, btn):
            self.button(btn, 1)
            time.sleep(0.02)
            self.button(btn, 0)

        def release_buttons(self):
            for btn in (E.BTN_LEFT, E.BTN_RIGHT):
                self.button(btn, 0)

        # ── bar clicks ──
        def on_click(self, msg):
            name, env = msg.get("module", ""), msg.get("env") or self.env
            now = time.monotonic()
            s = self.session
            for sess in (s, self.last):
                if sess is not None:
                    sess.clicked = True
            if s is not None and now - s.t0 < 2.0 and s.max_fingers == 1:
                p = {"module": name, "env": env, "session": s, "done": False}
                self.pending = p
                wait = LONG_PRESS - (now - s.t0)
                GLib.timeout_add(max(0, int(wait * 1000)), self.bar_long, p)
                return "touch"
            last = self.last
            if last is not None and last.t_up and now - last.t_up < RECENT and last.max_fingers == 1:
                p = {"module": name, "env": env, "session": last, "done": True}
                if last.moved > BAR_MOVE_TOL:
                    return "cancelled"
                if last.t_up - last.t0 >= LONG_PRESS:
                    self.long_press(p)
                else:
                    self.tap(p)
                return "touch"
            _, touch = module_spec(name)
            popup = self.popups.get(touch.get("popup"))
            if popup:
                # Mouse clicks get the same popup as a finger: the TUIs it replaces
                # (wiremix, impala, bluetui) are not wanted at all (2026-09-25).
                self.open_popup(popup, env, *self.cursor_spot())
            else:
                self.dismiss_all(f"mouse click on {name}")
                if touch.get("tap-card"):
                    self.act_and_card(name, env, *self.cursor_spot())
                elif touch.get("click"):
                    run_click(touch, with_target_window(name, env))
            return "mouse"

        def cursor_spot(self):
            """(monitor-local x, monitor) under the mouse pointer."""
            pos = hypr_json("cursorpos") or {}
            x, y = pos.get("x", 0), pos.get("y", 0)
            for m in hypr_json("monitors") or []:
                scale = m.get("scale") or 1
                if m["x"] <= x < m["x"] + m["width"] / scale and m["y"] <= y < m["y"] + m["height"] / scale:
                    return x - m["x"], m
            mon = touch_monitor()
            return x - mon["x"], mon

        def open_popup(self, popup, env, x_local, mon):
            if popup.win:
                # its own icon again: close, like a menu
                self.dismiss_all("same icon again")
                popup.hide()
                return
            self.toast.hide()
            self.card.hide()
            for other in self.popups.values():
                if not getattr(other, "persistent", False):
                    other.hide()          # the on-screen keyboard stays under a card or a list
            popup.show(env, x_local, mon)

        def bar_long(self, p):
            s = p["session"]
            if not p["done"] and self.session is s and s.moved <= BAR_MOVE_TOL:
                p["done"] = True
                self.long_press(p)
            return False

        def tap(self, p):
            s = p["session"]
            _, touch = module_spec(p["module"])
            log(f"tap: {p['module']} -> {touch.get('popup') or touch.get('click') or '(no action)'}")
            popup = self.popups.get(touch.get("popup"))
            if popup:
                self.open_popup(popup, p["env"], s.lx0, s.mon)
                return
            self.dismiss_all(f"tap on {p['module']}")
            if touch.get("tap-card"):
                self.act_and_card(p["module"], p["env"], s.lx0, s.mon)
                return
            self.act_and_report(p["module"], with_target_window(p["module"], p["env"]), s.lx0, s.mon,
                                cmd=touch.get("click"), label_text=touch.get("click-label"))

        def act_and_card(self, name, env, x_local, mon):
            """"tap-card": a tap or click only opens the card; its first button runs
            the action. Voice typing, 2026-09-25: "tap: start or stop recording"
            should be the trigger, a tap that already recorded was not intuitive."""
            self.card.show(name, env, x_local, mon)

        def long_press(self, p):
            s = p["session"]
            log(f"long press: {p['module']}")
            self.dismiss_all(f"long press on {p['module']}")
            self.card.show(p["module"], p["env"], s.lx0, s.mon)

        def act_and_report(self, name, env, x_local, mon, cmd=None, label_text=None):
            """Run cmd (if any), then toast the module's state before -> after."""
            title = title_of(name)

            _, touch = module_spec(name)
            if cmd and touch.get("toast") is False:
                # No toast wanted: run the action at once. Reading the state first
                # only delayed the tap (a process spawn) for a toast never shown.
                run_click(touch, env) if cmd == touch.get("click") else run_detached(cmd, env)
                return

            def work():
                before, _ = module_state(name, env)
                after = before
                if cmd:
                    proc = subprocess.Popen(["sh", "-c", cmd], env=env, start_new_session=True,
                                            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                            stderr=subprocess.DEVNULL)
                    try:
                        proc.wait(timeout=1.5)
                    except subprocess.TimeoutExpired:
                        threading.Thread(target=proc.wait, daemon=True).start()
                    for delay in (0.15, 0.4, 0.8):
                        time.sleep(delay)
                        after, _ = module_state(name, env)
                        if after != before:
                            break
                # No popup when the tap opened something (state unchanged: the new
                # window is the feedback) or when the module opts out ("toast": false).
                _, touch = module_spec(name)
                if touch.get("toast") is False or (cmd and after == before):
                    return
                GLib.idle_add(self.toast.show, title, after, x_local, mon)
            threading.Thread(target=work, daemon=True).start()

        # ── control socket ──
        def serve(self):
            try:
                os.unlink(SOCK)
            except OSError:
                pass
            srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            srv.bind(SOCK)
            os.chmod(SOCK, 0o600)
            srv.listen(8)

            def loop():
                while True:
                    conn, _ = srv.accept()
                    threading.Thread(target=self.handle_conn, args=(conn,), daemon=True).start()
            threading.Thread(target=loop, daemon=True).start()

        def handle_conn(self, conn):
            try:
                conn.settimeout(2)
                data = b""
                while True:
                    chunk = conn.recv(65536)
                    if not chunk:
                        break
                    data += chunk
                msg = json.loads(data or b"{}")
                done = threading.Event()
                box = {}

                def on_main():
                    try:
                        box["reply"] = self.dispatch(msg)
                    except Exception as exc:  # never kill the daemon on a bad request
                        log(f"request {msg.get('cmd')} failed: {exc!r}")
                        box["reply"] = {"error": repr(exc)}
                    done.set()
                    return False
                GLib.idle_add(on_main)
                done.wait(2)
                conn.sendall(json.dumps(box.get("reply", {})).encode())
            except (OSError, ValueError) as exc:
                log(f"bad request: {exc}")
            finally:
                conn.close()

        def dispatch(self, msg):
            cmd = msg.get("cmd")
            if cmd == "click":
                verdict = self.on_click(msg)
                log(f"click {msg.get('module')}: {verdict}")
                return {"verdict": verdict}
            if cmd == "mouse":
                want = msg.get("set", "toggle")
                self.set_mouse(not self.mouse if want == "toggle" else want == "on")
                return {"mouse": self.mouse}
            if cmd == "overview":
                self.overview.toggle()
                return {}
            if cmd == "status":
                kbd = self.popups.get("keyboard")
                return {"mouse": self.mouse, "devices": [f"{t.dev.name} {t.dev.path} grabbed={t.grabbed}"
                                                         for t in self.devs.values()],
                        "bar_h": self.bar_h, "touching": self.session is not None,
                        "keyboard": bool(kbd and kbd.win)}
            return {"error": f"unknown cmd {cmd}"}

    daemon = Daemon()
    daemon.serve()
    daemon.scan()
    GLib.timeout_add_seconds(5, daemon.scan)
    if mouse_mode_on():
        daemon.set_mouse(True)

    def quit_(*_):
        daemon.release_buttons()
        for td in list(daemon.devs.values()):
            daemon.grab(td, False)
        Gtk.main_quit()
    import signal
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        add_signal = GLibUnix.signal_add
    except (ValueError, ImportError):
        add_signal = GLib.unix_signal_add
    for sig in (signal.SIGTERM, signal.SIGINT):
        add_signal(GLib.PRIORITY_DEFAULT, sig, quit_)
    log(f"bar-touch daemon up; mouse mode {'ON' if daemon.mouse else 'OFF'}")
    Gtk.main()


def main():
    args = sys.argv[1:] or ["status"]
    cmd = args[0]
    if cmd == "daemon":
        cmd_daemon()
    elif cmd == "click" and len(args) > 1:
        cmd_click(args[1])
    elif cmd == "mouse":
        cmd_mouse(args[1] if len(args) > 1 else "toggle")
    elif cmd == "mouse-status":
        cmd_mouse_status()
    elif cmd == "overview":
        if send({"cmd": "overview"}) is None:
            sys.exit("bar-touch daemon is not running")
    elif cmd == "status":
        reply = send({"cmd": "status"})
        print(json.dumps(reply, indent=2) if reply is not None else "bar-touch daemon is not running")
    else:
        print(__doc__.split("Usage:")[1].strip(), file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
