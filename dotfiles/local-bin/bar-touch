SWIPE_MIN = 110              # logical px of two-finger upward travel for the overview
RECENT = 0.35                # s: a touch that ended this recently still owns a click
# Touch-dead waybar (docs/issues/waybar-ignores-touch-stale-touch-2026-10-02.md): GTK3
# turns a touch into a click only while no other touch is held, so one lost lift leaves
# waybar ignoring every tap until it restarts. Unanswered bar taps reveal it.
DEAD_WINDOW = 30             # s in which unanswered bar taps add up
DEAD_SAME_SPOT = 2           # unanswered taps within DEAD_SPOT px of each other
DEAD_SPOT = 30               # logical px
DEAD_ANY = 3                 # unanswered taps anywhere on the bar
