    .bt-pop label.bt-kbd-cap { font-size: 19px; }
    .bt-pop label.bt-kbd-small { font-size: 11px; opacity: 0.65; }
    scale.bt-vol trough { min-height: 16px; border-radius: 8px; }
    scale.bt-vol highlight { min-height: 16px; border-radius: 8px; background-color: #89b4fa; }
