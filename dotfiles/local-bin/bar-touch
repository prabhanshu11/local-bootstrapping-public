        def _load_into(self, img, path):
            from gi.repository import GdkPixbuf
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, self.TW, self.TH, True)
                img.set_from_pixbuf(pb)
            except GLib.Error:
                pass

        def set_thumb(self, gen, path, thumb):
            r = self.rows.get(path)
            if gen != self.gen or not self.win or not r:
                return False
            r["thumb"] = thumb
            if not (self.preview and self.preview["path"] == path):
                self._load_into(r["img"], thumb)
            return False

        def want_keyboard(self, *_):
            if self.win:
                GtkLayerShell.set_keyboard_mode(self.win, GtkLayerShell.KeyboardMode.ON_DEMAND)
                self.search.grab_focus()
            return False

        # ── filter ──
        def on_search(self, entry):
            self.query = entry.get_text()
            self.bump()
            self.apply_filter()

        def apply_filter(self):
            q = (self.query or "").lower().split()
            shown = 0
            for path, r in self.rows.items():
                hay = (r["entry"]["name"] + " " + r["entry"].get("dir", "")).lower()
                ok = all(w in hay for w in q)
                r["box"].set_visible(ok)
                shown += ok
            total = len(self.rows)
            self.count.set_text(f"{shown} of {total}" if q else f"{total} files")
            empty = ("Nothing yet: videos you play in Firefox / Chrome appear here." if self.tab == "web"
                     else "Nothing yet: videos you play in mpv, VLC or any player appear here.")
            msg = self.note if total else (self.note if self.note == "refreshing…" else empty)
            self.status.set_text(msg or "")
            self.status.set_visible(bool(msg))
            self.scroller.set_min_content_height(min(max(shown, 1) * 128, self.max_h))

        # ── actions ──
        def act(self, what, e):
            env = self.env
            if e.get("kind") == "web":
                self.hide()
                pos = e.get("position") if not e.get("finished") else 0
                log(f"mpv-history: open page {e['path']} at {pos}")
                run_detached(f"{MPV_HISTORY} open {shlex.quote(e['path'])} {float(pos or 0):.0f}", env)
                return
            if e.get("unreachable") and not e.get("remote"):
                # mpv-history re-checks the share: if it is back it opens, else it notifies
                self.bump()
                log(f"mpv-history: {what} on an offline share {e['path']}")
                run_detached(f"{MPV_HISTORY} {what} {shlex.quote(e['path'])}", env)
                return
            self.hide()
            log(f"mpv-history: {what} {e['path']}")
            run_detached(f"{MPV_HISTORY} {what} {shlex.quote(e['path'])}", env)

        # ── 20x preview inside the thumbnail ──
        def toggle_preview(self, e):
            same = self.preview and self.preview["path"] == e["path"]
            self.stop_preview()
            if not same:
                self.start_preview(e)

        def start_preview(self, e):
            r = self.rows.get(e["path"])
            if not r:
                return
            pos, dur = e.get("position") or 0, e.get("duration") or 0
            start = 0.0
            if pos and not e.get("finished") and pos > 60:
                start = pos - 60           # a minute before where you stopped
            vf = (f"fps={1 / self.STEP},scale={self.TW}:{self.TH}:force_original_aspect_ratio=decrease,"
                  f"pad={self.TW}:{self.TH}:(ow-iw)/2:(oh-ih)/2")
            cmd = ["ffmpeg", "-nostdin", "-v", "error", "-threads", "2", "-skip_frame", "bidir",
                   "-ss", f"{start:.1f}", "-i", e["path"], "-an", "-sn", "-dn", "-vf", vf,
                   "-f", "rawvideo", "-pix_fmt", "rgb24", "-"]
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                        stdin=subprocess.DEVNULL)
            except OSError as exc:
                log(f"mpv-history preview failed: {exc}")
                return
            stop = threading.Event()
            pv = {"path": e["path"], "proc": proc, "stop": stop, "frames": 0}
            self.preview = pv
            r["badge"].set_text(f"×{self.SPEED}  {hms(start)}")
            r["badge"].show()
            r["box"].get_style_context().add_class("previewing")
            log(f"mpv-history: preview {self.SPEED}x from {hms(start)} {e['path']}")
            size = self.TW * self.TH * 3
            interval = self.STEP / self.SPEED

            def reader():
                nxt = time.monotonic()
                i = 0
                while not stop.is_set():
                    buf = b""
                    while len(buf) < size:
                        chunk = proc.stdout.read(size - len(buf))
                        if not chunk:
                            break
                        buf += chunk
                    if len(buf) < size or stop.is_set():
                        break
                    t = start + i * self.STEP
                    GLib.idle_add(self.show_frame, pv, buf, t)
                    i += 1
                    nxt += interval
                    delay = nxt - time.monotonic()
                    if delay > 0:
                        stop.wait(delay)
                    else:
                        nxt = time.monotonic()
                GLib.idle_add(self.preview_ended, pv)
            threading.Thread(target=reader, daemon=True).start()

        def show_frame(self, pv, buf, t):
            if self.preview is not pv or not self.win:
                return False
            from gi.repository import GdkPixbuf
            r = self.rows.get(pv["path"])
            if not r:
                return False
            pb = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(buf), GdkPixbuf.Colorspace.RGB,
                                                 False, 8, self.TW, self.TH, self.TW * 3)
            r["img"].set_from_pixbuf(pb)
            r["badge"].set_text(f"×{self.SPEED}  {hms(t)}")
            pv["frames"] += 1
            return False

        def preview_ended(self, pv):
            if self.preview is pv:
                log(f"mpv-history: preview ended after {pv['frames']} frames")
                self.stop_preview()
            return False

        def stop_preview(self):
            pv, self.preview = self.preview, None
            if not pv:
                return
            pv["stop"].set()
            try:
                pv["proc"].kill()
                pv["proc"].wait(timeout=2)
            except (OSError, subprocess.TimeoutExpired):
                pass
            r = self.rows.get(pv["path"])
            if r and self.win:
                r["badge"].hide()
                r["box"].get_style_context().remove_class("previewing")
                if r["thumb"]:
                    self._load_into(r["img"], r["thumb"])
                else:
                    r["img"].set_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)

        def bump(self):
            if self.timer:
                GLib.source_remove(self.timer)
            self.timer = GLib.timeout_add_seconds(self.IDLE, self.idle_close)

        def idle_close(self):
            if self.preview:
                return True                # keep open while a preview plays
            self.timer = None
            self.hide()
            return False

        def hide(self, *_):
            self.stop_preview()
            self.gen += 1
            if self.timer:
                GLib.source_remove(self.timer)
                self.timer = None
            if self.win:
                self.win.destroy()
                self.win = None
            self.rows = {}
            return False

    # ── on-screen keyboard (2026-10-03) ──
    KEYSYM_CHARS = {
        "space": " ", "comma": ",", "period": ".", "slash": "/", "backslash": "\\", "semicolon": ";",
        "apostrophe": "'", "grave": "`", "minus": "-", "equal": "=", "bracketleft": "[", "bracketright": "]",
        "exclam": "!", "at": "@", "numbersign": "#", "dollar": "$", "percent": "%", "asciicircum": "^",
        "ampersand": "&", "asterisk": "*", "parenleft": "(", "parenright": ")", "underscore": "_", "plus": "+",
        "braceleft": "{", "braceright": "}", "bar": "|", "colon": ":", "quotedbl": '"', "asciitilde": "~",
        "less": "<", "greater": ">", "question": "?",
    }

    def xkb_labels(layout, variant):
        """{evdev keycode: (level-1 char, level-2 char)} and the layout's display
        name, from libxkbcommon's own compiler (`xkbcli compile-keymap`), so the
        keys show what Hyprland will really type for that layout. Returns
        ({}, "") if the compiler is missing: the keys then fall back to QWERTY."""
        cmd = ["xkbcli", "compile-keymap", "--layout", layout]
        if variant:
            cmd += ["--variant", variant]
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            return {}, ""
        codes, names = {}, {}
        for m in re.finditer(r"<(\w+)>\s*=\s*(\d+);", out):
            codes[m.group(1)] = int(m.group(2)) - 8
        sym_section = out[out.find("xkb_symbols"):]
        name_m = re.search(r'name\[1\]\s*=\s*"([^"]*)"', sym_section)
        for m in re.finditer(r"key\s+<(\w+)>\s*\{[^\[\]]*\[([^\]]*)\]", sym_section):
            syms = [s.strip() for s in m.group(2).split(",")]
            chars = []
            for s in syms[:2]:
                if s in KEYSYM_CHARS:
                    chars.append(KEYSYM_CHARS[s])
                elif len(s) == 1:
                    chars.append(s)
                else:
                    chars.append("")
            while len(chars) < 2:
                chars.append("")
            if m.group(1) in codes:
                names[codes[m.group(1)]] = (chars[0], chars[1])
        return names, (name_m.group(1) if name_m else f"{layout} {variant}".strip())

    QWERTY = {E.KEY_GRAVE: ("`", "~"), E.KEY_1: ("1", "!"), E.KEY_2: ("2", "@"), E.KEY_3: ("3", "#"),
              E.KEY_4: ("4", "$"), E.KEY_5: ("5", "%"), E.KEY_6: ("6", "^"), E.KEY_7: ("7", "&"),
              E.KEY_8: ("8", "*"), E.KEY_9: ("9", "("), E.KEY_0: ("0", ")"), E.KEY_MINUS: ("-", "_"),
              E.KEY_EQUAL: ("=", "+"), E.KEY_LEFTBRACE: ("[", "{"), E.KEY_RIGHTBRACE: ("]", "}"),
              E.KEY_BACKSLASH: ("\\", "|"), E.KEY_SEMICOLON: (";", ":"), E.KEY_APOSTROPHE: ("'", '"'),
              E.KEY_COMMA: (",", "<"), E.KEY_DOT: (".", ">"), E.KEY_SLASH: ("/", "?")}
    for _i, _c in enumerate("qwertyuiop"):
        QWERTY[E.KEY_Q + _i] = (_c, _c.upper())
    for _i, _c in enumerate("asdfghjkl"):
        QWERTY[E.KEY_A + _i] = (_c, _c.upper())
    for _i, _c in enumerate("zxcvbnm"):
        QWERTY[E.KEY_Z + _i] = (_c, _c.upper())

    class KeyboardPopup:
        """The on-screen keyboard (2026-10-03, "an on-screen keyboard … it should pop
        up from the bottom of the screen … use just the touch screen to type on it
        … a toggle for switching between the keyboard layouts which are already
        present"). Lives on the layout icon (hyprland/language): tap = show / hide,
        long press = card.

        It is a layer-shell window anchored to the bottom with an exclusive zone
        (windows shrink above it) and NO keyboard focus of its own, so the window
        he was typing in keeps the focus. Keys go through a uinput keyboard
        ("bar-touch-keyboard"), which Hyprland treats like a plugged-in keyboard:
        the active xkb layout decides what a keycode types, so the keycaps are
        labelled from libxkbcommon for that layout (Dvorak shows Dvorak). The
        layout key switches EVERY keyboard (`switchxkblayout all`) so the physical
        keyboard, the bar icon and the keycaps always agree. Unlike the other
        popups it is persistent: a touch elsewhere (the text field!) must not close
        it; only its own hide key, its bar icon, or a Hyprland restart do."""
        persistent = True
        KEY_H = 58           # px: finger-sized (touch-native rule: >= 44)
        UNIT = 74            # px per key unit
        MODS = {E.KEY_LEFTSHIFT: "Shift", E.KEY_RIGHTSHIFT: "Shift", E.KEY_LEFTCTRL: "Ctrl",
                E.KEY_RIGHTCTRL: "Ctrl", E.KEY_LEFTALT: "Alt", E.KEY_RIGHTALT: "Alt", E.KEY_LEFTMETA: "Super"}
        SPECIAL = {E.KEY_ESC: "Esc", E.KEY_BACKSPACE: "⌫", E.KEY_TAB: "Tab", E.KEY_CAPSLOCK: "Caps",
                   E.KEY_ENTER: "Enter ⏎", E.KEY_SPACE: "", E.KEY_DELETE: "Del", E.KEY_HOME: "Home",
                   E.KEY_END: "End", E.KEY_PAGEUP: "PgUp", E.KEY_PAGEDOWN: "PgDn", E.KEY_UP: "↑",
                   E.KEY_DOWN: "↓", E.KEY_LEFT: "←", E.KEY_RIGHT: "→", E.KEY_LEFTMETA: "Super"}
        # (keycode, width in units) per row; None = a gap of one unit
        ROWS = [
            [(E.KEY_ESC, 1.25), (E.KEY_GRAVE, 1), (E.KEY_1, 1), (E.KEY_2, 1), (E.KEY_3, 1), (E.KEY_4, 1),
             (E.KEY_5, 1), (E.KEY_6, 1), (E.KEY_7, 1), (E.KEY_8, 1), (E.KEY_9, 1), (E.KEY_0, 1),
             (E.KEY_MINUS, 1), (E.KEY_EQUAL, 1), (E.KEY_BACKSPACE, 2)],
            [(E.KEY_TAB, 1.75), (E.KEY_Q, 1), (E.KEY_W, 1), (E.KEY_E, 1), (E.KEY_R, 1), (E.KEY_T, 1),
             (E.KEY_Y, 1), (E.KEY_U, 1), (E.KEY_I, 1), (E.KEY_O, 1), (E.KEY_P, 1), (E.KEY_LEFTBRACE, 1),
             (E.KEY_RIGHTBRACE, 1), (E.KEY_BACKSLASH, 1.5)],
            [(E.KEY_CAPSLOCK, 2), (E.KEY_A, 1), (E.KEY_S, 1), (E.KEY_D, 1), (E.KEY_F, 1), (E.KEY_G, 1),
             (E.KEY_H, 1), (E.KEY_J, 1), (E.KEY_K, 1), (E.KEY_L, 1), (E.KEY_SEMICOLON, 1),
             (E.KEY_APOSTROPHE, 1), (E.KEY_ENTER, 2.25)],
            [(E.KEY_LEFTSHIFT, 2.5), (E.KEY_Z, 1), (E.KEY_X, 1), (E.KEY_C, 1), (E.KEY_V, 1), (E.KEY_B, 1),
             (E.KEY_N, 1), (E.KEY_M, 1), (E.KEY_COMMA, 1), (E.KEY_DOT, 1), (E.KEY_SLASH, 1),
             (E.KEY_RIGHTSHIFT, 2.75)],
            [(E.KEY_LEFTCTRL, 1.5), (E.KEY_LEFTMETA, 1.25), (E.KEY_LEFTALT, 1.25), (E.KEY_SPACE, 6.75),
             (E.KEY_RIGHTALT, 1.25), (E.KEY_RIGHTCTRL, 1.5), None, (E.KEY_LEFT, 1), (E.KEY_DOWN, 1),
             (E.KEY_RIGHT, 1)],
        ]
        NAV = [[(E.KEY_DELETE, 1), (E.KEY_PAGEUP, 1)], [(E.KEY_HOME, 1), (E.KEY_PAGEDOWN, 1)],
               [(E.KEY_END, 1), None], [None, (E.KEY_UP, 1)]]

        def __init__(self, daemon):
            self.d = daemon
            self.win = None
            self.env = dict(os.environ)
            self.layouts = []            # [(layout, variant, short, display name, {code: (c1, c2)})]
            self.index = 0
            self.latched = {}            # keycode -> "once" | "lock" (modifiers held down)
            self.caps = False
            self.labels = {}             # keycode -> (small label, big label)
            self.layout_btn = None
            self.mod_btns = {}           # keycode -> button
            self.down = set()
            codes = sorted({c for row in self.ROWS + self.NAV for k in row if k for c in [k[0]]})
            try:
                self.ui = UInput({E.EV_KEY: codes}, name="bar-touch-keyboard")
            except OSError as exc:
                log(f"keyboard: uinput failed: {exc}")
                self.ui = None
            GLib.timeout_add(2500, self.sync_device)

        # ── layouts (Hyprland's, in order) ──
        def read_layouts(self):
            lays = ((hypr_json("getoption input:kb_layout") or {}).get("str") or "us").split(",")
            vars_ = ((hypr_json("getoption input:kb_variant") or {}).get("str") or "").split(",")
            out = []
            for i, lay in enumerate(lays):
                lay = lay.strip()
                var = vars_[i].strip() if i < len(vars_) else ""
                names, display = xkb_labels(lay, var)
                if not names:
                    names, display = dict(QWERTY), f"{lay} {var}".strip()
                short = (var[:2] if var else lay[:2]).upper()
                out.append((lay, var, short, display, names))
            self.layouts = out or [("us", "", "US", "English (US)", dict(QWERTY))]

        def main_keyboard(self):
            kbs = (hypr_json("devices") or {}).get("keyboards") or []
            for kb in kbs:
                if kb.get("main"):
                    return kb
            return kbs[0] if kbs else {}

        def read_index(self):
            kb = self.main_keyboard()
            self.index = int(kb.get("active_layout_index") or 0)
            self.caps = bool(kb.get("capsLock"))
            if self.layouts and self.index >= len(self.layouts):
                self.index = 0

        def sync_device(self):
            """Our uinput keyboard starts on layout 0; put it on the layout the main
            keyboard uses so the first key typed matches the keycaps."""
            kb = self.main_keyboard()
            if kb and kb.get("name") != "bar-touch-keyboard":
                hypr(f"switchxkblayout bar-touch-keyboard {int(kb.get('active_layout_index') or 0)}")
            return False

        def switch_layout(self, *_):
            if not self.layouts:
                return
            self.index = (self.index + 1) % len(self.layouts)
            hypr(f"switchxkblayout all {self.index}")
            log(f"keyboard: layout -> {self.layouts[self.index][3]}")
            self.relabel()

        # ── window ──
        def show(self, env, x_local, mon):
            self.hide()
            self.env = env or self.env
            self.read_layouts()
            self.read_index()
            self.sync_device()
            win = layer_window("bar-touch-keyboard", mon, bottom=True)
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            outer.get_style_context().add_class("bt-pop")
            outer.get_style_context().add_class("bt-kbd")
            body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            self.labels, self.mod_btns = {}, {}
            for row in self.ROWS:
                main.pack_start(self.row(row), False, False, 0)
            body.pack_start(main, False, False, 0)
            nav = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            for row in self.NAV:
                nav.pack_start(self.row(row), False, False, 0)
            body.pack_start(nav, False, False, 0)
            tools = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            hide = Gtk.Button()
            hide.add(label("⌨ ▾\nhide", "bt-kbd-cap", wrap=False, xalign=0.5))
            hide.get_style_context().add_class("bt-key")
            hide.get_style_context().add_class("bt-key-tool")
            hide.set_size_request(int(self.UNIT * 2.2), self.KEY_H * 2 + 4)
            hide.connect("clicked", lambda *_: self.hide())
            tools.pack_start(hide, False, False, 0)
            self.layout_btn = Gtk.Button()
            self.layout_lab = label("", "bt-kbd-cap", markup=True, wrap=False, xalign=0.5)
            self.layout_lab.set_justify(Gtk.Justification.CENTER)
            self.layout_btn.add(self.layout_lab)
            self.layout_btn.get_style_context().add_class("bt-key")
            self.layout_btn.get_style_context().add_class("bt-key-tool")
            self.layout_btn.set_size_request(int(self.UNIT * 2.2), self.KEY_H * 2 + 4)
            self.layout_btn.connect("clicked", self.switch_layout)
            tools.pack_start(self.layout_btn, False, False, 0)
            body.pack_start(tools, False, False, 0)
            outer.pack_start(body, False, False, 0)
            win.add(outer)
            win.show_all()
            self.win = win
            self.relabel()
            log("keyboard: shown")

        def row(self, keys):
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
            for k in keys:
                if k is None:
                    gap = Gtk.Box()
                    gap.set_size_request(self.UNIT, self.KEY_H)
                    box.pack_start(gap, False, False, 0)
                    continue
                code, w = k
                btn = Gtk.Button()
                cap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
                small = label("", "bt-kbd-small", wrap=False, xalign=0.5)
                big = label("", "bt-kbd-cap", wrap=False, xalign=0.5)
                cap.pack_start(small, False, False, 0)
                cap.pack_start(big, True, True, 0)
                btn.add(cap)
                btn.get_style_context().add_class("bt-key")
                if code in self.MODS or code == E.KEY_CAPSLOCK:
                    btn.get_style_context().add_class("bt-key-mod")
                    self.mod_btns[code] = btn
                elif code in self.SPECIAL:
                    btn.get_style_context().add_class("bt-key-special")
                btn.set_size_request(int(self.UNIT * w + 4 * (w - 1)), self.KEY_H)
                self.labels[code] = (small, big)
                if code in self.MODS:
                    btn.connect("clicked", self.on_mod, code)
                else:
                    btn.connect("pressed", self.on_press, code)
                    btn.connect("released", self.on_release, code)
                    btn.connect("clicked", self.on_clicked, code)
                box.pack_start(btn, False, False, 0)
            return box

        def relabel(self):
            if not self.win or not self.layouts:
                return
            names = self.layouts[self.index][4]
            shifted = any(c in (E.KEY_LEFTSHIFT, E.KEY_RIGHTSHIFT) for c in self.latched)
            for code, (small, big) in self.labels.items():
                if code in self.MODS:
                    small.set_text("")
                    how = self.latched.get(code)
                    big.set_text(self.MODS[code] + (" ●" if how == "lock" else " ○" if how else ""))
                    continue
                if code in self.SPECIAL:
                    small.set_text("")
                    big.set_text(self.SPECIAL[code] + (" ●" if code == E.KEY_CAPSLOCK and self.caps else ""))
                    continue
                c1, c2 = names.get(code, ("", ""))
                if c1.isalpha():
                    upper = shifted != self.caps
                    small.set_text("")
                    big.set_text(c2 if upper else c1)
                else:
                    small.set_text(c2)
                    big.set_text(c1)
            for code, btn in self.mod_btns.items():
                ctx = btn.get_style_context()
                on = code in self.latched or (code == E.KEY_CAPSLOCK and self.caps)
                (ctx.add_class if on else ctx.remove_class)("active-mod")
            lay = self.layouts[self.index]
            nxt = self.layouts[(self.index + 1) % len(self.layouts)]
            self.layout_lab.set_markup(f"<span size='x-large'><b>{GLib.markup_escape_text(lay[2])}</b></span>\n"
                                       f"<span size='small'>{GLib.markup_escape_text(lay[3])}</span>\n"
                                       f"<span size='small'>tap: {GLib.markup_escape_text(nxt[2])}</span>"
                                       if len(self.layouts) > 1 else
                                       f"<span size='x-large'><b>{GLib.markup_escape_text(lay[2])}</b></span>\n"
                                       f"<span size='small'>{GLib.markup_escape_text(lay[3])}</span>")

        # ── keys ──
        def key(self, code, value):
            if not self.ui:
                return
            self.ui.write(E.EV_KEY, code, value)
            self.ui.syn()

        def on_mod(self, _btn, code):
            """Tap = hold for the next key (○), tap again = lock (●), again = off."""
            how = self.latched.get(code)
            if how is None:
                self.latched[code] = "once"
                self.key(code, 1)
            elif how == "once":
                self.latched[code] = "lock"
            else:
                del self.latched[code]
                self.key(code, 0)
            self.relabel()

        def on_press(self, _btn, code):
            self.down.add(code)
            self.key(code, 1)

        def on_release(self, _btn, code):
            if code in self.down:
                self.down.discard(code)
                self.key(code, 0)
                self.after_key(code)

        def on_clicked(self, _btn, code):
            # "clicked" without a press/release pair (e.g. activated by GTK itself)
            if code in self.down:
                return
            self.key(code, 1)
            self.key(code, 0)
            self.after_key(code)

        def after_key(self, code):
            if code == E.KEY_CAPSLOCK:
                self.caps = not self.caps
            once = [c for c, how in self.latched.items() if how == "once"]
            for c in once:
                del self.latched[c]
                self.key(c, 0)
            if once or code == E.KEY_CAPSLOCK:
                self.relabel()

        def release_all(self):
            for code in list(self.latched):
                self.key(code, 0)
            self.latched.clear()
            for code in list(self.down):
                self.key(code, 0)
            self.down.clear()

        def hide(self, *_):
            self.release_all()
            if self.win:
                self.win.destroy()
                self.win = None
                log("keyboard: hidden")
            return False


    class Overview:
        def __init__(self):
            self.win = None

        def toggle(self):
            if self.win:
                self.hide()
            else:
                self.show()

        def show(self):
            mon = touch_monitor()
            clients = [c for c in (hypr_json("clients") or []) if c.get("mapped") and not c.get("hidden")]
            active = (hypr_json("activewindow") or {}).get("address")
            # Same order as Alt+Tab (hypr-alt-tab): the current desktop (every
            # workspace shown on a monitor) first, most-recently-used first within
            # it, then the rest by recency. Touch twin of Alt+Tab, 2026-09-30.
            shown = {m.get("activeWorkspace", {}).get("id") for m in (hypr_json("monitors") or [])
