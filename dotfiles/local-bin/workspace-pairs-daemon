#!/usr/bin/env python3
"""workspace-pairs-daemon — keeps two-monitor virtual desktops in sync.

Desktop N = workspace N on the external monitor + workspace N+10 on the
internal (eDP*) one. Any workspace switch that bypasses the workspace-pair
script (touchpad swipe, waybar click, direct dispatch) pulls the other
monitor to the matching pair member, so both screens always show the same
desktop — like KDE/GNOME/macOS. With one monitor it only rebinds 1-20 to
it and otherwise stays out of the way (workspace-pair toggles the halves).

Also owns the workspace→monitor rules, applied dynamically from the
detected monitor names, so no machine-specific names live in synced config
files. On monitor hotplug it re-detects, re-applies rules, and moves any
stray workspaces back where they belong (fixes "external grabbed workspace
5 after reconnect").

Stdlib only. Exits nonzero when the Hyprland socket goes away; systemd
restarts it (Restart=always).
"""

import glob
import json
import os
import socket
import subprocess
import sys
import time


def sock_dir():
    xdg = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if his and os.path.exists(f"{xdg}/hypr/{his}/.socket2.sock"):
        return f"{xdg}/hypr/{his}"
    dirs = [d for d in glob.glob(f"{xdg}/hypr/*") if os.path.exists(f"{d}/.socket2.sock")]
    return max(dirs, key=os.path.getmtime) if dirs else None


def hyprctl(*args):
    subprocess.run(["hyprctl", *args], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, check=False)


def hyprctl_json(cmd):
    return json.loads(subprocess.check_output(["hyprctl", "-j", cmd]))


class Pairs:
    def __init__(self):
        self.internal = None
        self.external = None

    def detect(self):
        mons = [m for m in hyprctl_json("monitors") if not m.get("disabled")]
        self.internal = next(
            (m["name"] for m in mons if m["name"].startswith("eDP")), None)
        self.external = next(
            (m["name"] for m in mons if not m["name"].startswith("eDP")), None)

    def paired(self):
        return bool(self.internal and self.external)

    def apply_rules(self):
        if not self.paired():
            # Single monitor (external unplugged, or lid-closed external
            # only): rebind all twenty to the one live output so no rule
            # keeps pointing at a dead connector. workspace-pair's
            # single-monitor mode then toggles N <-> N+10 on this screen;
            # resync()/enforce_placement() stay idle until the pair returns.
            sole = self.internal or self.external
            if sole:
                hyprctl("--batch", " ; ".join(
                    f"keyword workspace {i},monitor:{sole}" for i in range(1, 21)))
            return
        cmds = [f"keyword workspace {i},monitor:{self.external}" for i in range(1, 11)]
        cmds += [f"keyword workspace {i},monitor:{self.internal}" for i in range(11, 21)]
        hyprctl("--batch", " ; ".join(cmds))

    def enforce_placement(self):
        # Rules added at runtime don't retroactively move existing
        # workspaces, so push strays back explicitly (hotplug case).
        if not self.paired():
            return
        for w in hyprctl_json("workspaces"):
            wid = w["id"]
            if 1 <= wid <= 10 and w["monitor"] != self.external:
                hyprctl("dispatch", "moveworkspacetomonitor", str(wid), self.external)
            elif 11 <= wid <= 20 and w["monitor"] != self.internal:
                hyprctl("dispatch", "moveworkspacetomonitor", str(wid), self.internal)

    def resync(self):
        if not self.paired():
            return
        mons = hyprctl_json("monitors")
        by_name = {m["name"]: m for m in mons}
        if self.internal not in by_name or self.external not in by_name:
            return
        ext_ws = by_name[self.external]["activeWorkspace"]["id"]
        int_ws = by_name[self.internal]["activeWorkspace"]["id"]
        focused = next((m["name"] for m in mons if m.get("focused")), None)

        # The monitor the user is on defines the intended desktop. Out-of-
        # scheme workspaces (specials, >20, manually moved) are left alone.
        if focused == self.internal:
            if not 11 <= int_ws <= 20:
                return
            desk = int_ws - 10
            if ext_ws != desk:
                hyprctl("--batch",
                        f"dispatch workspace {desk} ; "
                        f"dispatch focusmonitor {self.internal}")
        else:
            if not 1 <= ext_ws <= 10:
                return
            desk = ext_ws
            if int_ws != desk + 10:
                hyprctl("--batch",
                        f"dispatch workspace {desk + 10} ; "
                        f"dispatch focusmonitor {self.external}")


def main():
    d = sock_dir()
    if d is None:
        print("workspace-pairs-daemon: no hyprland event socket found",
              file=sys.stderr)
        sys.exit(1)

    pairs = Pairs()
    pairs.detect()
    pairs.apply_rules()
    pairs.enforce_placement()
    pairs.resync()

    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(f"{d}/.socket2.sock")
    buf = b""
    while True:
        data = s.recv(4096)
        if not data:
            print("workspace-pairs-daemon: event socket closed", file=sys.stderr)
            sys.exit(1)
        buf += data
        needs_rules = needs_resync = False
        while b"\n" in buf:
            line, buf = buf.split(b"\n", 1)
            name = line.decode(errors="replace").split(">>", 1)[0]
            if name in ("monitoradded", "monitorremoved", "configreloaded"):
                needs_rules = True
            elif name in ("workspace", "focusedmon"):
                needs_resync = True
        if needs_rules:
            time.sleep(0.3)  # let hyprland settle the new layout
            pairs.detect()
            pairs.apply_rules()
            pairs.enforce_placement()
            needs_resync = True
        if needs_resync:
            time.sleep(0.05)  # coalesce event bursts; resync is idempotent
            pairs.resync()


if __name__ == "__main__":
    main()
