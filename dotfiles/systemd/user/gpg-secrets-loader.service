# GPG Secrets Loader - System-wide secret management
# Part of local-bootstrapping
#
# This service ensures GPG is unlocked at login and loads secrets for all services.
# Other services (voice-gateway, etc.) should depend on this service.

[Unit]
Description=GPG Secrets Loader - Unlock GPG and load system secrets
Documentation=https://github.com/prabhanshu11/local-bootstrapping
After=graphical-session.target
# Don't block graphical session if this fails
OnFailure=

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/Programs/local-bootstrapping/scripts/unlock-gpg-secrets.sh
# Timeout after 5 minutes (in case user takes long to unlock)
TimeoutStartSec=300
# Standard output to journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
