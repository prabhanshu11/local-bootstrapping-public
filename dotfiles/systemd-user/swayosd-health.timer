[Unit]
Description=Check every minute that SwayOSD still answers on D-Bus

[Timer]
# OnCalendar, NOT OnBootSec+OnUnitActiveSec. The old combo died after the
# 2026-08-05 reboot: the user manager started with OnBootSec already elapsed,
# the service therefore never activated this boot, OnUnitActiveSec never got a
# reference point, and the timer sat "active (elapsed)" forever — the watchdog
# silently stopped polling. OnCalendar reschedules unconditionally.
OnCalendar=*-*-* *:*:00
AccuracySec=10s

[Install]
WantedBy=timers.target
