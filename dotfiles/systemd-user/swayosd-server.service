[Unit]
Description=SwayOSD server (volume / brightness on-screen display)
Documentation=https://github.com/ErikReider/SwayOSD
PartOf=graphical-session.target
After=graphical-session.target
# Why this exists:
# swayosd-server 0.3.x intermittently SIGSEGVs inside GTK4/Wayland output
# handling (observed on external-monitor hotplug, e.g. DP-1 attach/detach on the
# ThinkPad T14). Omarchy starts it via a one-shot Hyprland `exec-once` uwsm scope
# that NEVER recovers, so after one crash the volume keys silently do nothing
# (swayosd-client has no server to talk to). This service supervises it so a
# crash self-heals in ~1s. See: local-bootstrapping/docs (swayosd note).
#
# Crash-loop guard: if it dies >5x in 30s, give up (prevents a CPU spin).
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=simple
# Guarantee THIS unit owns the live process: kill any stray instance first —
# the vendored omarchy exec-once instance, or a crashed remnant — then start
# our supervised one. The leading '-' makes "no process found" non-fatal.
ExecStartPre=-/usr/bin/pkill -x swayosd-server
ExecStart=/usr/bin/swayosd-server
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
